Date: Sun, 18 Oct 2026 15:41:04 +0000
Subject: [PATCH] =?UTF-8?q?build:=20=E5=9B=BA=E5=AE=9A=20libnx=20=E5=88=B0?=
 =?UTF-8?q?=20pgl=20API=20=E6=94=B9=E5=90=8D=E5=89=8D=E7=9A=84=20dbcc1bea?=
 =?UTF-8?q?=20=E4=BF=AE=E5=A4=8D=20CI=20=E7=BC=96=E8=AF=91?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Atmosphere-libs(2026-04)调用旧 pgl API(pglEventObserverGetProcessEvent、
  pglGetHostContentMetaInfo 等);libnx 2026-09-15(a13cd192)将其整体改名为
  GetShellEvent/GetHostProgramLaunchProperty 系,镜像自带 libnx 与
  libnx master 均只有新命名,libstratosphere 的 pgl 源文件编译失败
- build/nightly/release 三个工作流统一改为:构建前固定安装 libnx
  dbcc1bea(改名前最后一个提交,2026-05-04),再 make
- 移除 nightly/release 的"Install libnx master & Retry build"兜底
  (装 master 只会让命名更不兼容),构建改为单步确定性流程
---
 .github/workflows/build.yml   |  7 ++++++-
 .github/workflows/nightly.yml | 18 +++++++++---------
 .github/workflows/release.yml | 18 +++++++++---------
 3 files changed, 24 insertions(+), 19 deletions(-)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 55e5970..9248fcf 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -38,11 +38,16 @@ jobs:
       - name: Setup ccache
         uses: hendrikmuhs/ccache-action@v1.2
 
-      - name: Install latest libnx (before building)
+      - name: Install pinned libnx (before building)
         run: |
+          # Atmosphere-libs(2026-04)使用旧 pgl API(pglEventObserverGetProcessEvent 等);
+          # libnx 2026-09-15(commit a13cd192)将其改名为 GetShellEvent 系,
+          # "最新 libnx"与镜像自带 libnx 都与本仓库的 Atmosphere-libs 不兼容。
+          # 固定到改名前最后一个提交 dbcc1bea(2026-05-04)。
           pushd /tmp
           git clone https://github.com/switchbrew/libnx
           cd libnx
+          git checkout dbcc1bea
           make clean
           make -j8 PREFIX="ccache aarch64-none-elf-"
           make install
diff --git a/.github/workflows/nightly.yml b/.github/workflows/nightly.yml
index c53077f..6a34a2f 100644
--- a/.github/workflows/nightly.yml
+++ b/.github/workflows/nightly.yml
@@ -37,22 +37,22 @@ jobs:
           git reset --hard origin/master
           popd
 
-      - name: Build
-        id: build
-        run: make -j8 PREFIX="ccache aarch64-none-elf-"
-        continue-on-error: true
-
-      - name: Install libnx master & Retry build
-        id: retry
-        if: ${{ steps.build.outcome == 'failure' }}
+      - name: Install pinned libnx (before building)
         run: |
+          # Atmosphere-libs(2026-04)使用旧 pgl API(pglEventObserverGetProcessEvent 等);
+          # libnx 2026-09-15(commit a13cd192)将其改名为 GetShellEvent 系,
+          # 镜像自带/最新 libnx 均不兼容,固定到改名前最后一个提交 dbcc1bea(2026-05-04)。
           pushd /tmp
           git clone https://github.com/switchbrew/libnx
           cd libnx
+          git checkout dbcc1bea
           make -j8 PREFIX="ccache aarch64-none-elf-"
           make install
           popd
-          make -j8 PREFIX="ccache aarch64-none-elf-"
+
+      - name: Build
+        id: build
+        run: make -j8 PREFIX="ccache aarch64-none-elf-"
 
       - name: Upload built files
         uses: actions/upload-artifact@v7
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 7f34343..4788da6 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -35,22 +35,22 @@ jobs:
     - name: Setup ccache
       uses: hendrikmuhs/ccache-action@v1.2
 
-    - name: Build
-      id: build
-      run: make -j8 PREFIX="ccache aarch64-none-elf-"
-      continue-on-error: true
-
-    - name: Install libnx master & Retry build
-      id: retry
-      if: ${{ steps.build.outcome == 'failure' }}
+    - name: Install pinned libnx (before building)
       run: |
+        # Atmosphere-libs(2026-04)使用旧 pgl API(pglEventObserverGetProcessEvent 等);
+        # libnx 2026-09-15(commit a13cd192)将其改名为 GetShellEvent 系,
+        # 镜像自带/最新 libnx 均不兼容,固定到改名前最后一个提交 dbcc1bea(2026-05-04)。
         pushd /tmp
         git clone https://github.com/switchbrew/libnx
         cd libnx
+        git checkout dbcc1bea
         make -j8 PREFIX="ccache aarch64-none-elf-"
         make install
         popd
-        make -j8 PREFIX="ccache aarch64-none-elf-"
+
+    - name: Build
+      id: build
+      run: make -j8 PREFIX="ccache aarch64-none-elf-"
 
     - name: Pack
       run: |
-- 
