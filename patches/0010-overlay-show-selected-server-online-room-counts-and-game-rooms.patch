@@ -0,0 +1,49 @@
+#include "../source/monitor_title_resolver.hpp"
+
+#include <assert.h>
+#include <string.h>
+
+using MonitorTitleResolver::ResolveAdvertisedTitleId;
+
+static void ExpectResolved(const char *advertiseData, const char *hostName,
+                          const char *expectedTitleId) {
+    char titleId[17] = {};
+    assert(ResolveAdvertisedTitleId(advertiseData, hostName,
+                                    titleId, sizeof(titleId)));
+    assert(strcmp(titleId, expectedTitleId) == 0);
+}
+
+static void ExpectUnresolved(const char *advertiseData, const char *hostName) {
+    char titleId[17] = "not-a-title-id";
+    assert(!ResolveAdvertisedTitleId(advertiseData, hostName,
+                                     titleId, sizeof(titleId)));
+    assert(titleId[0] == 0);
+}
+
+int main() {
+    ExpectResolved("ffff0000", nullptr, "0100A250097F0000");
+    ExpectResolved("7b7d", nullptr, "01005EE0036EC000");
+    ExpectResolved("00000000081000008b9000"
+                   "00000004"
+                   "1234"
+                   "00000004"
+                   "5678",
+                   nullptr, "0100B04011742000");
+    ExpectResolved("00000000081000000a0000"
+                   "00000004"
+                   "1234",
+                   nullptr, "0100E21011446000");
+    ExpectResolved("00112233445566778899aabbccddeeff4d6961", "Mia",
+                   "0100D71004694000");
+
+    /* Case/spacing normalization is harmless, while partial signatures are
+     * not promoted to a title. Unknown sentinels must remain unknown. */
+    ExpectResolved("FF FF 00 00", nullptr, "0100A250097F0000");
+    ExpectUnresolved("00000000081000008b9000"
+                     "00000004"
+                     "1234",
+                     nullptr); // Rise signature is missing its second delimiter.
+    ExpectUnresolved("00112233445566778899aabbccddeeff4d6961", "Not-Mia");
+    ExpectUnresolved("11223344", nullptr);
+    return 0;
+}
diff --git a/tools/check_titlebar_harness.py b/tools/check_titlebar_harness.py
new file mode 100644
index 0000000..649a853
--- /dev/null
+++ b/tools/check_titlebar_harness.py
@@ -0,0 +1,241 @@
+#!/usr/bin/env python3
+"""Regenerate overlay/tests/monitor_title_bar_harness.cpp.
+
+The overlay's title-bar helpers ("标题右侧显示有房间的服务器 + 房间数量") live in
+overlay/source/main.cpp, next to libtesla's renderer, so they cannot be compiled
+on a host without devkitPro. This script lifts that block verbatim into a tiny
+harness with fake types, so the real shipping code is what gets type-checked
+(with any compiler, e.g. aarch64-linux-gnu-g++) and unit-tested.
+
+Run:  python3 tools/check_titlebar_harness.py [cxx]
+Exit: 0 when the harness compiles and all asserts pass.
+"""
+import os
+import subprocess
+import sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+MAIN = os.path.join(ROOT, "overlay", "source", "main.cpp")
+OUT = os.path.join(ROOT, "overlay", "tests", "monitor_title_bar_harness.cpp")
+
+START = "/* 标题右侧的「有房间的服务器(带房间数量)」标签(补丁 0010):"
+END = "/* 游戏房间区块:标题 + 自绘房间行(持久池,只增不删,焦点安全)。 */"
+
+HEADER = r'''/* Generated by tools/check_titlebar_harness.py -- do not edit by hand.
+
+   It compiles the title-bar block copied VERBATIM from overlay/source/main.cpp
+   against small stubs, so that code is type-checked and unit-tested even where
+   devkitPro / libnx / libtesla are not installed. Keep main.cpp's block between
+   the markers intact, or regenerate this file. */
+#include <assert.h>
+#include <initializer_list>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <cstddef>
+#include <string>
+#include <utility>
+#include <vector>
+
+typedef int8_t s8; typedef int16_t s16; typedef int32_t s32; typedef int64_t s64;
+typedef uint8_t u8; typedef uint16_t u16; typedef uint32_t u32; typedef uint64_t u64;
+
+#include "../source/monitor_title_bar.hpp"
+
+/* --- libtesla stand-ins used by the block below --- */
+namespace tsl {
+namespace cfg {
+constexpr s32 FramebufferWidth = 1280;
+constexpr s32 FramebufferHeight = 720;
+}  // namespace cfg
+/* libtesla: one Color struct at tsl:: scope; style::color holds the constants. */
+struct Color {
+    union { u32 rgba; struct { u8 r, g, b, a; }; };
+    constexpr Color(u16 raw) : rgba(raw) {}
+    constexpr Color(u8 r, u8 g, u8 b, u8 a) : r(r), g(g), b(b), a(a) {}
+};
+namespace style {
+namespace color {
+constexpr Color ColorFrameBackground = { 0x0, 0x0, 0x0, 0xD };
+constexpr Color ColorTransparent     = { 0x0, 0x0, 0x0, 0x0 };
+constexpr Color ColorHighlight       = { 0x0, 0xF, 0xD, 0xF };
+constexpr Color ColorText            = { 0xF, 0xF, 0xF, 0xF };
+constexpr Color ColorDescription     = { 0xA, 0xA, 0xA, 0xF };
+}  // namespace color
+}  // namespace style
+namespace gfx {
+struct Renderer {
+    static Color a(const Color &c) { return c; }
+    /* Real signature: returns {width, height}; a transparent colour means
+       "measure only". Fake metrics here: 6px per CJK codepoint, 3px per ASCII. */
+    std::pair<u32, u32> drawString(const char *text, bool monospace, s32 x, s32 y,
+                                   float fontSize, Color color, long maxWidth = 0) {
+        (void)monospace; (void)x; (void)y; (void)fontSize; (void)maxWidth;
+        u32 w = 0;
+        for (const unsigned char *c = reinterpret_cast<const unsigned char *>(text); *c;) {
+            if (c[0] == 0xE2 && c[1] == 0x80 && c[2] == 0xA6) { w += 6; c += 3; continue; }
+            size_t n = (c[0] >= 0xF0) ? 4 : (c[0] >= 0xE0) ? 3 : (c[0] >= 0xC0) ? 2 : 1;
+            w += (n >= 3) ? 6 : 3;   /* 6px/汉字, 3px/ASCII */
+            c += n;
+        }
+        if (color.a)   /* transparent == measure-only (same as libtesla) */
+            painted.push_back(std::string(text));
+        return { w, 0 };
+    }
+    void enableScissoring(s32, s32, s32, s32) {}
