+#!/usr/bin/env bash
+# 纯主机侧测试(不需要 devkitPro):overlay/tests 下的自包含用例 +
+# tools/check_titlebar_harness.py(把 main.cpp 里的标题栏代码原样抽出来编译并跑)。
+#
+#   tools/run-host-tests.sh              # 用本机 g++ 编译并运行
+#   tools/run-host-tests.sh <cxx>        # 只给 <cxx> 做类型检查(交叉三元组跑不了)
+set -euo pipefail
+root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$root"
+
+cxx="${CXX:-g++}"
+only_typecheck=0
+if [[ $# -ge 1 ]]; then
+  cxx="$1"
+  only_typecheck=1     # 传进来的多是交叉三元组:只检查类型,不执行
+fi
+flags=(-std=c++20 -Wall -Wextra)
+
+tests=(
+  overlay/tests/monitor_player_filter_test.cpp
+  overlay/tests/monitor_target_generation_test.cpp
+  overlay/tests/monitor_title_bar_test.cpp
+  overlay/tests/monitor_title_resolver_test.cpp
+)
+
+for t in "${tests[@]}"; do
+  printf '== %s\n' "$t"
+  if [[ "$only_typecheck" == 1 ]]; then
+    "$cxx" "${flags[@]}" -I overlay/source -fsyntax-only "$t"
+    continue
+  fi
+  bin="$(mktemp)"
+  "$cxx" "${flags[@]}" -I overlay/source -o "$bin" "$t"
+  "$bin"
+  rm -f "$bin"
+done
+
+printf '== monitor_title_bar harness (main.cpp 原样抽取)\n'
+python3 tools/check_titlebar_harness.py "$cxx"
+
+echo "all host tests OK"
