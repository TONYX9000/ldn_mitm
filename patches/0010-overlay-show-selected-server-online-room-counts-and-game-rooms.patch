+/* A valid nested room ID replaces only an invalid or all-F top-level value. */
+static void PreferRoomTitleId(char *current, size_t currentN,
+                              const char *candidate) {
+    char oldId[17] = {}, newId[17] = {};
+    const bool oldValid = MonitorTitleResolver::NormalizeTitleId(
+        current, oldId, sizeof(oldId));
+    const bool newValid = MonitorTitleResolver::NormalizeTitleId(
+        candidate, newId, sizeof(newId));
+    if (newValid && (!oldValid ||
+        (MonitorTitleResolver::IsUnknownTitleId(oldId) &&
+         !MonitorTitleResolver::IsUnknownTitleId(newId))))
+        snprintf(current, currentN, "%s", newId);
+}
+
+static bool IsUnknownGameLabel(const char *label) {
+    return !label || !label[0] ||
+           strcmp(label, "未知游戏") == 0 || strcmp(label, "未知遊戲") == 0 ||
+           strncmp(label, "未知", 6) == 0;
+}
+
+static int RoomGameLabelQuality(const char *label) {
+    if (IsUnknownGameLabel(label))
+        return 0;
+    if (MonitorTitleResolver::IsPokemonScarletVioletFamilyName(label))
+        return 1; /* A family label can still be enriched by the room's game name. */
+    char titleId[17] = {};
+    return MonitorTitleResolver::NormalizeTitleId(label, titleId, sizeof(titleId)) ? 1 : 2;
+}
+
+/* Resolve from this room's IDs/name/advertisement only. Never use the local
+ * foreground ProgramId: a remote server can list several unrelated games. */
+static void FormatGameName(const char *contentId, const char *gameValue,
+                           const char *gameName, const char *advertiseData,
+                           const char *hostPlayerName, char *out, size_t n) {
+    char normalizedName[52] = {};
+    char normalizedGameValue[52] = {};
+    const bool hasRoomName = MonitorTitleResolver::NormalizeRoomGameName(
+        gameName, normalizedName, sizeof(normalizedName));
+    const bool hasRoomGameValue = MonitorTitleResolver::NormalizeRoomGameName(
+        gameValue, normalizedGameValue, sizeof(normalizedGameValue));
+    if (!hasRoomName && hasRoomGameValue)
+        snprintf(normalizedName, sizeof(normalizedName), "%s", normalizedGameValue);
+
+    char titleId[17] = {};
+    const bool hasTitleId = MonitorTitleResolver::ResolveRoomTitleId(
+        contentId, gameValue, advertiseData, hostPlayerName,
+        titleId, sizeof(titleId));
+    if (hasTitleId && strcmp(titleId, "0100A3D008C5C000") == 0) {
+        /* Scarlet and Violet share this communication ID. Use a version only
+         * when the room itself provides a specific game name; never infer it
+         * from the local foreground application's ProgramId. */
+        MonitorTitleResolver::PokemonScarletVioletVersion roomVersion =
+            MonitorTitleResolver::PokemonVersionFromRoomName(normalizedName);
+        if (roomVersion == MonitorTitleResolver::PokemonScarletVioletVersion::Unspecified &&
+            hasRoomName && hasRoomGameValue)
+            roomVersion = MonitorTitleResolver::PokemonVersionFromRoomName(normalizedGameValue);
+        switch (roomVersion) {
+            case MonitorTitleResolver::PokemonScarletVioletVersion::Scarlet:
+                snprintf(out, n, "%s", T_STR("宝可梦朱", "寶可夢朱"));
+                return;
+            case MonitorTitleResolver::PokemonScarletVioletVersion::Violet:
+                snprintf(out, n, "%s", T_STR("宝可梦紫", "寶可梦紫"));
+                return;
+            case MonitorTitleResolver::PokemonScarletVioletVersion::Unspecified:
+            default:
+                snprintf(out, n, "%s", T_STR("宝可梦 朱/紫", "寶可梦 朱/紫"));
+                return;
+        }
+    }
+
+    if (hasTitleId) {
+        const u64 key = TitleKeyPack(titleId);
+        size_t nameLen = 0;
+        const char *mappedName = TitleLookup(key, &nameLen);
+        if (mappedName && mappedName[0]) {
+            snprintf(out, n, "%s", mappedName);
+            return;
+        }
+        if (normalizedName[0]) {
+            snprintf(out, n, "%s", normalizedName);
+            return;
+        }
+        snprintf(out, n, "%s", titleId); /* 未映射:显示房间提供的标题 ID */
+        return;
+    }
+
+    if (normalizedName[0]) {
+        snprintf(out, n, "%s", normalizedName);
+        return;
+    }
+    snprintf(out, n, "%s", T_STR("未知游戏", "未知遊戲"));
+}
+
+static void ReadRoomTitleFields(const char *room, char *contentId,
+                                size_t contentIdN, char *gameValue,
+                                size_t gameValueN, char *gameName,
+                                size_t gameNameN) {
+    static const char *const kTitleIdFields[] = {
+        "contentId", "content_id", "contentID", "titleId", "title_id", "titleID",
+        "programId", "program_id", "applicationId", "application_id",
+        "gameId", "game_id", "localCommunicationId", "local_communication_id",
+        "communicationId", "communication_id", "nacpId", "nacp_id",
+    };
+    static const char *const kGameNameFields[] = {
+        "gameName", "game_name", "titleName", "title_name",
+        "displayName", "display_name", "title",
+    };
+    static const char *const kGameContainers[] = {
+        "game", "title", "application", "gameInfo", "game_info",
+        "titleInfo", "title_info",
+    };
+    static const char *const kNestedTitleIdFields[] = {
+        "contentId", "content_id", "contentID", "titleId", "title_id", "titleID",
+        "programId", "program_id", "applicationId", "application_id",
+        "gameId", "game_id", "localCommunicationId", "local_communication_id",
+        "communicationId", "communication_id", "nacpId", "nacp_id", "id",
+    };
+    static const char *const kNestedGameNameFields[] = {
+        "name", "gameName", "game_name", "titleName", "title_name",
+        "displayName", "display_name", "label", "title",
+    };
+
+    JsonGetStrAnyList(room, kTitleIdFields,
+                      sizeof(kTitleIdFields) / sizeof(kTitleIdFields[0]),
+                      contentId, contentIdN);
+    JsonGetStrAnyList(room, kGameNameFields,
+                      sizeof(kGameNameFields) / sizeof(kGameNameFields[0]),
+                      gameName, gameNameN);
+    JsonGetStr(room, "game", gameValue, gameValueN);
+
+    for (size_t i = 0; i < sizeof(kGameContainers) / sizeof(kGameContainers[0]); ++i) {
+        const char *nested = JsonGet(room, kGameContainers[i]);
+        if (!nested || *nested != '{')
+            continue;
+        char nestedId[32] = {};
+        char nestedName[128] = {};
+        if (JsonGetStrAnyList(nested, kNestedTitleIdFields,
+                              sizeof(kNestedTitleIdFields) / sizeof(kNestedTitleIdFields[0]),
+                              nestedId, sizeof(nestedId)))
+            PreferRoomTitleId(contentId, contentIdN, nestedId);
+        char normalizedTopName[128] = {};
+        const bool hasUsableTopName = MonitorTitleResolver::NormalizeRoomGameName(
+            gameName, normalizedTopName, sizeof(normalizedTopName));
+        if (!hasUsableTopName)
+            JsonGetStrAnyList(nested, kNestedGameNameFields,
+                              sizeof(kNestedGameNameFields) / sizeof(kNestedGameNameFields[0]),
+                              nestedName, sizeof(nestedName));
+        char normalizedNestedName[128] = {};
+        if (!hasUsableTopName && MonitorTitleResolver::NormalizeRoomGameName(
+                nestedName, normalizedNestedName, sizeof(normalizedNestedName)))
+            snprintf(gameName, gameNameN, "%s", normalizedNestedName);
+    }
+}
