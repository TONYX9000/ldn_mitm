+    EnsureSd();
+    FILE *lf = fopen(kLogPath, "w");
+    if (lf)
+        fclose(lf);
+    EnsureSockets();
+    if (g_sockInited) {
+        int fd = socket(AF_INET, SOCK_STREAM, 0);
