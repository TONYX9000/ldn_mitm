diff --git a/ldn_mitm/source/nifm_manager.cpp b/ldn_mitm/source/nifm_manager.cpp
new file mode 100644
index 0000000..2810281
--- /dev/null
+++ b/ldn_mitm/source/nifm_manager.cpp
@@ -0,0 +1,67 @@
+#include "nifm_manager.hpp"
+#include "debug.hpp"
+
+namespace ams::mitm::ldn {
+
+    os::SdkMutex NifmSessionManager::g_mutex;
+    int NifmSessionManager::g_refcount = 0;
+
+    Result NifmSessionManager::Acquire() {
+        std::scoped_lock lk(g_mutex);
+
+        if (g_refcount == 0) {
+            Result rc = nifmInitialize(NifmServiceType_Admin);
+            if (R_FAILED(rc)) {
+                LogFormat("NifmSessionManager: nifmInitialize failed: %x", rc);
+                return rc;
+            }
+            LogFormat("NifmSessionManager: session acquired");
+        }
+
+        g_refcount++;
+        R_SUCCEED();
+    }
+
+    void NifmSessionManager::Release() {
+        std::scoped_lock lk(g_mutex);
+
+        if (g_refcount <= 0) {
+            LogFormat("NifmSessionManager: unbalanced Release (refcount %d)", g_refcount);
+            return;
+        }
+
+        g_refcount--;
+
+        if (g_refcount == 0) {
+            nifmExit();
+            LogFormat("NifmSessionManager: session released");
+        }
+    }
+
+    Result NifmSessionManager::ForceReinit() {
+        std::scoped_lock lk(g_mutex);
+
+        if (g_refcount <= 0) {
+            /* Nothing holds it, so a plain initialise is equivalent. */
+            g_refcount = 1;
+            Result rc = nifmInitialize(NifmServiceType_Admin);
+            if (R_FAILED(rc)) {
+                g_refcount = 0;
+                LogFormat("NifmSessionManager: forced reinit failed to init: %x", rc);
+                return rc;
+            }
+            LogFormat("NifmSessionManager: session acquired (forced)");
+            R_SUCCEED();
+        }
+
+        /* Any outstanding nifmRequest must already be closed by the caller; it
+           dies with the session. Keep the reference count intact so the other
+           holders' Release() calls still balance out. */
+        nifmExit();
+        const Result rc = nifmInitialize(NifmServiceType_Admin);
+        LogFormat("NifmSessionManager: forced reinit %s (%x, refcount %d)",
+                  R_SUCCEEDED(rc) ? "ok" : "failed", rc, g_refcount);
+        return rc;
+    }
+
+}
diff --git a/ldn_mitm/source/nifm_manager.hpp b/ldn_mitm/source/nifm_manager.hpp
new file mode 100644
index 0000000..e668e4e
--- /dev/null
+++ b/ldn_mitm/source/nifm_manager.hpp
@@ -0,0 +1,37 @@
+#pragma once
+#include <stratosphere.hpp>
+
+namespace ams::mitm::ldn {
+
+    /* nifm:a allows only two sessions system-wide; hold one only while needed. */
+    class NifmSessionManager {
+        private:
+            static os::SdkMutex g_mutex;
+            static int g_refcount;
+        public:
+            static Result Acquire();
+            static void Release();
+            /* Tear the nifm session down and bring it back up without touching
+               the reference count. Needed by the relay reconnect path: a plain
+               reopen only swaps the socket, and because another component also
+               holds a reference, nifmExit() never ran and the stale internet
+               connection request survived. */
+            static Result ForceReinit();
+    };
+
+    class ScopedNifmSession {
+        private:
+            Result rc;
+        public:
+            ScopedNifmSession() : rc(NifmSessionManager::Acquire()) {}
+            ScopedNifmSession(const ScopedNifmSession &) = delete;
+            ScopedNifmSession &operator=(const ScopedNifmSession &) = delete;
+            ~ScopedNifmSession() {
+                if (R_SUCCEEDED(rc)) {
+                    NifmSessionManager::Release();
+                }
+            }
+            Result GetResult() const { return rc; }
+    };
+
+}
