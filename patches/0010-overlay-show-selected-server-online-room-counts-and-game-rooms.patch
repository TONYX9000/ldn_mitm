+/* room 对象数组 -> rooms[](graphql 与 rest 共用字段口径) */
+static void ParseRoomArray(const char *arr, QueryResult *qr) {
+    const char *p = JsWs(arr);
+    if (*p != '[')
+        return;
+    p = JsWs(p + 1);
+    while (qr->roomN < MONITOR_MAX_ROOMS && *p == '{') {
+        MonitorRoom &r = qr->rooms[qr->roomN];
+        memset(&r, 0, sizeof(r));
+        char cid[32] = {};
+        char gameValue[128] = {};
+        char gameName[128] = {};
+        char advertiseData[MonitorTitleResolver::kAdvertiseDataMaxHex + 1] = {};
+        char hostName[MONITOR_PLAYER_LEN + 1] = {};
+        ReadRoomTitleFields(p, cid, sizeof(cid), gameValue, sizeof(gameValue),
+                            gameName, sizeof(gameName));
+        JsonGetStrAny(p, "advertiseData", "advertise_data",
+                      advertiseData, sizeof(advertiseData));
+        JsonGetStrAny(p, "hostPlayerName", "host_player_name",
+                      hostName, sizeof(hostName));
+        FormatGameName(cid, gameValue, gameName, advertiseData, hostName,
+                       r.game, sizeof(r.game));
+        JsonGetStrAny(p, "sessionId", "session_id", r.sessionId, sizeof(r.sessionId));
+
+        u32 v = 0;
+        const bool hasPlayerCount =
+            JsonGetU32(p, "nodeCount", &v) || JsonGetU32(p, "node_count", &v);
+        if (hasPlayerCount)
+            r.players = v;
+        if (JsonGetU32(p, "nodeCountMax", &v) || JsonGetU32(p, "node_count_max", &v))
+            r.playersMax = v;
+
+        /* 玩家名单:hostPlayerName 排最前(UI 异色),再收节点名 */
+        const char *nodes = JsonGet(p, "nodes");
+        if (!nodes)
+            nodes = JsonGet(p, "players");   /* rest 服务器的同义字段 */
+        if (nodes && *nodes == '[') {
+            const char *q = JsWs(nodes + 1);
+            while (*q && *q != ']' && r.playerN < MONITOR_MAX_PLAYERS) {
+                const char *next = JsonSkip(q, 1);
+                if (!next)
+                    break;
+                if (*q == '{') {
+                    const char *connected = JsonGet(q, "isConnected");
+                    if (!connected)
+                        connected = JsonGet(q, "is_connected");
+                    if (MonitorPlayerFilter::IncludeNode(connected != nullptr, connected)) {
+                        char nm[MONITOR_PLAYER_LEN] = {};
+                        if (JsonGetStrAny(q, "playerName", "player_name", nm, sizeof(nm)) ||
+                            JsonGetStr(q, "name", nm, sizeof(nm))) {
+                            bool dup = false;
+                            for (u8 i = 0; i < r.playerN; i++) {
+                                if (strcmp(r.player[i], nm) == 0) {
+                                    dup = true;
+                                    break;
+                                }
+                            }
+                            if (nm[0] && !dup)
+                                snprintf(r.player[r.playerN++], MONITOR_PLAYER_LEN, "%s", nm);
+                        }
+                    }
+                } else if (*q == '"') {
+                    char nm[MONITOR_PLAYER_LEN] = {};
+                    const char *s2 = q;
+                    if (JsonString(&s2, nm, sizeof(nm)) && nm[0])
+                        snprintf(r.player[r.playerN++], MONITOR_PLAYER_LEN, "%s", nm);
+                }
+                q = JsWs(next);
+                if (*q == ',') q = JsWs(q + 1);
+            }
+        }
+        /* 房主最前且不重复 */
+        if (hostName[0]) {
+            bool dup = false;
+            for (u8 i = 0; i < r.playerN; i++) {
+                if (strcmp(r.player[i], hostName) == 0) {
+                    dup = true;
+                    break;
+                }
+            }
+            if (!dup && r.playerN < MONITOR_MAX_PLAYERS) {
+                memmove(r.player[1], r.player[0], (size_t)r.playerN * MONITOR_PLAYER_LEN);
+                snprintf(r.player[0], MONITOR_PLAYER_LEN, "%s", hostName);
+                r.playerN++;
+            }
+        }
+        /* The server's count is authoritative. A short-lived/stale nodes array
+         * must not display more names than nodeCount says are connected. */
+        if (hasPlayerCount && r.players > 0 && r.playerN > r.players) {
+            const u8 keep = static_cast<u8>(r.players);
+            for (u8 i = keep; i < r.playerN; i++)
+                memset(r.player[i], 0, MONITOR_PLAYER_LEN);
+            r.playerN = keep;
+        }
+        /* 人数兜底放到房主处理之后:房主若不在 nodes 里也计入人数 */
+        if (r.players == 0)
+            r.players = r.playerN ? r.playerN : 1;
+        if (r.playersMax == 0)
+            r.playersMax = r.players;
+        if (r.game[0])
+            qr->roomN++;
+
+        const char *next = JsonSkip(p, 0);
+        if (!next)
+            break;
+        next = JsWs(next);
+        if (*next != ',')
+            break;
+        p = JsWs(next + 1);
+    }
+}
+
+static GraphqlSchemaCacheEntry GraphqlSchemaFor(const char *host, u16 port) {
+    std::lock_guard<std::mutex> lock(g_graphqlSchemaCacheMutex);
+    for (const auto &entry : g_graphqlSchemaCache) {
+        if (entry.known && entry.port == port && strcmp(entry.host, host) == 0)
+            return entry;
+    }
+    return GraphqlSchemaCacheEntry{};
+}
+
+static void SaveGraphqlSchema(const char *host, u16 port,
+                              const GraphqlQueryFields &fields) {
+    std::lock_guard<std::mutex> lock(g_graphqlSchemaCacheMutex);
+    u32 slot = MONITOR_MAX_SERVERS;
+    for (u32 i = 0; i < MONITOR_MAX_SERVERS; ++i) {
+        if (g_graphqlSchemaCache[i].known && g_graphqlSchemaCache[i].port == port &&
+            strcmp(g_graphqlSchemaCache[i].host, host) == 0) {
+            slot = i;
+            break;
+        }
+        if (slot == MONITOR_MAX_SERVERS && !g_graphqlSchemaCache[i].known)
+            slot = i;
+    }
+    if (slot == MONITOR_MAX_SERVERS) {
+        slot = g_graphqlSchemaCacheCursor++ % MONITOR_MAX_SERVERS;
+    }
+    GraphqlSchemaCacheEntry entry{};
+    snprintf(entry.host, sizeof(entry.host), "%s", host);
+    entry.port = port;
+    entry.known = true;
+    entry.fields = fields;
+    g_graphqlSchemaCache[slot] = entry;
+}
+
+static GraphqlFieldFailure GraphqlResponseFailure(
+        const char *response, const GraphqlQueryFields &fields) {
+    const char *errors = JsonGet(response, "errors");
+    if (!errors)
+        return kGraphqlFailureNone;
+    if (*errors != '[')
+        return kGraphqlFailureOther;
+    const char *p = JsWs(errors + 1);
+    if (*p == ']')
+        return kGraphqlFailureNone;
+    while (*p && *p != ']') {
+        const char *next = JsonSkip(p, 0);
+        if (!next)
+            return kGraphqlFailureOther;
+        if (*p == '{') {
+            char message[512] = {};
+            if (JsonGetStr(p, "message", message, sizeof(message))) {
+                const GraphqlFieldFailure failure =
+                    GraphqlFailureForMessage(message, fields);
+                if (failure != kGraphqlFailureOther)
+                    return failure;
+            }
+        }
+        p = JsWs(next);
+        if (*p == ',')
+            p = JsWs(p + 1);
+        else
+            break;
+    }
+    return kGraphqlFailureOther;
+}
+
+static bool QueryGraphqlRequest(const char *host, u16 port,
+                                const GraphqlQueryFields &fields,
+                                QueryResult *qr, bool *retryLegacy,
+                                GraphqlFieldFailure *failureOut) {
+    if (retryLegacy)
+        *retryLegacy = false;
+    if (failureOut)
+        *failureOut = kGraphqlFailureNone;
+    if (!qr)
+        return false;
+    *qr = QueryResult{};
+
+    char url[160];
+    snprintf(url, sizeof(url), "http://%s:%u/", host, (unsigned)port);
+    const std::string query = BuildGraphqlQuery(fields);
+    std::string payload = "{\"query\":\"";
+    payload += query;                    /* 查询串无引号/反斜杠,可直接拼接 */
+    payload += "\"}";
+    std::string resp;
+    const bool httpOk = HttpPostJson(url, payload.c_str(), &resp, 6000, kMaxHttpBody);
+    GraphqlFieldFailure failure = GraphqlResponseFailure(resp.c_str(), fields);
+    if (!httpOk) {
+        /* A JSON GraphQL validation body can identify missing schema fields.
+         * Plain 404/405 responses are REST endpoints, so do not fan out many
+         * schema probes against them. */
+        if (failureOut)
+            *failureOut = failure;
+        if (retryLegacy && failure != kGraphqlFailureNone)
+            *retryLegacy = true;
+        return false;
+    }
+    if (failure != kGraphqlFailureNone) {
+        if (failureOut)
+            *failureOut = failure;
+        if (retryLegacy)
+            *retryLegacy = true;
+        return false;
+    }
+
+    const char *data = JsonGet(resp.c_str(), "data");
+    if (!data) {
+        if (failureOut)
+            *failureOut = kGraphqlFailureOther;
+        if (retryLegacy)
+            *retryLegacy = true;
+        return false;
+    }
+    u32 v = 0;
+    const char *info = JsonGet(data, "serverInfo");
+    if (!info || !JsonGetU32(info, "online", &v)) {
+        if (failureOut)
+            *failureOut = kGraphqlFailureOther;
+        if (retryLegacy)
+            *retryLegacy = true;
+        return false;
+    }
+    qr->online = (s32)v;
+    const char *rooms = JsonGet(data, "room");
+    if (rooms)
+        ParseRoomArray(rooms, qr);
+    return true;
+}
+
+static void MergeGraphqlGameLabels(QueryResult *base, const QueryResult *enriched) {
+    if (!base || !enriched)
+        return;
+    for (u32 i = 0; i < enriched->roomN; ++i) {
+        const MonitorRoom &candidate = enriched->rooms[i];
+        s32 match = -1;
+        if (!candidate.sessionId[0])
+            continue;
+        for (u32 j = 0; j < base->roomN; ++j) {
+            if (base->rooms[j].sessionId[0] &&
+                strcmp(base->rooms[j].sessionId, candidate.sessionId) == 0) {
+                match = static_cast<s32>(j);
+                break;
+            }
+        }
+        if (match < 0)
+            continue;
+        MonitorRoom &room = base->rooms[match];
+        if (RoomGameLabelQuality(candidate.game) > RoomGameLabelQuality(room.game))
+            snprintf(room.game, sizeof(room.game), "%s", candidate.game);
+    }
+}
+
+static bool RoomNeedsGraphqlGame(const QueryResult *qr) {
+    if (!qr)
+        return false;
+    for (u32 i = 0; i < qr->roomN; ++i) {
+        if (RoomGameLabelQuality(qr->rooms[i].game) < 2)
+            return true;
+    }
+    return false;
+}
+
+static void QueryGraphqlGame(const char *host, u16 port,
+                             const GraphqlQueryFields &baseFields,
+                             QueryResult *base) {
+    if (!base || !RoomNeedsGraphqlGame(base) || baseFields.gameSubfieldsDone ||
+        baseFields.game == kGraphqlGameUnsupported ||
+        baseFields.game == kGraphqlGameScalar)
+        return;
+
+    u8 lastSupportedMode = baseFields.game;
+    u8 mode = baseFields.game == kGraphqlGameNone
+        ? static_cast<u8>(kGraphqlGameScalar)
+        : NextGraphqlGameObjectField(baseFields.game);
+    if (mode == kGraphqlGameUnsupported) {
+        GraphqlQueryFields finished = baseFields;
+        finished.gameSubfieldsDone = true;
+        SaveGraphqlSchema(host, port, finished);
+        return;
+    }
+
+    for (int attempt = 0; attempt < 5; ++attempt) {
+        GraphqlQueryFields fields = baseFields;
+        fields.game = mode;
+        bool retry = false;
+        GraphqlFieldFailure failure = kGraphqlFailureNone;
+        if (QueryGraphqlRequest(host, port, fields, &g_graphqlCandidateResult,
+                                &retry, &failure)) {
+            SaveGraphqlSchema(host, port, fields);
+            lastSupportedMode = mode;
+            MergeGraphqlGameLabels(base, &g_graphqlCandidateResult);
+            if (mode == kGraphqlGameScalar || !RoomNeedsGraphqlGame(base))
+                return;
+            mode = NextGraphqlGameObjectField(mode);
+            if (mode != kGraphqlGameUnsupported)
+                continue;
+            GraphqlQueryFields finished = fields;
+            finished.gameSubfieldsDone = true;
+            SaveGraphqlSchema(host, port, finished);
+            return;
+        }
+        if (!retry)
+            return;
+        if (mode == kGraphqlGameScalar &&
+            failure == kGraphqlFailureGameNeedsObject) {
+            mode = kGraphqlGameObjectName;
+            continue;
+        }
+        if (failure == kGraphqlFailureGameSubfield &&
+            mode != kGraphqlGameScalar) {
+            mode = NextGraphqlGameObjectField(mode);
+            if (mode != kGraphqlGameUnsupported)
+                continue;
+            if (lastSupportedMode == kGraphqlGameNone) {
+                GraphqlQueryFields unsupported = baseFields;
+                unsupported.game = kGraphqlGameUnsupported;
+                SaveGraphqlSchema(host, port, unsupported);
+            } else {
+                GraphqlQueryFields finished = baseFields;
+                finished.game = lastSupportedMode;
+                finished.gameSubfieldsDone = true;
+                SaveGraphqlSchema(host, port, finished);
+            }
+            return;
+        }
+        if (failure == kGraphqlFailureGame) {
+            GraphqlQueryFields unsupported = baseFields;
+            unsupported.game = kGraphqlGameUnsupported;
+            SaveGraphqlSchema(host, port, unsupported);
+        }
+        return;
+    }
+    if (lastSupportedMode == kGraphqlGameNone) {
+        GraphqlQueryFields unsupported = baseFields;
+        unsupported.game = kGraphqlGameUnsupported;
+        SaveGraphqlSchema(host, port, unsupported);
+    }
+}
+
+static bool QueryGraphql(const char *host, u16 port, QueryResult *qr) {
+    if (!qr)
+        return false;
+    const GraphqlSchemaCacheEntry cached = GraphqlSchemaFor(host, port);
+    GraphqlQueryFields fields = cached.known ? cached.fields : GraphqlQueryFields{};
+
+    /* Field errors are cheap schema-validation failures; transport errors are
+     * not retried. Negotiate common title aliases, ad-data aliases and old
+     * NodeInfo connection fields, then cache the working shape per endpoint. */
+    for (int attempt = 0; attempt < 24; ++attempt) {
+        bool retry = false;
+        GraphqlFieldFailure failure = kGraphqlFailureNone;
+        if (QueryGraphqlRequest(host, port, fields, qr, &retry, &failure)) {
+            SaveGraphqlSchema(host, port, fields);
+            QueryGraphqlGame(host, port, fields, qr);
+            return true;
+        }
+        if (!retry)
+            return false;
+
+        switch (failure) {
+            case kGraphqlFailureTitle:
+                if (fields.title != kGraphqlTitleNone) {
+                    fields.title = NextGraphqlTitleField(fields.title);
+                    break;
+                }
+                return false;
+            case kGraphqlFailureAdvertise:
+                if (fields.advertise != kGraphqlAdvertiseNone) {
+                    fields.advertise = NextGraphqlAdvertiseField(fields.advertise);
+                    break;
+                }
+                return false;
+            case kGraphqlFailureConnection:
+                if (fields.connection != kGraphqlConnectionNone) {
+                    fields.connection = NextGraphqlConnectionField(fields.connection);
+                    break;
+                }
+                return false;
+            case kGraphqlFailureGameNeedsObject:
+                if (fields.game == kGraphqlGameScalar) {
+                    fields.game = kGraphqlGameObjectName;
+                    fields.gameSubfieldsDone = false;
+                    break;
+                }
+                fields.game = kGraphqlGameUnsupported;
+                break;
+            case kGraphqlFailureGame:
+                fields.game = kGraphqlGameUnsupported;
+                break;
+            case kGraphqlFailureGameSubfield:
+                if (fields.game >= kGraphqlGameObjectName &&
+                    fields.game <= kGraphqlGameObjectId) {
+                    fields.game = NextGraphqlGameObjectField(fields.game);
+                    fields.gameSubfieldsDone = false;
+                    break;
+                }
+                return false;
+            case kGraphqlFailureOther:
+            case kGraphqlFailureNone:
+            default:
+                if (fields.advertise != kGraphqlAdvertiseNone) {
+                    fields.advertise = NextGraphqlAdvertiseField(fields.advertise);
+                } else if (fields.connection != kGraphqlConnectionNone) {
+                    fields.connection = NextGraphqlConnectionField(fields.connection);
+                } else {
+                    return false;
+                }
+                break;
+        }
+    }
+    return false;
+}
+
+static bool QueryRest(const char *host, u16 port, QueryResult *qr) {
+    char url[160];
+    snprintf(url, sizeof(url), "http://%s:%u/info", host, (unsigned)port);
+    std::string resp;
+    if (!HttpGet(url, &resp, 6000, kMaxHttpBody))
+        return false;
+    const char *root = JsWs(SkipBom(resp.c_str()));
+    u32 v = 0;
+    if (JsonGetU32(root, "online", &v) || JsonGetU32(root, "clientCount", &v))
+        qr->online = (s32)v;
+    const char *rooms = JsonGet(root, "rooms");
+    if (rooms)
+        ParseRoomArray(rooms, qr);
+    return qr->online >= 0;
+}
