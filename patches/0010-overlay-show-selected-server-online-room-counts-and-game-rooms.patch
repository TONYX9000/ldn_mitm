@@ -0,0 +1,85 @@
+#include "../source/monitor_graphql_compat.hpp"
+
+#include <cassert>
+#include <string>
+
+using namespace MonitorGraphqlCompat;
+
+int main() {
+    GraphqlQueryFields fields{};
+    std::string query = BuildGraphqlQuery(fields);
+    assert(query.find("contentId") != std::string::npos);
+    assert(query.find("advertiseData") != std::string::npos);
+    assert(query.find("isConnected") != std::string::npos);
+    assert(query.find(" game") == std::string::npos);
+    fields.title = kGraphqlTitleLocalCommunicationId;
+    assert(BuildGraphqlQuery(fields).find("localCommunicationId") != std::string::npos);
+    fields.title = kGraphqlTitleCommunicationIdSnake;
+    assert(BuildGraphqlQuery(fields).find("communication_id") != std::string::npos);
+    fields.title = kGraphqlTitleContentIdSnake;
+    fields.advertise = kGraphqlAdvertiseDataSnake;
+    fields.connection = kGraphqlConnectionIsConnectedSnake;
+    fields.game = kGraphqlGameScalar;
+    query = BuildGraphqlQuery(fields);
+    assert(query.find("content_id") != std::string::npos);
+    assert(query.find("advertise_data") != std::string::npos);
+    assert(query.find("is_connected") != std::string::npos);
+    assert(query.find(" game ") != std::string::npos);
+
+    fields.game = kGraphqlGameObjectName;
+    assert(BuildGraphqlQuery(fields).find("game { name }") != std::string::npos);
+    fields.game = kGraphqlGameObjectContentId;
+    assert(BuildGraphqlQuery(fields).find("game { contentId }") != std::string::npos);
+    fields.game = kGraphqlGameObjectTitleId;
+    assert(BuildGraphqlQuery(fields).find("game { titleId }") != std::string::npos);
+    fields.game = kGraphqlGameObjectId;
+    assert(BuildGraphqlQuery(fields).find("game { id }") != std::string::npos);
+
+    fields.game = kGraphqlGameNone;
+    fields.title = kGraphqlTitleContentId;
+    assert(GraphqlFailureForMessage(
+        "Cannot query field \"contentId\" on type \"Room\".", fields) ==
+        kGraphqlFailureTitle);
+    fields.advertise = kGraphqlAdvertiseData;
+    assert(GraphqlFailureForMessage(
+        "Cannot query field \"advertiseData\" on type \"Room\".", fields) ==
+        kGraphqlFailureAdvertise);
+    fields.connection = kGraphqlConnectionIsConnected;
+    assert(GraphqlFailureForMessage(
+        "Cannot query field \"isConnected\" on type \"NodeInfo\".", fields) ==
+        kGraphqlFailureConnection);
+
+    fields.game = kGraphqlGameScalar;
+    assert(GraphqlFailureForMessage(
+        "Field \"game\" of type \"Game\" must have a selection of subfields.",
+        fields) == kGraphqlFailureGameNeedsObject);
+    assert(GraphqlFailureForMessage(
+        "Cannot query field \"game\" on type \"Room\".", fields) ==
+        kGraphqlFailureGame);
+    fields.game = kGraphqlGameObjectContentId;
+    assert(GraphqlFailureForMessage(
+        "Cannot query field \"contentId\" on type \"Game\".", fields) ==
+        kGraphqlFailureGameSubfield);
+
+    assert(NextGraphqlTitleField(kGraphqlTitleContentId) ==
+           kGraphqlTitleContentIdSnake);
+    assert(NextGraphqlTitleField(kGraphqlTitleGameIdSnake) ==
+           kGraphqlTitleLocalCommunicationId);
+    assert(NextGraphqlTitleField(kGraphqlTitleLocalCommunicationId) ==
+           kGraphqlTitleLocalCommunicationIdSnake);
+    assert(NextGraphqlTitleField(kGraphqlTitleCommunicationIdSnake) ==
+           kGraphqlTitleNone);
+    assert(NextGraphqlAdvertiseField(kGraphqlAdvertiseData) ==
+           kGraphqlAdvertiseDataSnake);
+    assert(NextGraphqlConnectionField(kGraphqlConnectionIsConnected) ==
+           kGraphqlConnectionIsConnectedSnake);
+    assert(NextGraphqlGameObjectField(kGraphqlGameObjectName) ==
+           kGraphqlGameObjectContentId);
+    assert(NextGraphqlGameObjectField(kGraphqlGameObjectContentId) ==
+           kGraphqlGameObjectTitleId);
+    assert(NextGraphqlGameObjectField(kGraphqlGameObjectTitleId) ==
+           kGraphqlGameObjectId);
+    assert(NextGraphqlGameObjectField(kGraphqlGameObjectId) ==
+           kGraphqlGameUnsupported);
+    return 0;
+}
diff --git a/overlay/tests/monitor_player_filter_test.cpp b/overlay/tests/monitor_player_filter_test.cpp
new file mode 100644
index 0000000..bd1fe8d
--- /dev/null
+++ b/overlay/tests/monitor_player_filter_test.cpp
@@ -0,0 +1,29 @@
+#include "../source/monitor_player_filter.hpp"
+
+#include <cassert>
+
+int main() {
+    using MonitorPlayerFilter::IncludeNode;
+
+    /* Older schemas without the optional field retain their name list. */
+    assert(IncludeNode(false, nullptr));
+    assert(IncludeNode(false, "false"));
+
+    /* Current GraphQL/REST schemas include only live nodes. */
+    assert(IncludeNode(true, "true"));
+    assert(IncludeNode(true, " true ,"));
+    assert(!IncludeNode(true, "false"));
+    assert(!IncludeNode(true, "false}"));
+    assert(!IncludeNode(true, "null"));
+    assert(!IncludeNode(true, nullptr));
+    assert(!IncludeNode(true, "trueish"));
+
+    /* UDP NetworkInfo is a fixed-size node array; stale entries at indices
+     * beyond nodeCount must not leak names from earlier room occupants. */
+    using MonitorPlayerFilter::IncludeConnectedSlot;
+    assert(IncludeConnectedSlot(0, 1, true));
+    assert(!IncludeConnectedSlot(1, 1, true));
+    assert(!IncludeConnectedSlot(0, 1, false));
+    assert(!IncludeConnectedSlot(0, 0, true));
+    return 0;
+}
diff --git a/overlay/tests/monitor_target_generation_test.cpp b/overlay/tests/monitor_target_generation_test.cpp
new file mode 100644
index 0000000..a0e003f
--- /dev/null
+++ b/overlay/tests/monitor_target_generation_test.cpp
@@ -0,0 +1,22 @@
+#include "../source/monitor_target_generation.hpp"
+
+#include <cassert>
+
+int main() {
+    MonitorTargetGeneration::Gate gate;
+
+    /* A response may publish only while it still owns the latest request. */
+    const auto shanghaiRequest = gate.Advance();
+    assert(gate.IsCurrent(shanghaiRequest));
+
+    /* Switching to another server invalidates the in-flight old response. */
+    const auto denmarkRequest = gate.Advance();
+    assert(!gate.IsCurrent(shanghaiRequest));
+    assert(gate.IsCurrent(denmarkRequest));
+
+    /* A later refresh supersedes even a same-target response. */
+    const auto newerRefresh = gate.Advance();
+    assert(!gate.IsCurrent(denmarkRequest));
+    assert(gate.IsCurrent(newerRefresh));
+    return 0;
+}
diff --git a/overlay/tests/monitor_title_resolver_test.cpp b/overlay/tests/monitor_title_resolver_test.cpp
new file mode 100644
index 0000000..24aa3b2
--- /dev/null
+++ b/overlay/tests/monitor_title_resolver_test.cpp
@@ -0,0 +1,195 @@
+#include "../source/monitor_title_resolver.hpp"
+
+#include <assert.h>
+#include <string.h>
+
+using MonitorTitleResolver::kAdvertiseDataMaxHex;
+using MonitorTitleResolver::NormalizeRoomGameName;
+using MonitorTitleResolver::NormalizeTitleId;
+using MonitorTitleResolver::PokemonScarletVioletVersion;
+using MonitorTitleResolver::PokemonVersionFromRoomName;
+using MonitorTitleResolver::IsPokemonScarletVioletFamilyName;
+using MonitorTitleResolver::ResolveAdvertisedTitleId;
+using MonitorTitleResolver::ResolveRoomTitleId;
+
+static void ExpectResolved(const char *advertiseData, const char *hostName,
+                          const char *expectedTitleId) {
+    char titleId[17] = {};
+    assert(ResolveAdvertisedTitleId(advertiseData, hostName,
+                                    titleId, sizeof(titleId)));
+    assert(strcmp(titleId, expectedTitleId) == 0);
+}
+
+static void ExpectUnresolved(const char *advertiseData, const char *hostName) {
+    char titleId[17] = "not-a-title-id";
+    assert(!ResolveAdvertisedTitleId(advertiseData, hostName,
+                                     titleId, sizeof(titleId)));
+    assert(titleId[0] == 0);
+}
+
+static void SetByte(char *hex, size_t byteOffset, unsigned char value) {
+    static const char digits[] = "0123456789abcdef";
+    hex[byteOffset * 2] = digits[value >> 4];
+    hex[byteOffset * 2 + 1] = digits[value & 0x0f];
+}
+
+/* Build the documented 132-byte Scarlet/Violet application-data shape:
+ * 0x5c-byte Pia header plus the game's 40 bytes. mode 0 = no code, mode 1 =
+ * changing trade-search value, mode 2 = Link Code, mode 3 = Union Circle,
+ * mode 4 = aa 88 f4, mode 5 = aa e8 8c, mode 6 = aa 88 72 (latest live). */
+static void BuildScarletVioletAdvertiseData(char *hex, size_t hexSize, int mode) {
+    static const size_t kBytes = 132;
+    assert(hexSize >= kBytes * 2 + 1);
+    memset(hex, '0', kBytes * 2);
+    hex[kBytes * 2] = 0;
+
+    SetByte(hex, 0, 0x00);
+    SetByte(hex, 1, 0x5c);
+    SetByte(hex, 2, 0x15); // system communication version
+    SetByte(hex, 3, 0x00);
+    SetByte(hex, 4, 0x15); // application communication version
+    SetByte(hex, 0x15, 1); // player limit enabled
+    SetByte(hex, 0x16, 1); // one participant
+    SetByte(hex, 0x17, 0);
+    SetByte(hex, 0x18, 0);
+    SetByte(hex, 0x19, 0);
+    SetByte(hex, 0x1a, 1); // one-byte nickname
+    SetByte(hex, 0x1b, 1); // UTF-8
+    SetByte(hex, 0x1c, 0x20); // the published nickname is one space
+
+    const size_t game = 0x5c;
+    if (mode == 1) {
+        SetByte(hex, game + 0x21, 0xfb);
+        SetByte(hex, game + 0x22, 0x14);
+        SetByte(hex, game + 0x23, 0x97);
+        SetByte(hex, game + 0x24, 0x00);
+    } else if (mode >= 2 && mode <= 6) {
+        SetByte(hex, game + 0, '1');
+        SetByte(hex, game + 1, '2');
+        SetByte(hex, game + 2, '3');
+        SetByte(hex, game + 3, '4');
+        if (mode >= 3) {
+            unsigned char markerMode = 0x08;
+            unsigned char markerTail = 0x3e;
+            if (mode == 4) {
+                markerMode = 0x88;
+                markerTail = 0xf4;
+            } else if (mode == 5) {
+                markerMode = 0xe8;
+                markerTail = 0x8c;
+            } else if (mode == 6) {
+                markerMode = 0x88;
+                markerTail = 0x72;
+            }
+            SetByte(hex, game + 0x21, 0xaa);
+            SetByte(hex, game + 0x22, markerMode);
+            SetByte(hex, game + 0x23, markerTail);
+        }
+        SetByte(hex, game + 0x24, 4); // little-endian code length
+    }
+}
+
+int main() {
+    ExpectResolved("ffff0000", nullptr, "0100A250097F0000");
+    ExpectResolved("7b7d", nullptr, "01005EE0036EC000");
+    ExpectResolved("00000000081000008b9000"
+                   "00000004"
+                   "1234"
+                   "00000004"
+                   "5678",
+                   nullptr, "0100B04011742000");
+    ExpectResolved("00000000081000000a0000"
+                   "00000004"
+                   "1234",
+                   nullptr, "0100E21011446000");
+    ExpectResolved("00112233445566778899aabbccddeeff4d6961", "Mia",
+                   "0100D71004694000");
+
+    /* Scarlet and Violet use Scarlet's local-communication ID on both builds. */
+    char sv[kAdvertiseDataMaxHex + 1] = {};
+    for (int mode = 0; mode < 7; ++mode) {
+        BuildScarletVioletAdvertiseData(sv, sizeof(sv), mode);
+        ExpectResolved(sv, nullptr, "0100A3D008C5C000");
+    }
+
+    /* Case/spacing normalization is harmless, while partial signatures are
+     * not promoted to a title. Unknown sentinels must remain unknown. */
+    ExpectResolved("FF FF 00 00", nullptr, "0100A250097F0000");
+    ExpectUnresolved("00000000081000008b9000"
+                     "00000004"
+                     "1234",
+                     nullptr); // Rise signature is missing its second delimiter.
+    ExpectUnresolved("00112233445566778899aabbccddeeff4d6961", "Not-Mia");
+    ExpectUnresolved("11223344", nullptr);
+
+    BuildScarletVioletAdvertiseData(sv, sizeof(sv), 0);
+    SetByte(sv, 2, 0x14); // wrong Pia system version
+    ExpectUnresolved(sv, nullptr);
+    BuildScarletVioletAdvertiseData(sv, sizeof(sv), 0);
+    SetByte(sv, 0x1c, 'A'); // unexpected nickname
+    ExpectUnresolved(sv, nullptr);
+    BuildScarletVioletAdvertiseData(sv, sizeof(sv), 0);
+    SetByte(sv, 0x5c + 10, 0xaa); // unknown game-data shape
+    ExpectUnresolved(sv, nullptr);
+    BuildScarletVioletAdvertiseData(sv, sizeof(sv), 2);
+    SetByte(sv, 0x5c + 0x21, 0xaa);
+    SetByte(sv, 0x5c + 0x22, 0x12); // unrecognized marker remains unknown
+    SetByte(sv, 0x5c + 0x23, 0xef);
+    ExpectUnresolved(sv, nullptr);
+    BuildScarletVioletAdvertiseData(sv, sizeof(sv), 0);
+    strcat(sv, "00"); // app-data size is not 132 bytes
+    ExpectUnresolved(sv, nullptr);
+
+    /* API title IDs may arrive under aliases and with a 0x prefix/separators. */
+    char normalizedId[17] = {};
+    assert(NormalizeTitleId(" 0x0100-abcd-ef01-2000 ",
+                            normalizedId, sizeof(normalizedId)));
+    assert(strcmp(normalizedId, "0100ABCDEF012000") == 0);
+    assert(!NormalizeTitleId("not-a-title-id", normalizedId, sizeof(normalizedId)));
+    assert(normalizedId[0] == 0);
+
+    /* A room-provided game name is usable without contentId; placeholders and
+     * ID-shaped labels must not masquerade as human-readable names. */
+    char roomGameName[52] = {};
+    assert(NormalizeRoomGameName("  Room API Game\n", roomGameName,
+                                 sizeof(roomGameName)));
+    assert(strcmp(roomGameName, "Room API Game") == 0);
+    assert(!NormalizeRoomGameName("FFFFFFFFFFFFFFFF", roomGameName,
+                                  sizeof(roomGameName)));
+    assert(!NormalizeRoomGameName("未知游戏", roomGameName,
+                                  sizeof(roomGameName)));
+    assert(!NormalizeRoomGameName("Unknown game (unknown)", roomGameName,
+                                  sizeof(roomGameName)));
+
+    /* Only an explicit room game name can refine the shared Scarlet/Violet
+     * communication ID to a single version. Combined family names stay
+     * ambiguous and therefore retain the safe family fallback. */
+    assert(PokemonVersionFromRoomName("Pokémon Violet") ==
+           PokemonScarletVioletVersion::Violet);
+    assert(PokemonVersionFromRoomName("宝可梦紫") ==
+           PokemonScarletVioletVersion::Violet);
+    assert(PokemonVersionFromRoomName("Pokemon Scarlet") ==
+           PokemonScarletVioletVersion::Scarlet);
+    assert(PokemonVersionFromRoomName("宝可梦朱") ==
+           PokemonScarletVioletVersion::Scarlet);
+    assert(PokemonVersionFromRoomName("Pokémon Scarlet and Violet") ==
+           PokemonScarletVioletVersion::Unspecified);
+    assert(PokemonVersionFromRoomName("宝可梦 朱/紫") ==
+           PokemonScarletVioletVersion::Unspecified);
+    assert(IsPokemonScarletVioletFamilyName("宝可梦 朱/紫"));
+    assert(IsPokemonScarletVioletFamilyName("Pokémon Scarlet/Violet"));
+    assert(!IsPokemonScarletVioletFamilyName("Pokémon Violet"));
+
+    /* Missing and all-F IDs both try the advertisement belonging to this room. */
+    BuildScarletVioletAdvertiseData(sv, sizeof(sv), 6);
+    assert(ResolveRoomTitleId("", "", sv, nullptr,
+                              normalizedId, sizeof(normalizedId)));
+    assert(strcmp(normalizedId, "0100A3D008C5C000") == 0);
+    assert(ResolveRoomTitleId("0100ABCDEF012000", "", "ffff0000",
+                              nullptr, normalizedId, sizeof(normalizedId)));
+    assert(strcmp(normalizedId, "0100ABCDEF012000") == 0);
+    assert(ResolveRoomTitleId("FFFFFFFFFFFFFFFF", "Room API Game", "11223344",
+                              nullptr, normalizedId, sizeof(normalizedId)) == false);
+    assert(normalizedId[0] == 0);
+    return 0;
+}
