+static void rebuildUi() {
+    if (g_list == nullptr) {
+        return;
+    }
+    auto &gui = tsl::Overlay::get()->getCurrentGui();
+    if (gui == nullptr) {
+        return;
+    }
+    gui->removeFocus();
+    g_list->clear();
+    buildList(g_list);
+    gui->restoreFocus();
+}
