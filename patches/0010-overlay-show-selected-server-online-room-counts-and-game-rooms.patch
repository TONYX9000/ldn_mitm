--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -38,8 +38,20 @@ jobs:
       - name: Setup ccache
         uses: hendrikmuhs/ccache-action@v1.2
 
-      - name: Install latest libnx (before building)
+      - name: update Atmosphere-libs (适配最新系统)
         run: |
+          # 与上游 nightly.yml 相同:构建前把 Atmosphere-libs 顶到 master,
+          # 跟踪最新系统固件适配(23.0.1+);不顶的话插件会在新系统上启动报错。
+          pushd Atmosphere-libs
+          git fetch --all
+          git reset --hard origin/master
+          popd
+
+      - name: Install libnx master (before building)
+        run: |
+          # 最新 Atmosphere-libs 使用 pgl 新命名(pglEventObserverGetShellEvent 系,
+          # libnx 2026-09-15 a13cd192 起),安装 libnx master 与其配套,
+          # 保证无论镜像自带 libnx 版本如何都能编译。
           pushd /tmp
           git clone https://github.com/switchbrew/libnx
           cd libnx
@@ -48,6 +60,26 @@ jobs:
           make install
           popd
 
+      - name: Install switch-curl (订阅 HTTPS 下载)
+        run: |
+          set -euo pipefail
+          # 订阅(chinese_db.json)经 https://v6.gh-proxy.org/ 加速镜像下载,
+          # overlay 内置 switch-curl(libnx SSL 后端)走 TLS;确保镜像装了它。
+          if dkp-pacman -Q switch-curl >/dev/null 2>&1; then
+            echo "switch-curl already installed"
+          else
+            # DevkitPro package DB refresh can fail with HTTP 403. Do not
+            # make a mirror refresh failure fatal if cached DBs can install it.
+            if ! dkp-pacman -Sy --noconfirm; then
+              echo "::warning::DevkitPro package DB refresh failed; trying cached metadata."
+            fi
+            dkp-pacman -S --noconfirm --needed switch-curl || true
+          fi
+          if ! dkp-pacman -Q switch-curl >/dev/null 2>&1; then
+            echo "::error::Required package switch-curl is not installed."
+            exit 1
+          fi
+
       - name: Clear invalid ccache after libnx update 
         run: ccache -C
 
