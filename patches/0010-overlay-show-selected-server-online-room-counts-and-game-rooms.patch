+/* Generated by tools/check_titlebar_harness.py -- do not edit by hand.
+
+   It compiles the title-bar block copied VERBATIM from overlay/source/main.cpp
+   against small stubs, so that code is type-checked and unit-tested even where
+   devkitPro / libnx / libtesla are not installed. Keep main.cpp's block between
+   the markers intact, or regenerate this file. */
+#include <assert.h>
+#include <initializer_list>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <cstddef>
+#include <string>
+#include <utility>
+#include <vector>
+
+typedef int8_t s8; typedef int16_t s16; typedef int32_t s32; typedef int64_t s64;
+typedef uint8_t u8; typedef uint16_t u16; typedef uint32_t u32; typedef uint64_t u64;
+
+#include "../source/monitor_title_bar.hpp"
+
+/* --- libtesla stand-ins used by the block below --- */
+namespace tsl {
+namespace cfg {
+constexpr s32 FramebufferWidth = 1280;
+constexpr s32 FramebufferHeight = 720;
+}  // namespace cfg
+/* libtesla: one Color struct at tsl:: scope; style::color holds the constants. */
+struct Color {
+    union { u32 rgba; struct { u8 r, g, b, a; }; };
+    constexpr Color(u16 raw) : rgba(raw) {}
+    constexpr Color(u8 r, u8 g, u8 b, u8 a) : r(r), g(g), b(b), a(a) {}
+};
+namespace style {
+namespace color {
+constexpr Color ColorFrameBackground = { 0x0, 0x0, 0x0, 0xD };
+constexpr Color ColorTransparent     = { 0x0, 0x0, 0x0, 0x0 };
+constexpr Color ColorHighlight       = { 0x0, 0xF, 0xD, 0xF };
+constexpr Color ColorText            = { 0xF, 0xF, 0xF, 0xF };
+constexpr Color ColorDescription     = { 0xA, 0xA, 0xA, 0xF };
+}  // namespace color
+}  // namespace style
+namespace gfx {
+struct Renderer {
+    static Color a(const Color &c) { return c; }
+    /* Real signature: returns {width, height}; a transparent colour means
+       "measure only". Fake metrics here: 6px per CJK codepoint, 3px per ASCII. */
+    std::pair<u32, u32> drawString(const char *text, bool monospace, s32 x, s32 y,
+                                   float fontSize, Color color, long maxWidth = 0) {
+        (void)monospace; (void)x; (void)y; (void)fontSize; (void)maxWidth;
+        u32 w = 0;
+        for (const unsigned char *c = reinterpret_cast<const unsigned char *>(text); *c;) {
+            if (c[0] == 0xE2 && c[1] == 0x80 && c[2] == 0xA6) { w += 6; c += 3; continue; }
+            size_t n = (c[0] >= 0xF0) ? 4 : (c[0] >= 0xE0) ? 3 : (c[0] >= 0xC0) ? 2 : 1;
+            w += (n >= 3) ? 6 : 3;   /* 6px/汉字, 3px/ASCII */
+            c += n;
+        }
+        if (color.a)   /* transparent == measure-only (same as libtesla) */
+            painted.push_back(std::string(text));
+        return { w, 0 };
+    }
+    void enableScissoring(s32, s32, s32, s32) {}
+    void disableScissoring() {}
+    static std::vector<std::string> painted;
+};
+inline std::vector<std::string> Renderer::painted;
+}  // namespace gfx
+}  // namespace tsl
+
+/* --- monitor.hpp stand-ins (relay.cfg feed) --- */
+#define MONITOR_MAX_SERVERS 32
+struct MonitorServer { char name[32]; char addr[64]; };
+static std::vector<MonitorServer> g_fakeServers;
+static u32 MonitorListRelayServers(MonitorServer *out, u32 max) {
+    u32 n = 0;
+    for (auto &s : g_fakeServers) {
+        if (n >= max)
+            break;
+        out[n] = s;
+        n++;
+    }
+    return n;
+}
+static char g_selectedName[48] = {};
+
+/* 标题右侧的「有房间的服务器(带房间数量)」标签(补丁 0010):
+   显示哪些服务器上有房间、各有几个,例如「中国·江苏(2)」。
+   归组 / 挑选项 / 测宽截断都在 monitor_title_bar.hpp 里(有桌面端单测);这里只
+   负责「什么时候重算 + 画在哪」。服务器列表变化时打脏标记,下一帧重算一次。 */
+static constexpr float kTitleBarFont = 15;   /* 与标题下「在线/房间」标签、数字同号 */
+
+struct TitleBarState {
+    /* 只存要显示的两项:整张服务器表放 BSS 会白占 1.7KB(ovlloader 堆很紧),
+       放栈上又和补丁 0010「栈上巨结构全部改 static」的结论相冲。 */
+    monitor_title_bar::Item items[monitor_title_bar::kMaxPerLine];
+    u32 itemN;
+    bool dirty;
+};
+
+static TitleBarState g_titleBar = { {}, 0, true };
+
+/* 只测不画:透明色走的是同一套字体度量(与 ServerRow/RoomRow 的取宽写法一致)。 */
+static u32 TitleBarMeasureAt(tsl::gfx::Renderer *renderer, const char *text, float font) {
+    return renderer->drawString(text, false, 0, 0, font,
+                                tsl::style::color::ColorTransparent).first;
+}
+
+/* libtesla 的测宽回调只要一个 (text, user) 函数指针;字号在这里定死。 */
+static u32 TitleBarMeasure(const char *text, void *user) {
+    return TitleBarMeasureAt(static_cast<tsl::gfx::Renderer *>(user), text, kTitleBarFont);
+}
+
+/* 读一次 relay.cfg(服务器列表的真值源),算出标题栏要显示的服务器名与数量。 */
+static void TitleBarRefresh() {
+    g_titleBar.dirty = false;
+    g_titleBar.itemN = 0;
+
+    /* 3KB 的服务器表放 static:同补丁 0010 对大结构的处理办法。 */
+    static monitor_title_bar::Entry entries[monitor_title_bar::kMaxServers];
+    u32 n = 0;
+    {
+        static MonitorServer raw[monitor_title_bar::kMaxServers];
+        const u32 rawN = MonitorListRelayServers(raw, monitor_title_bar::kMaxServers);
+        for (u32 i = 0; i < rawN; i++) {
+            snprintf(entries[n].name, sizeof(entries[n].name), "%s", raw[i].name);
+            snprintf(entries[n].addr, sizeof(entries[n].addr), "%s", raw[i].addr);
+            n++;
+        }
+    }
+
+    static monitor_title_bar::Group groups[monitor_title_bar::kMaxServers];
+    const u32 groupN = monitor_title_bar::GroupEntries(entries, n, groups,
+                                                       monitor_title_bar::kMaxServers);
+    static monitor_title_bar::Item all[monitor_title_bar::kMaxServers];
+    const u32 itemN = monitor_title_bar::PickItems(groups, groupN,
+                                                   g_selectedName[0] ? g_selectedName : nullptr,
+                                                   all, monitor_title_bar::kMaxServers);
+    /* 一行最多两个:选中的排第一,其余按房间数从多到少、同数按 relay.cfg 顺序。 */
+    g_titleBar.itemN = (itemN > monitor_title_bar::kMaxPerLine)
+                           ? monitor_title_bar::kMaxPerLine
+                           : itemN;
+    for (u32 i = 0; i < g_titleBar.itemN; i++)
+        g_titleBar.items[i] = all[i];
+}
+
+/* 画在标题右侧。libtesla 的 OverlayFrame 把标题画在 (20, 50) 字号 30,标签从
+   标题右边缘再往右 16px 起画,右侧留 16px 边距;放不下两个就只画一个。 */
+static void TitleBarDraw(tsl::gfx::Renderer *renderer, const char *frameTitle,
+                         s32 titleX, s32 top) {
+    if (g_titleBar.dirty)
+        TitleBarRefresh();
+    if (g_titleBar.itemN == 0)
+        return;
+
+    const u32 titleW = TitleBarMeasureAt(renderer, frameTitle, 30);
+    s32 x = titleX + static_cast<s32>(titleW) + 16;
+    u32 avail = (tsl::cfg::FramebufferWidth > x + 16)
+                    ? static_cast<u32>(tsl::cfg::FramebufferWidth - x - 16)
+                    : 0;
+
+    /* static:ovlloader 给的小栈(见 MonitorFrame::draw 里的同类注释)。 */
+    static char line[512];
+    u32 lineW = 0;
+    monitor_title_bar::BuildFittedLine(g_titleBar.items, g_titleBar.itemN, avail,
+                                       TitleBarMeasure, renderer, line, sizeof(line),
+                                       &lineW);
+    if (!line[0])
+        return;
+    renderer->drawString(line, false, x, top, kTitleBarFont,
+                         tsl::gfx::Renderer::a(tsl::style::color::ColorText));
+}
+
+
+/* ---------------- harness ---------------- */
+static void SetServers(std::initializer_list<const char *> names) {
+    g_fakeServers.clear();
+    for (auto *n : names) {
+        MonitorServer s = {};
+        snprintf(s.name, sizeof(s.name), "%s", n);
+        snprintf(s.addr, sizeof(s.addr), "host:%u", static_cast<unsigned>(11451 + g_fakeServers.size()));
+        g_fakeServers.push_back(s);
+    }
+    g_titleBar.dirty = true;
+    g_selectedName[0] = 0;
+    tsl::gfx::Renderer::painted.clear();
+}
+
+static const char *LastPainted() {
+    if (tsl::gfx::Renderer::painted.empty())
+        return "";
+    return tsl::gfx::Renderer::painted.back().c_str();
+}
+
+int main() {
+    tsl::gfx::Renderer r;
+
+    /* 1) 「中国·江苏」两条条目 → 标题右侧「中国·江苏(2)」 */
+    SetServers({ "中国·江苏", "中国·江苏(2)" });
+    TitleBarDraw(&r, "联机插件", 20, 63);
+    assert(strcmp(LastPainted(), "中国·江苏(2)") == 0);
+
+    /* 2) 一行最多两个服务器名(其余丢掉,不画半截) */
+    SetServers({ "中国·江苏", "中国·江苏(2)", "中国·广东", "中国·北京" });
+    TitleBarDraw(&r, "联机插件", 20, 63);
+    assert(strcmp(LastPainted(), "中国·江苏(2)  中国·广东") == 0);
+
+    /* 3) 没有服务器 → 一行都不画 */
+    SetServers({});
+    TitleBarDraw(&r, "联机插件", 20, 63);
+    assert(r.painted.empty());
+
+    /* 4) 当前选中的服务器排第一(哪怕它只有一个房间) */
+    SetServers({ "中国·河南", "中国·河南(2)", "中国·上海" });
+    snprintf(g_selectedName, sizeof(g_selectedName), "%s", "中国·上海");
+    g_titleBar.dirty = true;
+    TitleBarDraw(&r, "联机插件", 20, 63);
+    assert(strcmp(LastPainted(), "中国·上海  中国·河南(2)") == 0);
+
+    /* 5) 只有一台服务器时不带「(1)」 */
+    SetServers({ "美国" });
+    TitleBarDraw(&r, "联机插件", 20, 63);
+    assert(strcmp(LastPainted(), "美国") == 0);
+    /* 标题太长 → 只剩一个服务器的位置,第二项被丢掉(直接验 BuildFittedLine 的降级)。 */
+    SetServers({ "中国·河南", "中国·河南(2)", "中国·广东" });
+    TitleBarRefresh();
+    char line[512];
+    u32 lineW = 0;
+    monitor_title_bar::BuildFittedLine(g_titleBar.items, g_titleBar.itemN, 60,
+                                       TitleBarMeasure, &r, line, sizeof(line), &lineW);
+    assert(strcmp(line, "中国·河南(2)") == 0);
+    monitor_title_bar::BuildFittedLine(g_titleBar.items, g_titleBar.itemN, 24,
+                                       TitleBarMeasure, &r, line, sizeof(line), &lineW);
+    /* 单项也放不下 → 截断而不是画满一行(「中国·河…」=27px 已超 24,退到「中国·…」=21px) */
+    assert(strcmp(line, "中国·…") == 0);
+    assert(lineW <= 24 && TitleBarMeasure(line, &r) <= 24);
+    monitor_title_bar::BuildFittedLine(g_titleBar.items, g_titleBar.itemN, 9,
+                                       TitleBarMeasure, &r, line, sizeof(line), &lineW);
+    assert(line[0] == 0 && lineW == 0);   /* 连一个字 + 省略号都放不下 → 整行不画 */
+
+    /* 6) 脏标记没置起就不重读 relay.cfg(缓存有效);每帧照常画完整的两行 */
+    g_titleBar.dirty = false;
+    g_fakeServers.clear();          /* 列表实际变了,但没有 dirty 就不该被重读 */
+    r.painted.clear();
+    TitleBarDraw(&r, "联机插件", 20, 63);
+    assert(r.painted.size() == 1);
+    assert(r.painted[0] == "中国·河南(2)  中国·广东");
+    g_titleBar.dirty = true;        /* 置脏后重新读列表 → 空列表 → 什么都不画 */
+    r.painted.clear();
+    TitleBarDraw(&r, "联机插件", 20, 63);
+    assert(r.painted.empty());
+
+    printf("monitor_title_bar_harness OK\n");
+    return 0;
+}
diff --git a/overlay/tests/monitor_title_bar_test.cpp b/overlay/tests/monitor_title_bar_test.cpp
new file mode 100644
index 0000000..a7a0fc8
--- /dev/null
+++ b/overlay/tests/monitor_title_bar_test.cpp
@@ -0,0 +1,171 @@
+#include "../source/monitor_title_bar.hpp"
+
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+
+using namespace monitor_title_bar;
+
+static const char *kFactory[] = {
+    "中国·河南", "中国·河南(2)", "中国·广东", "中国·江苏", "中国·北京",
+    "中国·上海", "中国·丹麦", "美国",     "美国(2)",     "荷兰",
+    "荷兰(2)",  "德国·萨克森",
+};
+
+static uint32_t Collect(const char *const *names, uint32_t nameN, const char *selected,
+                        Item *items, uint32_t maxItems) {
+    Entry entries[kMaxServers] = {};
+    for (uint32_t i = 0; i < nameN && i < kMaxServers; i++)
+        snprintf(entries[i].name, sizeof(entries[i].name), "%s", names[i]);
+    Group groups[kMaxServers] = {};
+    uint32_t groupN = GroupEntries(entries, nameN < kMaxServers ? nameN : kMaxServers,
+                                   groups, kMaxServers);
+    return PickItems(groups, groupN, selected, items, maxItems);
+}
+
+/* 假测量:汉字(3 字节码点)6px、ASCII 3px、省略号 6px。 */
+static uint32_t FakeMeasure(const char *text, void *) {
+    uint32_t w = 0;
+    for (const unsigned char *c = reinterpret_cast<const unsigned char *>(text); *c;) {
+        if (c[0] == 0xE2 && c[1] == 0x80 && c[2] == 0xA6) { w += 6; c += 3; continue; }
+        size_t n = (c[0] >= 0xF0) ? 4 : (c[0] >= 0xE0) ? 3 : (c[0] >= 0xC0) ? 2 : 1;
+        w += (n >= 3) ? 6 : 3;
+        c += n;
+    }
+    return w;
+}
+
+int main() {
+    /* 1) 尾部「(N)」只是同地多台中继的编号,剥掉后才能合并计数。 */
+    char base[kNameLen];
+    BaseName("中国·江苏(2)", base, sizeof(base));
+    assert(strcmp(base, "中国·江苏") == 0);
+    BaseName("美国", base, sizeof(base));
+    assert(strcmp(base, "美国") == 0);
+    BaseName("德国·萨克森", base, sizeof(base));
+    assert(strcmp(base, "德国·萨克森") == 0);
+    BaseName("荷兰（3）", base, sizeof(base));    /* 全角括号 */
+    assert(strcmp(base, "荷兰") == 0);
+    BaseName("srv(x86)", base, sizeof(base));    /* 括号里不是数字:原样保留 */
+    assert(strcmp(base, "srv(x86)") == 0);
+    BaseName("relay.example.com", base, sizeof(base));
+    assert(strcmp(base, "relay.example.com") == 0);
+    BaseName("  日本(10)  ", base, sizeof(base)); /* 先剪首尾空白再剥编号 */
+    assert(strcmp(base, "日本") == 0);
+
+    /* 2) relay.cfg:12 条条目 → 9 个基础名,河南/美国/荷兰各 2。 */
+    {
+        Entry entries[kMaxServers] = {};
+        uint32_t n = 0;
+        for (const char *name : kFactory) {
+            snprintf(entries[n].name, sizeof(entries[n].name), "%s", name);
+            n++;
+        }
+        Group groups[kMaxServers] = {};
+        uint32_t groupN = GroupEntries(entries, n, groups, kMaxServers);
+        assert(groupN == 9);   /* 12 条 - 3 条重复编号 */
+
+        uint32_t jiangsu = 0, us = 0, nl = 0, henan = 0;
+        for (uint32_t i = 0; i < groupN; i++) {
+            if (strcmp(groups[i].name, "中国·江苏") == 0)
+                jiangsu = groups[i].count;
+            if (strcmp(groups[i].name, "美国") == 0)
+                us = groups[i].count;
+            if (strcmp(groups[i].name, "荷兰") == 0)
+                nl = groups[i].count;
+            if (strcmp(groups[i].name, "中国·河南") == 0)
+                henan = groups[i].count;
+        }
+        assert(jiangsu == 1 && us == 2 && nl == 2 && henan == 2);
+        /* 分组顺序沿用 relay.cfg 首次出现的顺序。 */
+        assert(strcmp(groups[0].name, "中国·河南") == 0);
+        assert(strcmp(groups[1].name, "中国·广东") == 0);
+    }
+
+    /* 3) 一行最多两个;选中的服务器优先,第二项取数量最多、同数量时最先出现的。 */
+    {
+        Item items[4] = {};
+        uint32_t m = Collect(kFactory, 12, "中国·江苏", items, 2);
+        assert(m == 2);
+        char line[192];
+        BuildLine(items, m, line, sizeof(line));
+        assert(strcmp(line, "中国·江苏  中国·河南(2)") == 0);
+    }
+
+    /* 4) 选中的服务器本身就有两条时,标签写成「美国(2)」。 */
+    {
+        Item items[4] = {};
+        uint32_t m = Collect(kFactory, 12, "美国(2)", items, 2);
+        assert(m == 2);
+        char line[192];
+        BuildLine(items, m, line, sizeof(line));
+        assert(strcmp(line, "美国(2)  中国·河南(2)") == 0);
+    }
+
+    /* 5) 数量多的先上;同数量按 relay.cfg 顺序。 */
+    {
+        static const char *names[] = {"甲", "乙", "乙(2)", "丙", "丙(2)", "丙(3)"};
+        Item items[4] = {};
+        uint32_t m = Collect(names, 6, nullptr, items, kMaxPerLine);
+        assert(m == 2);
+        char line[192];
+        BuildLine(items, m, line, sizeof(line));
+        assert(strcmp(line, "丙(3)  乙(2)") == 0);
+    }
+
+    /* 6) 没有服务器 / 只有一条的情况。 */
+    {
+        Item items[4] = {};
+        assert(Collect(kFactory, 0, nullptr, items, 2) == 0);
+        char line[192];
+        BuildLine(items, 0, line, sizeof(line));
+        assert(line[0] == 0);
+
+        static const char *one[] = {"中国·北京"};
+        assert(Collect(one, 1, "中国·北京", items, 2) == 1);
+        char piece[128];
+        FormatItem(items[0], piece, sizeof(piece));
+        assert(strcmp(piece, "中国·北京") == 0);   /* 单条不带「(1)」 */
+    }
+
+    /* 7) 截断:按像素预算裁字并补省略号,不吞整行、不切半个汉字。 */
+    {
+        char t[512];
+        snprintf(t, sizeof(t), "%s", "中国·江苏");
+        FitText(t, sizeof(t), 0, 30, FakeMeasure, nullptr);
+        assert(strcmp(t, "中国·江苏") == 0);           /* 刚好放得下:不加省略号 */
+
+        snprintf(t, sizeof(t), "%s", "中国·江苏  中国·河南(2)");
+        FitText(t, sizeof(t), 0, 42, FakeMeasure, nullptr);
+        assert(strcmp(t, "中国·江苏  …") == 0);        /* 回退后 33px+…6px=39 ≤ 42:是「放得下的最长串」 */
+
+        snprintf(t, sizeof(t), "%s", "中国·江苏");
+        FitText(t, sizeof(t), 12, 0, nullptr, nullptr);
+        assert(strcmp(t, "中国·…") == 0);              /* 按字节上限截:留 9 字节正文 + 省略号」 */
+    }
+
+    /* 8) 一行放不下两个 → 只留第一个;标题区极窄 → 空串。 */
+    {
+        Item items[4] = {};
+        uint32_t m = Collect(kFactory, 12, "中国·河南", items, 2);
+        assert(m == 2);
+        char line[512];
+        uint32_t w = 0;
+        BuildFittedLine(items, m, 10000, FakeMeasure, nullptr, line, sizeof(line), &w);
+        assert(strcmp(line, "中国·河南(2)  美国(2)") == 0);
+        assert(w == FakeMeasure(line, nullptr));
+
+        BuildFittedLine(items, m, 60, FakeMeasure, nullptr, line, sizeof(line), &w);   /* 只放得下第一项 */
+        assert(strcmp(line, "中国·河南(2)") == 0);
+
+        BuildFittedLine(items, m, 21, FakeMeasure, nullptr, line, sizeof(line), &w);
+        assert(strcmp(line, "中国·…") == 0);      /* 「中国·河…」=24px 已超预算 → 再退一格 =21px */
+        assert(w == 21);
+
+        BuildFittedLine(items, m, 3, FakeMeasure, nullptr, line, sizeof(line), &w);    /* 一个字都放不下 */
+        assert(line[0] == 0 && w == 0);
+    }
+
+    printf("monitor_title_bar_test OK\n");
+    return 0;
+}
diff --git a/overlay/tests/monitor_title_resolver_test.cpp b/overlay/tests/monitor_title_resolver_test.cpp
new file mode 100644
