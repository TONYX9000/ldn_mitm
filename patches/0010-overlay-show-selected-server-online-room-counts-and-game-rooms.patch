+static void MonitorOpenLog() {
+    if (g_logReady)
+        return;
+    EnsureSd();
+    mkdir("sdmc:/config", 0777);
+    mkdir(kSaveDir, 0777);
+    FILE *lf = fopen(kLogPath, "w");
