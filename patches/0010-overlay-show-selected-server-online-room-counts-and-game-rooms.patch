+/* (重)建“游戏房间”区块的动态行。快照 version 变化时由 update() 调用。 */
+static void rebuildRoomSection(const MonitorSnapshot &snap)
+{
+    if (!g_list || !g_roomHeader)
+        return;
+
+    for (auto *e : g_roomItems)
+        g_list->removeItem(e);
+    g_roomItems.clear();
+
+    /* 区块标题带上服务器名;空闲时给状态提示 */
+    char header[80];
+    if (snap.server[0])
+        snprintf(header, sizeof(header), "%s · %s", T("游戏房间", "遊戲房間"), snap.server);
+    else
+        snprintf(header, sizeof(header), "%s", T("游戏房间", "遊戲房間"));
+    g_roomHeader->setText(header);
+
+    if (snap.roomN == 0) {
+        const char *msg;
+        if (snap.busy)
+            msg = T("正在查询…", "正在查詢…");
+        else if (snap.status[0])
+            msg = snap.status;
+        else
+            msg = T("暂无房间", "暫無房間");
+        auto *item = new PlainListItem(msg);
+        g_list->addItem(item);
+        g_roomItems.push_back(item);
+        return;
+    }
+
+    for (u32 i = 0; i < snap.roomN; i++) {
+        char value[24];
+        if (snap.rooms[i].playersMax > 0)
+            snprintf(value, sizeof(value), "%u/%u",
+                     snap.rooms[i].players, snap.rooms[i].playersMax);
+        else
+            snprintf(value, sizeof(value), "%u", snap.rooms[i].players);
+        auto *item = new PlainListItem(snap.rooms[i].game, value);
+        g_list->addItem(item);
+        g_roomItems.push_back(item);
+    }
+}
