+/* ------------------------------------------------------------------ */
+/* relay.cfg:当前选择的服务器 -> host:port                              */
+/* ------------------------------------------------------------------ */
+
+static bool ParseHostPort(const char *tok, char *host, size_t hostN, u16 *port) {
+    const char *colon = strrchr(tok, ':');
+    size_t hl = colon ? (size_t)(colon - tok) : strlen(tok);
+    if (hl == 0 || hl >= hostN)
+        return false;
+    memcpy(host, tok, hl);
+    host[hl] = 0;
+    u32 p = 11451;
+    if (colon) {
+        p = 0;
+        for (const char *q = colon + 1; *q >= '0' && *q <= '9'; q++)
+            p = p * 10 + (u32)(*q - '0');
+    }
+    if (p == 0 || p > 65535)
+        p = 11451;
+    *port = (u16)p;
+    return true;
+}
+
+static bool ResolveSelectedServer(const char *nameOverride,
+                                  char *nameOut, size_t nameN,
+                                  char *hostOut, size_t hostN, u16 *portOut) {
+    std::string cfg;
+    if (!LoadFile(kRelayCfgPath, &cfg))
+        return false;
+
+    char want[64] = {};
+    if (nameOverride && nameOverride[0])
+        snprintf(want, sizeof(want), "%s", nameOverride);
+    if (!want[0]) {
+        size_t pos = cfg.find("selected=");
+        if (pos != std::string::npos) {
+            size_t e = cfg.find_first_of("\r\n", pos);
+            std::string line = cfg.substr(pos, e == std::string::npos ? std::string::npos : e - pos);
+            if (line.size() > 9)
+                snprintf(want, sizeof(want), "%s", line.c_str() + 9);
+        }
+    }
+    if (!want[0])
+        return false;
+
+    size_t i = 0;
+    while (i < cfg.size()) {
+        size_t e = cfg.find_first_of("\r\n", i);
+        std::string line = cfg.substr(i, e == std::string::npos ? std::string::npos : e - i);
+        i = (e == std::string::npos) ? cfg.size() : e + 1;
+
+        size_t s = line.find_first_not_of(" \t");
+        if (s == std::string::npos || line[s] == '#')
+            continue;
+        size_t sp = line.find_first_of(" \t", s);
+        if (sp == std::string::npos)
+            continue;
+        if (line.substr(s, sp - s) != want)
+            continue;
+        size_t t = line.find_first_not_of(" \t", sp);
+        if (t == std::string::npos)
+            continue;
+        size_t te = line.find_first_of(" \t", t);
+        std::string hp = line.substr(t, te == std::string::npos ? std::string::npos : te - t);
+        snprintf(nameOut, nameN, "%s", want);
+        return ParseHostPort(hp.c_str(), hostOut, hostN, portOut);
+    }
+    snprintf(nameOut, nameN, "%s", want);
+    return false;
+}
