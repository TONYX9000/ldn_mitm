+/* ------------------------------------------------------------------ */
+/* UDP 主动房间扫描(lan-play 中继协议的 LDN 扫描)                     */
+/* ------------------------------------------------------------------ */
+
+/* LanPlayMonitor 的 LDN_SCAN_FRAME 预生成常量:
+ *   0x01                              lan-play 原始包 chunk
+ *   IPv4(10.13.37.0 -> 10.13.255.255, UDP 11452)
+ *   LDN 头 {00 14 45 11} + type=0     扫描请求
+ * 校验和已预计算,勿手改。 */
+static const u8 kScanFrame[] = {
+    0x01, 0x45, 0x00, 0x00, 0x28, 0x00, 0x00, 0x40, 0x00, 0x40, 0x11, 0x01,
+    0xAC, 0x0A, 0x0D, 0x25, 0x00, 0x0A, 0x0D, 0xFF, 0xFF, 0x2C, 0xBC, 0x2C,
+    0xBC, 0x00, 0x14, 0x28, 0x0F, 0x00, 0x14, 0x45, 0x11, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+/* ldn_mitm RLE 解压:字面字节;0x00 + count = count 个 0 */
+static bool LdnDecompress(const u8 *in, size_t inLen, u8 *out, size_t expect) {
+    if (expect == 0 || expect > 8192 || inLen > 8192)
+        return false;
+    size_t o = 0, i = 0;
+    while (i < inLen && o < expect) {
+        u8 v = in[i++];
+        out[o++] = v;
+        if (v == 0) {
+            if (i >= inLen)
+                return false;
+            u8 rep = in[i++];
+            if (o + rep > expect)
+                return false;
+            memset(out + o, 0, rep);
+            o += rep;
+        }
+    }
+    return i == inLen && o == expect;
+}
+
+/* NetworkInfo(≥0x480)-> 房间条目 + 会话标识(去重用) */
+static bool ParseNetworkInfo(const u8 *p, size_t len, MonitorRoom *out,
+                             char *sessionTag, size_t tagN) {
+    if (len < 0x480)
+        return false;
+    memset(out, 0, sizeof(*out));
+    char cid[20];
+    for (int i = 0; i < 8; i++)
+        snprintf(cid + i * 2, 3, "%02X", p[7 - i]);   /* 小端 8 字节 -> 标题ID */
+
+    /* NetworkInfo: advertiseDataSize @ 0x26a, data @ 0x26c; the first
+     * NodeInfo's playerName (host) starts at 0x74. */
+    char advertiseHex[MonitorTitleResolver::kAdvertiseDataMaxHex + 1] = {};
+    size_t advertiseSize = (size_t)p[0x26A] | ((size_t)p[0x26B] << 8);
+    if (advertiseSize > MonitorTitleResolver::kAdvertiseDataMaxBytes)
+        advertiseSize = MonitorTitleResolver::kAdvertiseDataMaxBytes;
+    if (0x26C + advertiseSize > len)
+        advertiseSize = 0;
+    static const char kHex[] = "0123456789abcdef";
+    for (size_t i = 0; i < advertiseSize; i++) {
+        const u8 byte = p[0x26C + i];
+        advertiseHex[i * 2] = kHex[byte >> 4];
+        advertiseHex[i * 2 + 1] = kHex[byte & 0x0F];
+    }
+    char hostName[MONITOR_PLAYER_LEN + 1] = {};
+    memcpy(hostName, p + 0x74, MONITOR_PLAYER_LEN);
+    hostName[MONITOR_PLAYER_LEN] = 0;
+    FormatGameName(cid, advertiseHex, hostName, out->game, sizeof(out->game));
+
+    u32 maxN = p[0x66];
+    u32 cnt = p[0x67];
+    if (maxN > 8) maxN = 8;
+    if (cnt > 8) cnt = 8;
+    out->players = cnt;
+    out->playersMax = maxN ? maxN : cnt;
+    if (sessionTag && tagN > 0) {
+        /* 与 lpm_main.py 一致:sessionId = payload[16:32] 的 hex;
+           全零时退回标题ID 做标识。 */
+        bool allZero = true;
+        for (int i = 0; i < 16; i++) {
+            if (p[16 + i]) {
+                allZero = false;
+                break;
+            }
+        }
+        if (allZero) {
+            snprintf(sessionTag, tagN, "%s", cid);
+        } else {
+            char tag[33];
+            for (int i = 0; i < 16; i++)
+                snprintf(tag + i * 2, 3, "%02x", p[16 + i]);
+            snprintf(sessionTag, tagN, "%s", tag);
+        }
+        snprintf(out->sessionId, sizeof(out->sessionId), "%s", sessionTag);
+    }
+    /* 玩家名单:NetworkInfo 的 nodes[8] 带每个节点的用户名(起始 0x68、
+     * 步长 0x40:isConnected @+11、userName[33] @+12)。只读取 nodeCount
+     * 范围内的槽位;固定数组后面的槽可能保留上一个房间的旧昵称/连接位,
+     * 是切换房间或服务器后偶发串名的来源。主机(AP, nodes[0])排最前。 */
+    if (len >= 0x68 + (size_t)cnt * 0x40) {
+        u8 pn = 0;
+        for (u32 i = 0; i < cnt && pn < MONITOR_MAX_PLAYERS; i++) {
+            const u8 *nd = p + 0x68 + (size_t)i * 0x40;
+            if (!MonitorPlayerFilter::IncludeConnectedSlot(i, cnt, nd[11] == 1))
+                continue;
+            char nm[MONITOR_PLAYER_LEN];
+            memcpy(nm, nd + 12, MONITOR_PLAYER_LEN - 1);
+            nm[MONITOR_PLAYER_LEN - 1] = 0;
+            if (nm[0]) {
+                bool dup = false;
+                for (u8 j = 0; j < pn; j++) {
+                    if (strcmp(out->player[j], nm) == 0) {
+                        dup = true;
+                        break;
+                    }
+                }
+                if (!dup)
+                    snprintf(out->player[pn++], MONITOR_PLAYER_LEN, "%s", nm);
+            }
+        }
+        out->playerN = pn;
+    }
+    return out->game[0] != 0;
+}
+
+/* IPv4 + UDP(11452) + LDN 响应 */
+static bool ParseLdnResponse(const u8 *pkt, size_t len, MonitorRoom *room,
+                             char *sessionTag, size_t tagN) {
+    if (len < 20 || (pkt[0] >> 4) != 4)
+        return false;
+    size_t ihl = (size_t)(pkt[0] & 0x0F) * 4;
+    if (ihl < 20 || len < ihl + 8)
+        return false;
+    if (pkt[9] != 17)                      /* UDP */
+        return false;
+    const u8 *udp = pkt + ihl;
+    u32 sport = ((u32)udp[0] << 8) | udp[1];
+    u32 dport = ((u32)udp[2] << 8) | udp[3];
+    if (sport != 11452 || dport != 11452)
+        return false;
+    size_t udpLen = ((size_t)udp[4] << 8) | udp[5];
+    if (udpLen < 8)
+        return false;
+    size_t body = udpLen - 8;
+    if (body > len - ihl - 8)
+        body = len - ihl - 8;
+    const u8 *ldn = udp + 8;
+    if (body < 12)
+        return false;
+    if (ldn[0] != 0x00 || ldn[1] != 0x14 || ldn[2] != 0x45 || ldn[3] != 0x11)
+        return false;
+    if (ldn[4] != 1)                       /* type 1 = NetworkInfo 响应 */
+        return false;
+    size_t bodyLen   = (size_t)ldn[6] | ((size_t)ldn[7] << 8);
+    size_t decompLen = (size_t)ldn[8] | ((size_t)ldn[9] << 8);
+    if (bodyLen > body - 12)
+        return false;
+
+    /* This parser is only called by the single monitor worker. Keep the
+     * decompression scratch off its stack; older ovlloader builds provide a
+     * smaller/less forgiving thread stack than current builds. */
+    static u8 tmp[8192];
+    const u8 *info = ldn + 12;
+    size_t infoLen = bodyLen;
+    if (ldn[5] == 1) {                     /* 压缩 */
+        if (!LdnDecompress(info, bodyLen, tmp, decompLen))
+            return false;
+        info = tmp;
+        infoLen = decompLen;
+    }
+    return ParseNetworkInfo(info, infoLen, room, sessionTag, tagN);
+}
+
+/* type=3 分片重组:同 src+ident 的分片按 pmtu 偏移拼接 */
+struct FragSlot {
+    bool used;
+    u32 srcIp;
+    u16 ident;
+    u8  total;
+    u16 pmtu;
+    u16 dataLen;
+    u64 partsMask;                  /* 已收分片位图(total ≤ 64) */
+    u8  data[8192];
+};
+static FragSlot g_frags[4];
+
+static bool FragAdd(const u8 *frame, size_t len, const u8 **outPkt, size_t *outLen) {
+    if (len < 16)
+        return false;
+    u32 srcIp;
+    memcpy(&srcIp, frame, 4);
+    u16 ident = (u16)(((u32)frame[8] << 8) | frame[9]);
+    u8 part = frame[10];
+    u8 total = frame[11];
+    u16 partLen = (u16)((u32)frame[12] | ((u32)frame[13] << 8));
+    u16 pmtu = (u16)(((u32)frame[14] << 8) | frame[15]);
+    if (total == 0 || total > 64 || part >= total || pmtu == 0)
+        return false;
+    if ((size_t)partLen > len - 16)
+        return false;
+    size_t end = (size_t)part * pmtu + partLen;
+    if (end == 0 || end > 8192)
+        return false;
+
+    FragSlot *slot = nullptr;
+    for (auto &f : g_frags) {
+        if (f.used && f.srcIp == srcIp && f.ident == ident) {
+            slot = &f;
+            break;
+        }
+    }
+    if (!slot) {
+        for (auto &f : g_frags) {
+            if (!f.used) {
+                slot = &f;
+                break;
+            }
+        }
+        if (!slot)
+            return false;
+        memset(slot, 0, sizeof(*slot));
+        slot->used = true;
+        slot->srcIp = srcIp;
+        slot->ident = ident;
+        slot->total = total;
+        slot->pmtu = pmtu;
+    }
+    if (slot->total != total || slot->pmtu != pmtu) {
+        slot->used = false;
+        return false;
+    }
+    memcpy(slot->data + (size_t)part * pmtu, frame + 16, partLen);
+    if ((size_t)part * pmtu + partLen > slot->dataLen)
+        slot->dataLen = (u16)end;
+    slot->partsMask |= 1ull << part;
+
+    u64 need = (total == 64) ? ~0ull : ((1ull << total) - 1);
+    if (slot->partsMask != need)
+        return false;
+    *outPkt = slot->data;
+    *outLen = slot->dataLen;
+    slot->used = false;
+    return true;
+}
+
+static void UdpRoomScan(const char *host, u16 port, QueryResult *qr) {
+    struct sockaddr_in sa;
+    if (!HttpResolve(host, &sa))
+        return;
+    sa.sin_port = htons(port);
+
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0)
+        return;
+    if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) != 0) {
+        close(fd);
+        return;
+    }
+
+    /* 排空积压 */
+    HttpSetNonBlock(fd, true);
+    u8 drain[2048];
+    while (recv(fd, drain, sizeof(drain), 0) > 0) {}
+    HttpSetNonBlock(fd, false);
+
+    struct timeval rtv;
+    rtv.tv_sec = 0;
+    rtv.tv_usec = 200 * 1000;
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &rtv, sizeof(rtv));
+
+    memset(g_frags, 0, sizeof(g_frags));
+
+    Deadline start = std::chrono::steady_clock::now();
+    Deadline deadline = start + std::chrono::milliseconds(1500);
+    Deadline nextSend = start;
+
+    char seen[kMaxScanRooms][36];
+    u32 seenN = 0;
+
+    u8 frame[2048];
+    while (std::chrono::steady_clock::now() < deadline && qr->roomN < MONITOR_MAX_ROOMS) {
+        if (IoAbort()) {
+            close(fd);
+            return;
+        }
+        Deadline now = std::chrono::steady_clock::now();
+        if (now >= nextSend) {
+            send(fd, kScanFrame, sizeof(kScanFrame), 0);
+            nextSend = now + std::chrono::milliseconds(700);
+        }
+        ssize_t n = recv(fd, frame, sizeof(frame), 0);
+        if (n <= 0)
+            continue;
+        const u8 *pkt = nullptr;
+        size_t pktLen = 0;
+        if (frame[0] == 1) {
+            pkt = frame + 1;
+            pktLen = (size_t)n - 1;
+        } else if (frame[0] == 3) {
+            if (!FragAdd(frame + 1, (size_t)n - 1, &pkt, &pktLen))
+                continue;
+        } else {
+            continue;
+        }
+
+        MonitorRoom room;
+        memset(&room, 0, sizeof(room));
+        char tag[36] = {};
+        if (!ParseLdnResponse(pkt, pktLen, &room, tag, sizeof(tag)))
+            continue;
+
+        bool dup = false;
+        for (u32 i = 0; i < seenN; i++) {
+            if (strcmp(seen[i], tag) == 0) {
+                dup = true;
+                break;
+            }
+        }
+        if (dup)
+            continue;
+        if (seenN < kMaxScanRooms)
+            snprintf(seen[seenN++], sizeof(seen[0]), "%s", tag);
+
+        qr->rooms[qr->roomN++] = room;
+    }
+    close(fd);
+}
+
+/* ------------------------------------------------------------------ */
+/* 房间 5 秒 TTL 缓存                                                   */
+/* ------------------------------------------------------------------ */
+
+/* 查询/UDP 扫描都有偶发丢包与瞬间空列表(日志里 scan rooms=0/1 交替),
+ * 直接把当次结果写进快照会让房间列表每秒闪一下。
+ * 缓存以 sessionId 为键:命中即刷新时间戳并更新房间数据;当次没出现
+ * 的条目再保留 5 秒才删除;服务器身份变化时整体清空。
+ * 在线人数/房间数量同口径:查询失败时沿用最近一次成功值,超过 5 秒
+ * 仍失败才退回「未知」。 */
+static constexpr auto kRoomTtl = std::chrono::seconds(5);
+
+struct RoomCacheEnt {
+    bool used = false;
+    char key[40] = {};
+    Deadline lastSeen{};
+    MonitorRoom room;
+};
+static RoomCacheEnt g_roomCache[MONITOR_MAX_ROOMS];
+static char g_cacheServer[128] = {};    /* 缓存归属的服务器 host:port */
+static Deadline g_lastOk{};             /* 最近一次查询成功时刻 */
+static bool  g_haveLastOk = false;
+static s32   g_lastOnline = -1;
+static s32   g_lastRoomCount = -1;
+
+static void RoomCacheKey(const MonitorRoom &r, char *out, size_t n) {
+    if (r.sessionId[0])
+        snprintf(out, n, "%s", r.sessionId);
+    else
+        snprintf(out, n, "g:%s", r.game);
+}
+
+static void RoomCacheReset() {
+    for (auto &e : g_roomCache)
+        e.used = false;
+    g_cacheServer[0] = 0;
+    g_haveLastOk = false;
+    g_lastOnline = -1;
+    g_lastRoomCount = -1;
+}
+
+static void RoomCacheUpsert(const MonitorRoom &r, const Deadline &now) {
+    char key[40];
+    RoomCacheKey(r, key, sizeof(key));
+    int freeSlot = -1, oldest = -1;
+    for (u32 i = 0; i < MONITOR_MAX_ROOMS; i++) {
+        RoomCacheEnt &e = g_roomCache[i];
+        if (!e.used) {
+            if (freeSlot < 0)
+                freeSlot = (int)i;
+            continue;
+        }
+        if (strcmp(e.key, key) == 0) {
+            e.room = r;
+            e.lastSeen = now;
+            return;
+        }
+        if (oldest < 0 || e.lastSeen < g_roomCache[oldest].lastSeen)
+            oldest = (int)i;
+    }
+    int slot = (freeSlot >= 0) ? freeSlot : oldest;
+    if (slot < 0)
+        return;
+    RoomCacheEnt &e = g_roomCache[slot];
+    e.used = true;
+    snprintf(e.key, sizeof(e.key), "%s", key);
+    e.lastSeen = now;
+    e.room = r;
+}
+
+static void RoomCacheExpire(const Deadline &now) {
+    for (auto &e : g_roomCache) {
+        if (e.used && (now - e.lastSeen) > kRoomTtl)
+            e.used = false;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 刷新流程                                                            */
+/* ------------------------------------------------------------------ */
+
+/* TLS/curl and JSON parsing can nest more deeply on older runtimes. Reserve
+ * 256 KiB instead of 64 KiB; this is static overlay memory, not heap. */
+alignas(0x1000) static u8 g_workerStack[0x40000];
+
+static void LogWorkerStack(const char *phase) {
+    volatile u8 probe = 0;
+    const std::uintptr_t base = reinterpret_cast<std::uintptr_t>(g_workerStack);
+    const std::uintptr_t end = base + sizeof(g_workerStack);
+    const std::uintptr_t current = reinterpret_cast<std::uintptr_t>(&probe);
+    char msg[128];
+    if (current >= base && current < end) {
+        snprintf(msg, sizeof(msg), "%s worker-stack used=%uK free=%uK", phase,
+                 static_cast<unsigned>((end - current) / 1024),
+                 static_cast<unsigned>((current - base) / 1024));
+    } else {
+        /* Never print a wrapped/negative "free stack" number. This also
+         * diagnoses a runtime that did not use the supplied stack buffer. */
+        snprintf(msg, sizeof(msg), "%s worker-stack range-mismatch sp=%p range=%p..%p",
+                 phase, reinterpret_cast<void *>(current),
+                 reinterpret_cast<void *>(base), reinterpret_cast<void *>(end));
+    }
+    MonLog(msg);
+}
+
+static void DoRefresh(const char *nameOverride, bool reloadSubs,
+                      MonitorTargetGeneration::Value targetGen) {
+    bool staleTarget = false;
+    {
+        std::scoped_lock lk(g_mutex);
+        staleTarget = !g_targetGen.IsCurrent(targetGen);
+        if (!staleTarget) {
+            g_snap.busy = true;
+            /* 同一服务器的轮询继续展示上一结果;切服时由请求入口先清空。 */
+            snprintf(g_snap.status, sizeof(g_snap.status), "%s",
+                     T_STR("正在查询…", "正在查詢…"));
+        }
+    }
+    if (staleTarget) {
+        MonLog("refresh-discard stale-target-before-start");
+        return;
+    }
+
+    LogWorkerStack("refresh-start");
+    EnsureSockets();
+
+    static QueryResult qr;            /* 约 8.7KB:static,不占工作线程栈 */
+    qr = QueryResult{};
+
+    /* 1. 当前选择的服务器 */
+    char name[48] = {}, host[64] = {};
+    u16 port = 11451;
+    bool haveServer = ResolveSelectedServer(nameOverride, name, sizeof(name),
+                                            host, sizeof(host), &port);
+    {
+        char m[160];
+        if (haveServer)
+            snprintf(m, sizeof(m), "resolve ok gen=%u %s %s:%u",
+                     static_cast<unsigned>(targetGen), name, host, (unsigned)port);
+        else
+            snprintf(m, sizeof(m), "resolve FAIL gen=%u %s",
+                     static_cast<unsigned>(targetGen),
+                     nameOverride ? nameOverride : "(selected)");
+        MonLog(m);
+    }
+
+    /* Publish/clear only if this request still targets the selected server. */
+    {
+        char ident[128];
+        snprintf(ident, sizeof(ident), "%s:%u", host, (unsigned)port);
+        std::scoped_lock lk(g_mutex);
+        staleTarget = !g_targetGen.IsCurrent(targetGen);
+        if (!staleTarget) {
+            snprintf(g_snap.server, sizeof(g_snap.server), "%.47s",
+                     name[0] ? name : (host[0] ? host : "?"));
+            if (strcmp(ident, g_cacheServer) != 0) {
+                RoomCacheReset();
+                g_snap.online = -1;
+                g_snap.roomCount = -1;
+                g_snap.roomN = 0;
+                memset(g_snap.rooms, 0, sizeof(g_snap.rooms));
+                g_snap.version++;
+            }
+            snprintf(g_cacheServer, sizeof(g_cacheServer), "%s", ident);
+        }
+    }
+    if (staleTarget) {
+        MonLog("refresh-discard stale-target-after-resolve");
+        return;
+    }
+
+    /* 2. 订阅(chinese_db.json):开盖/手动刷新时拉取(周期轮询跳过),
+     *    失败退回本地缓存;servers.json 已彻底移除,服务器列表只读 relay.cfg。
+     *    下载走 HTTPS 加速镜像(https://v6.gh-proxy.org/),删了缓存也能重拉 */
+    if (reloadSubs && !IoAbort()) {
+        MonLog("subs-start");
+        std::string chineseJson;
+        bool gotChinese = DownloadSubscription(kSubChinesePath, &chineseJson);
+        if (gotChinese)
+            SaveFile(kSaveChinesePath, chineseJson);
+        else {
+            gotChinese = LoadFile(kSaveChinesePath, &chineseJson);
+            MonLog(gotChinese ? "chinese: use cache" : "chinese: no cache");
+        }
+        if (gotChinese) {
+            EnsureTitleTables();
+            if (g_titleKey) {
+                g_titleArenaUsed = 0;
+                memset(g_titleKey, 0, kTitleHashSize * sizeof(u64));
+                /* 先释放 JSON 字符串(约 0.5MB),再从落盘文件流式解析,
+                 * 避免字符串与标题表同驻把 ovlloader 的堆挤爆。 */
+                std::string().swap(chineseJson);
+                if (!ParseChineseDbFile(kSaveChinesePath))
+                    MonLog("chinese_db: open file failed");
+            }
+        }
+    }
+
+    if (!haveServer) {
+        bool stale = false;
+        {
+            std::scoped_lock lk(g_mutex);
+            stale = !g_targetGen.IsCurrent(targetGen);
+            if (!stale) {
+                snprintf(g_snap.status, sizeof(g_snap.status), "%s",
+                         T_STR("找不到选中的服务器", "找不到選中的伺服器"));
+                g_snap.busy = false;
+                g_snap.version++;
+            }
+        }
+        if (stale)
+            MonLog("refresh-discard stale-target-no-server");
+        return;
+    }
+
+    if (!g_targetGen.IsCurrent(targetGen)) {
+        MonLog("refresh-discard stale-target-before-query");
+        return;
+    }
+
+    /* 4. 查询:自动识别 —— graphql 优先(含房间),失败再 rest
+     *    (servers.json 已移除,不再按 host:port 查类型表) */
+    bool ok = QueryGraphql(host, port, &qr);
+    if (!ok && !IoAbort())
+        ok = QueryRest(host, port, &qr);
+    /* 返回/退出时查询会被 HTTP 层中止:此时不要写任何快照,
+       免得把 "查询失败 e=6" 显示到界面上。 */
+    if (IoAbort()) {
+        MonLog("refresh-discard aborted");
+        return;
+    }
+    {
+        char m[56];
+        snprintf(m, sizeof(m), "query auto e=%d on=%d rooms=%u",
+                 g_httpErr, qr.online, (unsigned)qr.roomN);
+        MonLog(m);
+    }
+
+    /* 6. 接口不给房间时,用 UDP 主动扫描补房间(rest 1.0 服务器) */
+    if (ok && qr.roomN == 0 && !IoAbort()) {
+        UdpRoomScan(host, port, &qr);
+        char m[24];
+        snprintf(m, sizeof(m), "scan rooms=%u", (unsigned)qr.roomN);
+        MonLog(m);
+    }
+
+    /* 7. 并入房间 5 秒 TTL 缓存后写快照:当次查到的房间刷新时间戳,
+     *    没查到的旧房间再保留 5 秒,列表不再随单次丢包闪烁。 */
+    u32 mlogN = 0;
+    s32 mlogOn = -1;
+    bool staleAfterQuery = false;
+    {
+        const Deadline now = std::chrono::steady_clock::now();
+        std::scoped_lock lk(g_mutex);
+        staleAfterQuery = !g_targetGen.IsCurrent(targetGen);
+        if (!staleAfterQuery) {
+            if (ok) {
+                for (u32 i = 0; i < qr.roomN; i++)
+                    RoomCacheUpsert(qr.rooms[i], now);
+                g_lastOk = now;
+                g_haveLastOk = true;
+            }
+            RoomCacheExpire(now);
+
+            u32 n = 0;
+            for (u32 i = 0; i < MONITOR_MAX_ROOMS; i++) {
+                if (g_roomCache[i].used)
+                    g_snap.rooms[n++] = g_roomCache[i].room;
+            }
+            g_snap.roomN = n;
+            const bool fresh = g_haveLastOk && (now - g_lastOk) <= kRoomTtl;
+            if (ok) {
+                g_snap.online = qr.online;
+                g_snap.roomCount = (s32)n;
+                g_lastOnline = qr.online;
+                g_lastRoomCount = (s32)n;
+            } else if (fresh) {
+                /* 瞬间失败:5 秒内沿用最近一次成功的在线/房间数 */
+                g_snap.online = g_lastOnline;
+                g_snap.roomCount = g_lastRoomCount;
+            } else {
+                g_snap.online = -1;
+                g_snap.roomCount = -1;
+            }
+            if (!ok) {
+                if (!g_sockInited)
+                    snprintf(g_snap.status, sizeof(g_snap.status), "%s",
+                             T_STR("网络初始化失败", "網絡初始化失敗"));
+                else
+                    snprintf(g_snap.status, sizeof(g_snap.status), "%s e=%d",
+                             T_STR("查询失败", "查詢失敗"), g_httpErr);
+            } else if (n == 0) {
+                snprintf(g_snap.status, sizeof(g_snap.status), "%s",
+                         T_STR("暂无房间", "暫無房間"));
+            } else {
+                g_snap.status[0] = 0;
+            }
+            g_snap.busy = false;
+            g_snap.version++;
+            mlogN = n;
+            mlogOn = g_snap.online;
+        }
+    }
+    if (staleAfterQuery) {
+        MonLog("refresh-discard stale-target-after-query");
+        return;
+    }
+    {
+        char m[48];
+        snprintf(m, sizeof(m), "cache rooms=%u on=%d", (unsigned)mlogN, (int)mlogOn);
+        MonLog(m);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 每台服务器各自的在线 / 房间 / 延迟                                    */
+/* ------------------------------------------------------------------ */
+
+/* 背景:选中的服务器由 DoRefresh 全量查询;这里负责把其余服务器也测一遍,
+ * 让界面上每一行都能显示数值(不用先点选)。实现刻意用"最便宜"的探测:
+ *   延迟  = TCP connect 到 host:port 的往返耗时(中继端口本来就会接受连接)
+ *   在线/房间 = POST 一个只有 serverInfo 的 GraphQL;不支持就退回 /info
+ * 轮转顺序:每次空闲测一台,优先测"最久没测过的",选中服务器隔轮重测一次
+ * (它已经有 DoRefresh,这里只是让延迟也一直新鲜)。 */
+static constexpr u32  kStatUnknown    = 0xFFFFFFFFu;
+static constexpr u64  kStatFreshMs    = 20ull * 1000;
+static constexpr int  kStatProbeMs    = 1500;
+static constexpr u32  kStatMaxServers = MONITOR_MAX_SERVERS;
+
+struct ServerStat {
+    char name[32];
+    char addr[64];
+    s32  online;        /* -1 = 未知 */
+    s32  rooms;         /* -1 = 未知 */
+    s32  latencyMs;     /* 0 = 未知 */
+    u64  stampMs;       /* 上次测量时刻;0 = 从未测过 */
+};
+
+static ServerStat g_stats[kStatMaxServers];
+static u32 g_statCount = 0;
+static char g_statCfgKey[64];        /* relay.cfg 指纹,变了就重建表 */
+static u32 g_statCursor = 0;
+
+static u64 MonNowMs() {
+    return armTicksToNs(armGetSystemTick()) / 1000000ull;
+}
+
+static u64 g_statCfgCheckedMs = 0;
+
+static void StatsBuildTableIfNeeded(bool force = false) {
+    /* relay.cfg 不必每 200ms 读一次:3 秒查一次足够(新增/删除服务器是用户
+       在界面里操作,下一次轮询就会重建)。 */
+    const u64 nowMs = armTicksToNs(armGetSystemTick()) / 1000000ull;
+    if (!force && g_statCfgCheckedMs != 0 && nowMs - g_statCfgCheckedMs < 3000)
+        return;
+    g_statCfgCheckedMs = nowMs;
+    std::string cfg;
+    if (!LoadFile(kRelayCfgPath, &cfg))
+        return;
+    char key[64];
+    snprintf(key, sizeof(key), "%u:%u", (unsigned)cfg.size(),
+             (unsigned)(cfg.empty() ? 0 : (u8)cfg[0] + (u8)cfg[cfg.size() / 2]));
+    if (strcmp(key, g_statCfgKey) == 0)
+        return;
+    snprintf(g_statCfgKey, sizeof(g_statCfgKey), "%s", key);
+
+    ServerStat fresh[kStatMaxServers] = {};
+    u32 n = 0;
+    size_t i = 0;
+    while (i < cfg.size() && n < kStatMaxServers) {
+        size_t e = cfg.find_first_of("\r\n", i);
+        std::string line = cfg.substr(i, e == std::string::npos ? std::string::npos : e - i);
+        i = (e == std::string::npos) ? cfg.size() : e + 1;
+        char name[32] = {}, host[64] = {};
+        u16 port = 0;
+        if (!RelayParseLine(line.c_str(), name, sizeof(name), host, sizeof(host), &port))
+            continue;
+        snprintf(fresh[n].name, sizeof(fresh[n].name), "%s", name);
+        snprintf(fresh[n].addr, sizeof(fresh[n].addr), "%.55s:%u", host, (unsigned)port);
+        fresh[n].online = -1;
+        fresh[n].rooms = -1;
+        n++;
+    }
+    {
+        std::scoped_lock lk(g_mutex);
+        memcpy(g_stats, fresh, sizeof(fresh));
+        g_statCount = n;
+    }
+    char m[48];
+    snprintf(m, sizeof(m), "stats table n=%u", (unsigned)n);
+    MonLog(m);
+}
+
+static void StatsStore(u32 idx, s32 online, s32 rooms, s32 latency, u64 nowMs) {
+    std::scoped_lock lk(g_mutex);
+    if (idx >= g_statCount)
+        return;
+    ServerStat &st = g_stats[idx];
+    if (online >= 0)
+        st.online = online;
+    if (rooms >= 0)
+        st.rooms = rooms;
+    if (latency > 0)
+        st.latencyMs = latency;
+    st.stampMs = nowMs;
+}
+
+/* TCP connect 往返耗时(毫秒,0 = 连不上)。可被 IoAbort 立刻打断。 */
+static s32 ProbeLatencyMs(const char *host, u16 port) {
+    struct sockaddr_in sa;
+    if (!HttpResolve(host, &sa))
+        return 0;
+    sa.sin_port = htons(port);
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0)
+        return 0;
+    HttpSetNonBlock(fd, true);
+    s32 ms = 0;
+    Deadline start = std::chrono::steady_clock::now();
+    int rc = connect(fd, (struct sockaddr *)&sa, sizeof(sa));
+    /* 非阻塞 connect 正常会立刻返回非 0(EINPROGRESS);成功与否由 select +
+     * SO_ERROR 判定。这里不能看 errno:libnx 的 bsd 不写 newlib 的 errno。 */
+    if (rc != 0) {
+        for (;;) {
+            if (IoAbort()) { close(fd); return 0; }
+            long left = (long)std::chrono::duration_cast<std::chrono::milliseconds>(
+                start + std::chrono::milliseconds(kStatProbeMs) -
+                std::chrono::steady_clock::now()).count();
+            if (left <= 0) { close(fd); return 0; }
+            struct timeval tv;
+            tv.tv_sec = 0;
+            tv.tv_usec = left * 1000 < 100000 ? left * 1000 : 100000;
+            fd_set wset;
+            FD_ZERO(&wset);
+            FD_SET(fd, &wset);
+            int sel = select(fd + 1, nullptr, &wset, nullptr, &tv);
+            if (sel < 0) { close(fd); return 0; }
+            if (sel == 0)
+                continue;
+            int err = 0;
+            socklen_t elen = sizeof(err);
+            if (getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &elen) != 0 || err != 0) {
+                close(fd);
+                return 0;
+            }
+            ms = (s32)std::chrono::duration_cast<std::chrono::milliseconds>(
+                std::chrono::steady_clock::now() - start).count();
+            break;
+        }
+    }
+    close(fd);
+    return ms > 0 ? ms : 0;
+}
+
+/* 只有 serverInfo 的轻查询;服务器不支持时退回 /info(与 DoRefresh 同逻辑)。 */
+static bool ProbeOnlineRooms(const char *host, u16 port, s32 *online, s32 *rooms) {
+    static const char *kLightQuery =
+        "query PublicRoomSnapshot { serverInfo { online idle } }";
+    char url[160];
+    snprintf(url, sizeof(url), "http://%s:%u/", host, (unsigned)port);
+    std::string payload = "{\"query\":\"";
+    payload += kLightQuery;
+    payload += "\"}";
+    std::string resp;
+    if (HttpPostJson(url, payload.c_str(), &resp, kStatProbeMs, kMaxHttpBody)) {
+        const char *data = JsonGet(resp.c_str(), "data");
+        const char *info = data ? JsonGet(data, "serverInfo") : nullptr;
+        u32 v = 0;
+        if (info && JsonGetU32(info, "online", &v)) {
+            *online = (s32)v;
+            u32 idle = 0;
+            if (JsonGetU32(info, "idle", &idle)) {
+                /* 部分服务器把"在线 - 空闲"当房间数;没有 idle 就不猜 */
+                *rooms = (v >= idle) ? (s32)(v - idle) : -1;
+            }
+            return true;
+        }
+    }
+    if (IoAbort())
+        return false;
+    snprintf(url, sizeof(url), "http://%s:%u/info", host, (unsigned)port);
+    resp.clear();
+    if (!HttpGet(url, &resp, kStatProbeMs, kMaxHttpBody))
+        return false;
+    const char *root = JsWs(SkipBom(resp.c_str()));
+    u32 v = 0;
+    if (!JsonGetU32(root, "online", &v) && !JsonGetU32(root, "clientCount", &v))
+        return false;
+    *online = (s32)v;
+    u32 rc2 = 0;
+    *rooms = JsonGetU32(root, "roomCount", &rc2) ? (s32)rc2 : -1;
+    return true;
+}
+
+/* 工作线程空闲时调用:测一台(轮转),本轮测完再睡。 */
+static void RefreshOneServerStat() {
+    StatsBuildTableIfNeeded();
+    u32 n;
+    {
+        std::scoped_lock lk(g_mutex);
+        n = g_statCount;
+    }
+    if (n == 0) {
+        svcSleepThread(200'000'000);
+        return;
+    }
+    const u64 now = MonNowMs();
+
+    /* 选一台:最久没测过的;全都很新就睡一会儿 */
+    u32 pick = kStatUnknown;
+    u64 oldest = 0;
+    {
+        std::scoped_lock lk(g_mutex);
+        for (u32 k = 0; k < n; k++) {
+            u32 idx = (g_statCursor + k) % n;
+            if (g_stats[idx].stampMs == 0) {
+                pick = idx;
+                break;
+            }
+            u64 age = now - g_stats[idx].stampMs;
+            if (age > oldest) {
+                oldest = age;
+                if (pick == kStatUnknown)
+                    pick = idx;
+            }
+        }
+    }
+    if (pick == kStatUnknown)
+        pick = g_statCursor % n;
+    if (oldest < kStatFreshMs && oldest != 0) {
+        svcSleepThread(200'000'000);         /* 都还新鲜:歇 200ms 再看 */
+        return;
+    }
+    g_statCursor = (pick + 1) % n;
+
+    char addr[64], host[64] = {};
+    u16 port = 11451;
+    {
+        std::scoped_lock lk(g_mutex);
+        snprintf(addr, sizeof(addr), "%s", g_stats[pick].addr);
+    }
+    char *colon = strrchr(addr, ':');
+    if (colon) {
+        *colon = 0;
+        port = (u16)atoi(colon + 1);
+    }
+    snprintf(host, sizeof(host), "%s", addr);
+    if (host[0] == 0)
+        return;
+
+    const s32 lat = ProbeLatencyMs(host, port);
+    if (IoAbort())
+        return;
+    s32 online = -1, rooms = -1;
+    ProbeOnlineRooms(host, port, &online, &rooms);
+    if (IoAbort())
+        return;
+    StatsStore(pick, online, rooms, lat, MonNowMs());
+    {
+        char m[96];
+        snprintf(m, sizeof(m), "stat #%u %s:%u on=%d rooms=%d lat=%d",
+                 (unsigned)pick, host, (unsigned)port, (int)online, (int)rooms,
+                 (int)lat);
+        MonLog(m);
+    }
+}
+
+u32 MonitorListServerStats(MonitorServerStat *out, u32 max) {
+    if (!out || max == 0)
+        return 0;
+    StatsBuildTableIfNeeded();     /* 节流 3 秒,避免界面刷新时频繁读 SD */
+    const u64 now = MonNowMs();
+    u32 n = 0;
+    std::scoped_lock lk(g_mutex);
+    for (u32 k = 0; k < g_statCount && n < max; k++) {
+        snprintf(out[n].name, sizeof(out[n].name), "%s", g_stats[k].name);
+        snprintf(out[n].addr, sizeof(out[n].addr), "%s", g_stats[k].addr);
+        out[n].online = g_stats[k].online;
+        out[n].rooms = g_stats[k].rooms;
+        out[n].latencyMs = g_stats[k].latencyMs;
+        out[n].ageMs = g_stats[k].stampMs ? (now - g_stats[k].stampMs) : 0;
+        n++;
+    }
+    return n;
+}
+
+/* ------------------------------------------------------------------ */
+/* 后台线程(libnx 线程,风格同 libtesla)                               */
+/* ------------------------------------------------------------------ */
+
+
+static void MonitorWorker(void *) {
+    /* 线程一起来就把启动阶段欠下的重活做掉:挂载 SD/建目录/补写日志、
+     * 堆余量探针、socket 探针。此时 UI 已经在画了,不再阻塞首帧。 */
+    MonitorOpenLog();
+    ProbeHeap();
+    if (g_sockInited) {
+        int fd = socket(AF_INET, SOCK_STREAM, 0);
+        char m[24];
+        snprintf(m, sizeof(m), "soc-probe fd=%d", fd);
+        MonLog(m);
+        if (fd >= 0)
+            close(fd);
+    }
+    MonLog("worker-ready");
+
+    while (!g_exit.load()) {
+        u32 want = g_reqGen.load();
+        if (want != g_doneGen.load()) {
+            g_auxPhase.store(false);
+            g_doneGen.store(want);
+            char name[48];
+            bool subs;
+            MonitorTargetGeneration::Value targetGen;
+            {
+                std::scoped_lock lk(g_mutex);
+                memcpy(name, g_pendingName, sizeof(name));
+                subs = g_pendingSubs;
+                g_pendingSubs = false;
+                targetGen = g_targetGen.Capture();
+            }
+            DoRefresh(name[0] ? name : nullptr, subs, targetGen);
+            MonLog("refresh-done");
+        } else if (!IoAbort()) {
+            /* 空闲:给其它服务器(非选中行)测一轮延迟 + 在线/房间,
+               界面就能"每行都显示数值"而不必先选中它。 */
+            g_auxPhase.store(true);
+            RefreshOneServerStat();
+            g_auxPhase.store(false);
+        } else {
+            svcSleepThread(50'000'000);      /* 50ms */
+        }
+    }
+}
+
+void MonitorSetTraditional(bool traditional) {
+    g_traditional.store(traditional);
+}
+
+void MonitorSetPaused(bool paused) {
+    g_paused.store(paused);
+}
+
+/* 标题表延迟到首次解析时才分配(约 0.5MB),避免在 overlay 刚打开、
+ * 渲染器 frameBuffer(约 1.3MB)分配之前就把 ovlloader 仅几 MB 的堆挤爆。 */
+static void EnsureTitleTables() {
+    if (g_titleKey)
+        return;
+    g_titleKey   = (u64 *)calloc(kTitleHashSize, sizeof(u64));
+    g_titleOff   = (u32 *)calloc(kTitleHashSize, sizeof(u32));
+    g_titleLen   = (u16 *)calloc(kTitleHashSize, sizeof(u16));
+    g_titleArena = (char *)calloc(kTitleArena, 1);
+    if (!g_titleKey || !g_titleOff || !g_titleLen || !g_titleArena) {
+        free(g_titleKey); free(g_titleOff); free(g_titleLen); free(g_titleArena);
+        g_titleKey = nullptr; g_titleOff = nullptr;
+        g_titleLen = nullptr; g_titleArena = nullptr;
+    }
+}
+
+/* 工作线程优先级:0x3B 比 UI 线程(libtesla 用 0x2C)低,订阅下载/查询
+ * 再重也抢不过界面。之前用 0x2C 时,3MB 的订阅下载会把默认线程挤到后面,
+ * 表现就是「插件里按返回,特斯拉菜单要等一会儿才出来」。 */
+static constexpr int kWorkerPriority = 0x3B;
+
+void MonitorInit() {
+    if (g_inited)
+        return;
+    g_inited = true;
+    g_exit.store(false);
+    g_pendingName[0] = 0;
+    MonLog("worker-init");        /* 只进内存缓冲,不碰 SD */
+
+    Result rc = threadCreate(&g_thread, MonitorWorker, nullptr, g_workerStack,
+                             sizeof(g_workerStack), kWorkerPriority, -2);
+    if (R_SUCCEEDED(rc))
+        threadStart(&g_thread);
+}
+
+void MonitorExit() {
+    if (!g_inited)
+        return;
+    g_exit.store(true);
+    threadWaitForExit(&g_thread);
+    threadClose(&g_thread);
+    if (g_sockInited) {
+        socketExit();
+        g_sockInited = false;
+    }
+    g_inited = false;
+}
+
+/* Must be called with g_mutex held. Detach the published room list from the
+ * previous target immediately, before the blocking worker starts its query. */
+static void ResetSnapshotForRequestLocked(const char *serverName,
+                                          const char *status) {
+    snprintf(g_snap.server, sizeof(g_snap.server), "%.47s",
+             serverName ? serverName : "");
+    g_snap.online = -1;
+    g_snap.roomCount = -1;
+    g_snap.roomN = 0;
+    memset(g_snap.rooms, 0, sizeof(g_snap.rooms));
+    snprintf(g_snap.status, sizeof(g_snap.status), "%s", status);
+    g_snap.busy = true;
+    g_snap.version++;
+}
+
+void MonitorRequestRefresh(const char *serverName) {
+    std::scoped_lock lk(g_mutex);
+    snprintf(g_pendingName, sizeof(g_pendingName), "%s", serverName ? serverName : "");
+    g_pendingSubs = true;      /* 开盖/手动刷新:同时重新拉订阅缓存 */
+    g_targetGen.Advance();
+    ResetSnapshotForRequestLocked(
+        serverName, T_STR("正在刷新服务器…", "正在刷新伺服器…"));
+    g_reqGen.fetch_add(1);
+}
+
+void MonitorRequestSwitch(const char *serverName) {
+    std::scoped_lock lk(g_mutex);
+    snprintf(g_pendingName, sizeof(g_pendingName), "%s", serverName ? serverName : "");
+    g_targetGen.Advance();
+    ResetSnapshotForRequestLocked(
+        serverName, T_STR("正在切换服务器…", "正在切換伺服器…"));
+    g_reqGen.fetch_add(1);
+}
+
+void MonitorRequestPoll() {
+    /* 周期刷新(与延迟 ping 同节奏):不动目标、不拉订阅 */
+    g_reqGen.fetch_add(1);
+}
+
+void MonitorCopySnapshot(MonitorSnapshot *out) {
+    std::scoped_lock lk(g_mutex);
+    *out = g_snap;
+}
diff --git a/overlay/source/monitor.hpp b/overlay/source/monitor.hpp
new file mode 100644
index 0000000..95ab8f7
--- /dev/null
+++ b/overlay/source/monitor.hpp
@@ -0,0 +1,90 @@
+#pragma once
+#include <switch.h>
+
+/* 联机监视器:当前中继服务器的在线人数 / 房间数 / 游戏房间列表。
+ *
+ * 数据来源:
+ *   1. 服务器列表      relay.cfg(与 sysmodule LoadConfig 同解析;servers.json 已移除)
+ *   2. 标题映射订阅    chinese_db.json (标题ID -> 中文名)
+ *   3. 服务器自身的查询接口(graphql POST / 或 rest GET /info),
+ *      rest 服务器接口不给房间时用 UDP 主动扫描补上。
+ *
+ * chinese_db.json 每次打开 overlay 从远程重新下载(HTTPS 加速镜像
+ * https://v6.gh-proxy.org/ 优先),落盘到
+ * sdmc:/config/ldn_mitm/ 下供下次离线兜底。
+ */
+
+#define MONITOR_MAX_ROOMS  32
+#define MONITOR_MAX_SERVERS 32
+#define MONITOR_MAX_PLAYERS 8
+#define MONITOR_PLAYER_LEN  32
+
+struct MonitorRoom {
+    char game[52];      /* 中文游戏名;未映射时是 16 位标题 ID */
+    u32  players;       /* 当前人数 */
+    u32  playersMax;    /* 人数上限,0 = 未知 */
+    u8   playerN;       /* 玩家名有效条数(0 = 服务器未提供名单) */
+    char player[MONITOR_MAX_PLAYERS][MONITOR_PLAYER_LEN]; /* 玩家名,房主在 [0] */
+    char sessionId[33]; /* 房间标识(sessionId hex;扫描房=标题ID),缓存和去重用 */
+};
+
+struct MonitorSnapshot {
+    u32 version;        /* 每次查询完成 +1,UI 据此决定是否重建列表 */
+    bool busy;          /* 后台正在查询 */
+    s32 online;         /* 在线人数,-1 = 未知 */
+    s32 roomCount;      /* 房间数量,-1 = 未知 */
+    char server[48];    /* 当前选择的服务器名(host:port 兜底) */
+    char status[96];    /* 状态文本(错误/提示) */
+    u32  roomN;         /* rooms[] 有效条数 */
+    MonitorRoom rooms[MONITOR_MAX_ROOMS];
+};
+
+void MonitorInit();
+void MonitorInitSockets();
+void MonitorExit();
+
+/* 简繁文案切换(与 UI 的 T() 同步)。 */
+void MonitorSetTraditional(bool traditional);
+
+/* 插件隐藏(onHide)/重新可见(onShow):隐藏时后台立即放弃正在进行的
+ * 下载与查询,别让它们拖住返回特斯拉菜单的那一帧。 */
+void MonitorSetPaused(bool paused);
+
+/* 服务器列表:直接读 relay.cfg(第 i 条与 sysmodule 的 g_servers[i] 对应)。
+ * addr 形如 "host:port"。 */
+struct MonitorServer {
+    char name[32];
+    char addr[64];
+};
+u32 MonitorListRelayServers(MonitorServer *out, u32 max);
+
+/* 每台服务器自己的在线/房间/延迟(界面所有行都显示,不只是选中行)。
+ * 后台线程按轮转顺序逐台探测,所以数值是"最近一次测到的":
+ * ageMs = 距上次测量多久(0 = 还没测过)。 */
+struct MonitorServerStat {
+    char name[32];
+    char addr[64];
+    s32  online;      /* -1 = 未知 */
+    s32  rooms;       /* -1 = 未知 */
+    s32  latencyMs;   /* 0 = 未知 */
+    u64  ageMs;       /* 距上次测量的毫秒数;0 = 从未测过 */
+};
+
+/* 读当前统计表(按 relay.cfg 顺序,与服务器行一一对应)。 */
+u32 MonitorListServerStats(MonitorServerStat *out, u32 max);
+
+/* 请求一次后台刷新(每次打开 overlay / 切换服务器时调用)。
+ * serverName:选中的服务器名(可空,空则读 relay.cfg 的 selected=)。
+ * 非阻塞;完成后 MonitorCopySnapshot 里的 version 会 +1。
+ * Refresh = 开盖:改目标 + 重新拉订阅缓存;
+ * Switch  = 切换服务器:改目标,不拉订阅;
+ * Poll    = 周期刷新(与延迟 ping 同节奏):不动目标、不拉订阅。 */
+void MonitorRequestRefresh(const char *serverName);
+void MonitorRequestSwitch(const char *serverName);
+void MonitorRequestPoll();
+
+/* 取当前快照的副本。 */
+void MonitorCopySnapshot(MonitorSnapshot *out);
+
+/* 诊断日志:写 sdmc:/config/ldn_mitm/monitor.log(UI 侧打点用)。 */
+void MonitorLog(const char *msg);
diff --git a/overlay/source/monitor_player_filter.hpp b/overlay/source/monitor_player_filter.hpp
new file mode 100644
index 0000000..a96f729
--- /dev/null
+++ b/overlay/source/monitor_player_filter.hpp
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+
+namespace MonitorPlayerFilter {
+
+/* Missing connection flags mean an older schema/REST shape: preserve its
+ * previous behavior. If the field is present, only an explicit JSON true is
+ * considered an occupied node; false/null/invalid values are stale slots. */
+inline bool IncludeNode(bool hasConnectionFlag, const char *value) {
+    if (!hasConnectionFlag)
+        return true;
+    if (!value)
+        return false;
+    while (*value == ' ' || *value == '\t' || *value == '\r' || *value == '\n')
+        ++value;
+    if (std::strncmp(value, "true", 4) != 0)
+        return false;
+    const char next = value[4];
+    return next == '\0' || next == ',' || next == '}' || next == ']' ||
+           next == ' ' || next == '\t' || next == '\r' || next == '\n';
+}
+
+/* NetworkInfo has a fixed eight-slot array, but only indices below nodeCount
+ * belong to the current room. Later slots can retain names/flags from old peers. */
+inline bool IncludeConnectedSlot(std::size_t index, std::size_t nodeCount,
+                                 bool isConnected) {
+    return index < nodeCount && isConnected;
+}
+
+} // namespace MonitorPlayerFilter
diff --git a/overlay/source/monitor_target_generation.hpp b/overlay/source/monitor_target_generation.hpp
new file mode 100644
index 0000000..a0a3d78
--- /dev/null
+++ b/overlay/source/monitor_target_generation.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+/* A refresh request owns a generation token. Once a newer request is queued,
+ * older blocking network responses must not publish into the shared snapshot. */
+namespace MonitorTargetGeneration {
+
+using Value = std::uint32_t;
+
+class Gate {
+public:
+    Value Advance() { return generation_.fetch_add(1) + 1; }
+    Value Capture() const { return generation_.load(); }
+    bool IsCurrent(Value captured) const { return Capture() == captured; }
+
+private:
+    std::atomic<Value> generation_{0};
+};
+
+} // namespace MonitorTargetGeneration
diff --git a/overlay/source/monitor_title_resolver.hpp b/overlay/source/monitor_title_resolver.hpp
new file mode 100644
index 0000000..d0ac8cc
--- /dev/null
+++ b/overlay/source/monitor_title_resolver.hpp
@@ -0,0 +1,148 @@
+#pragma once
+
+#include <stddef.h>
+#include <string.h>
+
+/* Resolve title IDs for games whose LDN contentId is the all-F sentinel.
+ * advertiseData is the room's own hexadecimal LDN payload; no local process
+ * state is used, so rooms from different games cannot inherit the foreground
+ * application's title by accident. */
+namespace MonitorTitleResolver {
+
+static constexpr size_t kAdvertiseDataMaxBytes = 384;
+static constexpr size_t kAdvertiseDataMaxHex = kAdvertiseDataMaxBytes * 2;
+
+inline int HexDigit(char c) {
+    if (c >= '0' && c <= '9')
+        return c - '0';
+    if (c >= 'a' && c <= 'f')
+        return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F')
+        return c - 'A' + 10;
+    return -1;
+}
+
+inline bool NormalizeAdvertiseHex(const char *src, char *out, size_t outN,
+                                  size_t *outLen) {
+    if (outLen)
+        *outLen = 0;
+    if (!src || !out || outN == 0)
+        return false;
+
+    size_t len = 0;
+    for (const char *p = src; *p; ++p) {
+        const int digit = HexDigit(*p);
+        if (digit >= 0) {
+            if (len + 1 >= outN) {
+                out[0] = 0;
+                return false;
+            }
+            out[len++] = "0123456789abcdef"[digit];
+        } else if (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n' ||
+                   *p == ':' || *p == '-') {
+            continue;
+        } else {
+            out[0] = 0;
+            return false;
+        }
+    }
+    out[len] = 0;
+    if (outLen)
+        *outLen = len;
+    return len != 0 && (len & 1) == 0;
+}
+
+inline bool HexSpanContains(const char *begin, const char *end,
+                            const char *needle) {
+    if (!begin || !end || !needle || end < begin)
+        return false;
+    const size_t needleLen = strlen(needle);
+    const size_t spanLen = (size_t)(end - begin);
+    if (needleLen == 0)
+        return true;
+    if (needleLen > spanLen)
+        return false;
+    for (size_t i = 0; i + needleLen <= spanLen; ++i) {
+        if (memcmp(begin + i, needle, needleLen) == 0)
+            return true;
+    }
+    return false;
+}
+
+inline bool CopyTitleId(const char *titleId, char *out, size_t outN) {
+    if (!titleId || !out || outN < 17)
+        return false;
+    memcpy(out, titleId, 17);
+    return true;
+}
+
+/* Returns false when the advertisement is absent or does not match a known
+ * signature. The caller must then show the safe unknown-game fallback. */
+inline bool ResolveAdvertisedTitleId(const char *advertiseData,
+                                     const char *hostPlayerName,
+                                     char *outTitleId, size_t outN) {
+    if (outTitleId && outN > 0)
+        outTitleId[0] = 0;
+    if (!outTitleId || outN < 17)
+        return false;
+
+    char hex[kAdvertiseDataMaxHex + 1] = {};
+    size_t hexLen = 0;
+    if (!NormalizeAdvertiseHex(advertiseData, hex, sizeof(hex), &hexLen))
+        return false;
+
+    /* DRAGON BALL FighterZ: advertiseData == ffff0000. */
+    if (hexLen == 8 && strcmp(hex, "ffff0000") == 0)
+        return CopyTitleId("0100A250097F0000", outTitleId, outN);
+
+    /* Rocket League advertises a JSON object (7b = '{', 7d = '}'). */
+    if (hexLen >= 4 && hex[0] == '7' && hex[1] == 'b' &&
+        hex[hexLen - 2] == '7' && hex[hexLen - 1] == 'd')
+        return CopyTitleId("01005EE0036EC000", outTitleId, outN);
+
+    static const char kDelimiter[] = "00000004";
+    const size_t delimiterLen = sizeof(kDelimiter) - 1;
+    size_t delimiterCount = 0;
+    for (const char *p = hex; (p = strstr(p, kDelimiter)) != nullptr;
+         p += delimiterLen)
+        ++delimiterCount;
+    const char *firstDelimiter = strstr(hex, kDelimiter);
+    const char *firstPartEnd = firstDelimiter ? firstDelimiter : hex + hexLen;
+
+    /* MONSTER HUNTER RISE has player/rank sections after two delimiters. */
+    if (delimiterCount >= 2 &&
+        HexSpanContains(hex, firstPartEnd, "0000000008100000") &&
+        HexSpanContains(hex, firstPartEnd, "8b9000"))
+        return CopyTitleId("0100B04011742000", outTitleId, outN);
+
+    /* Monster Hunter Stories 2 shares the common prefix, but has 0a0000. */
+    if (HexSpanContains(hex, firstPartEnd, "0000000008100000") &&
+        HexSpanContains(hex, firstPartEnd, "0a0000"))
+        return CopyTitleId("0100E21011446000", outTitleId, outN);
+
+    /* Minecraft stores the host name as UTF-8 starting at hex offset 32. */
+    if (hostPlayerName && hostPlayerName[0] && hexLen > 32 &&
+        ((hexLen - 32) & 1) == 0) {
+        char decoded[96] = {};
+        size_t decodedLen = 0;
+        for (size_t i = 32; i + 1 < hexLen; i += 2) {
+            const int hi = HexDigit(hex[i]);
+            const int lo = HexDigit(hex[i + 1]);
+            if (hi < 0 || lo < 0)
+                return false;
+            const unsigned char byte = (unsigned char)((hi << 4) | lo);
+            if (byte == 0)
+                break;
+            if (decodedLen + 1 >= sizeof(decoded))
+                return false;
+            decoded[decodedLen++] = (char)byte;
+        }
+        decoded[decodedLen] = 0;
+        if (decodedLen != 0 && strcmp(decoded, hostPlayerName) == 0)
+            return CopyTitleId("0100D71004694000", outTitleId, outN);
+    }
+
+    return false;
+}
+
+} // namespace MonitorTitleResolver
