+        bool GetRelayEnabled();
+        int  ServerCount();
+        const char *ServerName(int index);
+        int  SelectedServer();
+        void SelectServer(int index);
+
+        /* Runtime server management, used by the Tesla overlay so users can
+           add/remove relays without a PC. All of these rewrite relay.cfg on
+           success; the in-memory list is the source of truth until reboot.
+           Ports are host order. */
+        bool AddServer(const char *name, const char *host, u16 port);
+        bool DeleteServer(int index);
+        void RestoreDefaultServers();
+        /* Per-index accessors (ServerHost/ServerPort above follow the current
+           selection). "" / 0 when the index is out of range. */
+        const char *ServerHostAt(int index);
+        u16  ServerPortAt(int index);
+        bool ServerIsBuiltin(int index);
+        /* Factory list (the relays shipped in the archive), exposed so the
+           overlay can offer a deleted one for re-adding. */
+        int  BuiltinServerCount();
+        const char *BuiltinServerName(int index);
+        const char *BuiltinServerHost(int index);
+        u16  BuiltinServerPort(int index);
+        /* Server the open transport is connected to; -1 when none is open.
+           SelectServer only rewrites the config, so the worker compares the
+           two and reopens when they differ. */
+        int  ActiveServer();
+        /* Last relay PING round-trip time in ms; 0 = not measured yet. */
+        u32  RelayGetLatencyMs();
+        /* Our virtual address (10.13.x.x, host order) or 0 if not assigned yet. */
+        u32  RelayGetVirtualAddress();
+        /* How the id was assigned: 0 unknown, 1 hardware-derived, 2 random. */
+        int  RelayGetIdSource();
+        /* This console's LAN address, host order; 0 if unavailable. */
+        u32  RelayGetLocalIp();
+
+        /* ServerIp is 0 when the server is a hostname; resolve ServerHost then. */
+        u32 ServerIp();
+        const char *ServerHost();
+        u16 ServerPort();
+
+        bool IsSessionPeer(u32 ip);
+
+        /* Thread-safe; -1 when no transport is open. Ports and IPs are host order. */
+        int BridgeSendGameBroadcast(const void *payload, size_t len, u16 dport);
+        int BridgeSendGameUnicast(const void *payload, size_t len, u16 dport, u32 dst_ip);
+        u32 BridgeSelfIp();
+
+        /* Open/Close/Reopen/RecvBroadcast/PathDead belong to the owning worker;
+           Send*, LearnPeer and RealIp are thread-safe. */
+        class RelayTransport {
+            public:
+                RelayTransport() = default;
+                ~RelayTransport() { this->Close(); }
+
+                Result Open();
+                void Close();
+                /* Replaces the socket without unpublishing, so TCP tunnels survive. */
+                Result Reopen();
+                bool IsOpen() const { return m_fd >= 0; }
+                int GetFd() const { return m_fd; }
+                u32 RealIp() const;
+
+                int SendBroadcast(const void *lan_packet, size_t size);
+                int SendKeepalive();
+                int SendPing();
+
+                /* Ping misses count only once the server has echoed a ping. */
+                bool PathDead() const;
+
+                /* Last PING round-trip time in ms; 0 = not measured yet. Thread-safe. */
+                u32 PingMs() const { return m_ping_ms.load(); }
+
+                /* Returns a discovery frame's length; game and TCP frames are
+                   dispatched internally (returns 0). <0 on error. */
+                int RecvBroadcast(void *out, size_t max_size, u32 *out_src_ip);
+
+                int SendGameBroadcast(const void *payload, size_t len, u16 dport);
+                int SendGameUnicast(const void *payload, size_t len, u16 dport, u32 dst_ip);
+                void LearnPeer(u32 real_ip, u32 vsrc);
+                int SendScope(u32 token);
+
+            private:
+                Result OpenSocket();
+                void CloseSocket();
+
+                /* Require m_mutex. */
+                int SendGameUnicastLocked(const void *payload, size_t len, u16 dport, u32 dst_ip);
+                int SendWrapped(u32 src, u32 dst, u16 sport, u16 dport, u16 ip_id, const void *payload, size_t len);
+                int SendFragmented(u32 src, u32 dst, const u8 *packet, size_t total);
+
+                int ProcessIpv4(const u8 *ip, size_t iplen, void *out, size_t max_size, u32 *out_src_ip);
+
+                /* False if the frame is malformed or our own. */
+                bool UnwrapGameShim(const u8 *ip, const u8 **payload, size_t *len, u32 *src) const;
+
+                const u8 *ReassembleFrag(const u8 *p, size_t n, size_t *out_len);
+
+                /* Hand-built DNS query: libnx getaddrinfo aborts in this sysmodule. */
+                u32 ResolveHostname(const char *host);
+
+                void InjectGameFrame(const u8 *ip, size_t iplen);
+
+                /* Guards m_fd, m_vsrc, m_rsrc, m_frag_send_id. Lock order:
+                   g_bridge_mutex -> m_mutex -> m_peer_mutex. */
+                mutable os::SdkMutex m_mutex;
+                int m_fd = -1;
+                u16 m_frag_send_id = 0;
+                u32 m_vsrc = 0;
+                u32 m_rsrc = 0;
+
+                NifmRequest m_req{};
+                bool m_have_req = false;
+                bool m_have_nifm_session = false;
+                bool m_published = false;
+
+                static constexpr int PeerMapMax = 16;
+                struct PeerAddr { u32 real; u32 vsrc; };
+                mutable os::SdkMutex m_peer_mutex;
+                PeerAddr m_peers[PeerMapMax] = {};
+                int m_peer_next = 0;
+                u32 LookupVsrc(u32 real_ip) const;
+
+                static constexpr u32 PingMaxMisses = 4;
+                /* Give up on an unreturned echo after this long so one lost
+                   probe cannot stall the latency readout indefinitely. */
+                static constexpr s64 PingEchoTimeoutMs = 3000;
+                std::atomic<u32> m_ping_misses{0};
+                std::atomic<bool> m_ping_supported{false};
+                /* Last PING round-trip time in ms; 0 = not measured yet.
+                   Only updated by an echo of a ping we are still waiting on. */
+                std::atomic<u32> m_ping_ms{0};
+
+                static constexpr int FragSlots = 4;
+                struct FragSlot {
+                    bool used;
+                    u16 id;
+                    u32 src;
+                    u8 mask;
+                    u16 total_len;
+                    u8 buffer[1600];
+                };
+                FragSlot m_frags[FragSlots] = {};
+                u8 m_frag_evict = 0;
+        };
+
+    }
+
+}
diff --git a/ldn_mitm/source/session_registry.cpp b/ldn_mitm/source/session_registry.cpp
new file mode 100644
index 0000000..9f6a4ef
--- /dev/null
+++ b/ldn_mitm/source/session_registry.cpp
@@ -0,0 +1,162 @@
+/*
+ * Copyright (c) 2018 Atmosphère-NX
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms and conditions of the GNU General Public License,
+ * version 2, as published by the Free Software Foundation.
+ *
+ * This program is distributed in the hope it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "session_registry.hpp"
+#include <mutex>
+#include <cstring>
+
+namespace ams::mitm::ldn {
+
+    namespace {
+        os::SdkMutex g_mutex;
+        SessionRegistry::Snapshot g_state = {};
+    }
+
+    void SessionRegistry::Publish(u32 bcast_ip, const u32 *peer_ips, int peer_count) {
+        std::scoped_lock lk(g_mutex);
+        if (peer_count > MaxPeers) {
+            peer_count = MaxPeers;
+        }
+        g_state.active     = true;
+        g_state.bcast_ip   = bcast_ip;
+        g_state.peer_count = peer_count;
+        for (int i = 0; i < peer_count; i++) {
+            g_state.peer_ips[i] = peer_ips[i];
+        }
+    }
+
+    void SessionRegistry::Clear() {
+        {
+            std::scoped_lock lk(g_mutex);
+            g_state = {};
+        }
+        /* The relay receive queue shares the session lifetime. */
+        GameRx::Clear();
+    }
+
+    void SessionRegistry::Get(Snapshot *out) {
+        std::scoped_lock lk(g_mutex);
+        *out = g_state;
+    }
+
+    namespace {
+        struct GameRxEntry {
+            u32 src_ip;
+            u16 sport;
+            u16 dport;
+            u16 len;
+            u8  data[GameRx::MaxPayload];
+        };
+        os::SdkMutex g_rx_mutex;
+        GameRxEntry g_rx_ring[GameRx::MaxEntries];
+        int g_rx_head = 0;
+        int g_rx_count = 0;
+        u16 g_session_dport = 0;
+        u32 g_overflow_dropped = 0;
+        u32 g_stale_dropped = 0;
+    }
+
+    int GameRx::Depth() {
+        std::scoped_lock lk(g_rx_mutex);
+        return g_rx_count;
+    }
+
+    u32 GameRx::OverflowDropped() {
+        std::scoped_lock lk(g_rx_mutex);
+        return g_overflow_dropped;
+    }
+
+    u32 GameRx::StaleDropped() {
+        std::scoped_lock lk(g_rx_mutex);
+        return g_stale_dropped;
+    }
+
+    void GameRx::Push(u32 src_ip, u16 sport, u16 dport, const void *data, size_t len) {
+        if (len == 0 || len > MaxPayload) {
+            return;
+        }
+        std::scoped_lock lk(g_rx_mutex);
+        /* Enqueue even before the session port is known. */
+        int slot;
+        if (g_rx_count == MaxEntries) {
+            slot = g_rx_head;
+            g_rx_head = (g_rx_head + 1) % MaxEntries;
+            g_overflow_dropped++;
+        } else {
+            slot = (g_rx_head + g_rx_count) % MaxEntries;
+            g_rx_count++;
+        }
+        GameRxEntry &e = g_rx_ring[slot];
+        e.src_ip = src_ip;
+        e.sport = sport;
+        e.dport = dport;
+        e.len = static_cast<u16>(len);
+        g_session_dport = dport;
+        std::memcpy(e.data, data, len);
+    }
+
+    bool GameRx::Pop(u32 *src_ip, u16 *sport, void *out, size_t max_len, size_t *out_len) {
+        std::scoped_lock lk(g_rx_mutex);
+        if (g_rx_count == 0) {
+            return false;
+        }
+        if (DropStale && g_rx_count > FreshDepth) {
+            const int skip = g_rx_count - FreshDepth;
+            g_rx_head = (g_rx_head + skip) % MaxEntries;
+            g_rx_count -= skip;
+            g_stale_dropped += static_cast<u32>(skip);
+        }
+        const GameRxEntry &e = g_rx_ring[g_rx_head];
+        const size_t n = e.len < max_len ? e.len : max_len;
+        std::memcpy(out, e.data, n);
+        if (src_ip)  { *src_ip = e.src_ip; }
+        if (sport)   { *sport = e.sport; }
+        if (out_len) { *out_len = n; }
+        g_rx_head = (g_rx_head + 1) % MaxEntries;
+        g_rx_count--;
+        return true;
+    }
+
+    bool GameRx::HasData() {
+        std::scoped_lock lk(g_rx_mutex);
+        return g_rx_count > 0;
+    }
+
+    void GameRx::NoteSessionPort(u16 port) {
+        if (port == 0) {
+            return;
+        }
+        std::scoped_lock lk(g_rx_mutex);
+        if (g_session_dport == 0) {
+            g_session_dport = port;
+        }
+    }
+
+    u16 GameRx::SessionDport() {
+        std::scoped_lock lk(g_rx_mutex);
+        return g_session_dport;
+    }
+
+    void GameRx::Clear() {
+        std::scoped_lock lk(g_rx_mutex);
+        g_rx_count = 0;
+        g_rx_head = 0;
+        g_session_dport = 0;
+        g_overflow_dropped = 0;
+        g_stale_dropped = 0;
+    }
+
+}
