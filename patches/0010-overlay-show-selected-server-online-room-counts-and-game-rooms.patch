+static void ProbeHeap() {
+    static const size_t kProbes[] = { 256u * 1024, 700u * 1024, 1400u * 1024 };
+    char msg[48];
+    for (size_t sz : kProbes) {
+        void *p = malloc(sz);
+        snprintf(msg, sizeof(msg), "probe-%uK %s",
