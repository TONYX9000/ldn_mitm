+static u32 g_monitorVersion = 0xFFFFFFFFu;   /* 强制首次重建 */
+/* 游戏房间标题在列表中的下标;房间行用 addItem 的 index 参数插到它正下方
+   (直接 addItem 会被追加到列表末尾,跑到「关于」后面)。 */
