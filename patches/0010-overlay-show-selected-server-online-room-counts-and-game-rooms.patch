+                             false, 30, 693, 23,
+                             R::a(tsl::style::color::ColorText));
+
+        if (this->m_contentElement != nullptr)
+            this->m_contentElement->frame(renderer);
+
+        /* 最后再把"标题下面那一行"整条刷成底色:任何来源的文字(副标题、
+           上一帧残留、列表过界)都不会留在标题下方。 */
+        renderer->drawRect(0, kTitleBaseline + 6, tsl::cfg::FramebufferWidth,
+                           kContentY - kTitleBaseline - 8,
+                           R::a(tsl::style::color::ColorFrameBackground));
+    }
+
+    /* 内容区上移:标题下面那一行不再留给副标题。 */
+    virtual void layout(u16 parentX, u16 parentY, u16 parentWidth,
+                        u16 parentHeight) override {
+        this->setBoundaries(parentX, parentY, parentWidth, parentHeight);
+        if (this->m_contentElement != nullptr) {
+            this->m_contentElement->setBoundaries(parentX + 35, parentY + kContentY,
+                                                  parentWidth - 85,
+                                                  parentHeight - 73 - kContentY);
+            this->m_contentElement->invalidate();
+        }
+    }
+};
