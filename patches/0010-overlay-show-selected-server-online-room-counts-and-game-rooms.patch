+/* ------------------------------------------------------------------ */
+/* UDP 主动房间扫描(lan-play 中继协议的 LDN 扫描)                     */
+/* ------------------------------------------------------------------ */
+
+/* LanPlayMonitor 的 LDN_SCAN_FRAME 预生成常量:
+ *   0x01                              lan-play 原始包 chunk
+ *   IPv4(10.13.37.0 -> 10.13.255.255, UDP 11452)
+ *   LDN 头 {00 14 45 11} + type=0     扫描请求
+ * 校验和已预计算,勿手改。 */
+static const u8 kScanFrame[] = {
+    0x01, 0x45, 0x00, 0x00, 0x28, 0x00, 0x00, 0x40, 0x00, 0x40, 0x11, 0x01,
+    0xAC, 0x0A, 0x0D, 0x25, 0x00, 0x0A, 0x0D, 0xFF, 0xFF, 0x2C, 0xBC, 0x2C,
+    0xBC, 0x00, 0x14, 0x28, 0x0F, 0x00, 0x14, 0x45, 0x11, 0x00, 0x00, 0x00,
+    0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+/* ldn_mitm RLE 解压:字面字节;0x00 + count = count 个 0 */
+static bool LdnDecompress(const u8 *in, size_t inLen, u8 *out, size_t expect) {
+    if (expect == 0 || expect > 8192 || inLen > 8192)
+        return false;
+    size_t o = 0, i = 0;
+    while (i < inLen && o < expect) {
+        u8 v = in[i++];
+        out[o++] = v;
+        if (v == 0) {
+            if (i >= inLen)
+                return false;
+            u8 rep = in[i++];
+            if (o + rep > expect)
+                return false;
+            memset(out + o, 0, rep);
+            o += rep;
+        }
+    }
+    return i == inLen && o == expect;
+}
+
+/* NetworkInfo(≥0x480)-> 房间条目 + 会话标识(去重用) */
+static bool ParseNetworkInfo(const u8 *p, size_t len, MonitorRoom *out,
+                             char *sessionTag, size_t tagN) {
+    if (len < 0x480)
+        return false;
+    memset(out, 0, sizeof(*out));
+    char cid[20];
+    for (int i = 0; i < 8; i++)
+        snprintf(cid + i * 2, 3, "%02X", p[7 - i]);   /* 小端 8 字节 -> 标题ID */
+
+    /* NetworkInfo: advertiseDataSize @ 0x26a, data @ 0x26c; the first
+     * NodeInfo's playerName (host) starts at 0x74. */
+    char advertiseHex[MonitorTitleResolver::kAdvertiseDataMaxHex + 1] = {};
+    size_t advertiseSize = (size_t)p[0x26A] | ((size_t)p[0x26B] << 8);
+    if (advertiseSize > MonitorTitleResolver::kAdvertiseDataMaxBytes)
+        advertiseSize = MonitorTitleResolver::kAdvertiseDataMaxBytes;
+    if (0x26C + advertiseSize > len)
+        advertiseSize = 0;
+    static const char kHex[] = "0123456789abcdef";
+    for (size_t i = 0; i < advertiseSize; i++) {
+        const u8 byte = p[0x26C + i];
+        advertiseHex[i * 2] = kHex[byte >> 4];
+        advertiseHex[i * 2 + 1] = kHex[byte & 0x0F];
+    }
+    char hostName[MONITOR_PLAYER_LEN + 1] = {};
+    memcpy(hostName, p + 0x74, MONITOR_PLAYER_LEN);
+    hostName[MONITOR_PLAYER_LEN] = 0;
+    FormatGameName(cid, nullptr, nullptr, advertiseHex, hostName,
+                   out->game, sizeof(out->game));
+
+    u32 maxN = p[0x66];
+    u32 cnt = p[0x67];
+    if (maxN > 8) maxN = 8;
+    if (cnt > 8) cnt = 8;
+    out->players = cnt;
+    out->playersMax = maxN ? maxN : cnt;
+    if (sessionTag && tagN > 0) {
+        /* 与 lpm_main.py 一致:sessionId = payload[16:32] 的 hex;
+           全零时退回标题ID 做标识。 */
+        bool allZero = true;
+        for (int i = 0; i < 16; i++) {
+            if (p[16 + i]) {
+                allZero = false;
+                break;
+            }
+        }
+        if (allZero) {
+            snprintf(sessionTag, tagN, "%s", cid);
+        } else {
+            char tag[33];
+            for (int i = 0; i < 16; i++)
+                snprintf(tag + i * 2, 3, "%02x", p[16 + i]);
+            snprintf(sessionTag, tagN, "%s", tag);
+        }
+        snprintf(out->sessionId, sizeof(out->sessionId), "%s", sessionTag);
+    }
+    /* 玩家名单:NetworkInfo 的 nodes[8] 带每个节点的用户名(起始 0x68、
+     * 步长 0x40:isConnected @+11、userName[33] @+12)。只读取 nodeCount
+     * 范围内的槽位;固定数组后面的槽可能保留上一个房间的旧昵称/连接位,
+     * 是切换房间或服务器后偶发串名的来源。主机(AP, nodes[0])排最前。 */
+    if (len >= 0x68 + (size_t)cnt * 0x40) {
+        u8 pn = 0;
+        for (u32 i = 0; i < cnt && pn < MONITOR_MAX_PLAYERS; i++) {
+            const u8 *nd = p + 0x68 + (size_t)i * 0x40;
+            if (!MonitorPlayerFilter::IncludeConnectedSlot(i, cnt, nd[11] == 1))
+                continue;
+            char nm[MONITOR_PLAYER_LEN];
+            memcpy(nm, nd + 12, MONITOR_PLAYER_LEN - 1);
+            nm[MONITOR_PLAYER_LEN - 1] = 0;
+            if (nm[0]) {
+                bool dup = false;
+                for (u8 j = 0; j < pn; j++) {
+                    if (strcmp(out->player[j], nm) == 0) {
+                        dup = true;
+                        break;
+                    }
+                }
+                if (!dup)
+                    snprintf(out->player[pn++], MONITOR_PLAYER_LEN, "%s", nm);
+            }
+        }
+        out->playerN = pn;
+    }
+    return out->game[0] != 0;
+}
+
+/* IPv4 + UDP(11452) + LDN 响应 */
+static bool ParseLdnResponse(const u8 *pkt, size_t len, MonitorRoom *room,
+                             char *sessionTag, size_t tagN) {
+    if (len < 20 || (pkt[0] >> 4) != 4)
+        return false;
+    size_t ihl = (size_t)(pkt[0] & 0x0F) * 4;
+    if (ihl < 20 || len < ihl + 8)
+        return false;
+    if (pkt[9] != 17)                      /* UDP */
+        return false;
+    const u8 *udp = pkt + ihl;
+    u32 sport = ((u32)udp[0] << 8) | udp[1];
+    u32 dport = ((u32)udp[2] << 8) | udp[3];
+    if (sport != 11452 || dport != 11452)
+        return false;
+    size_t udpLen = ((size_t)udp[4] << 8) | udp[5];
+    if (udpLen < 8)
+        return false;
+    size_t body = udpLen - 8;
+    if (body > len - ihl - 8)
+        body = len - ihl - 8;
+    const u8 *ldn = udp + 8;
+    if (body < 12)
+        return false;
+    if (ldn[0] != 0x00 || ldn[1] != 0x14 || ldn[2] != 0x45 || ldn[3] != 0x11)
+        return false;
+    if (ldn[4] != 1)                       /* type 1 = NetworkInfo 响应 */
+        return false;
+    size_t bodyLen   = (size_t)ldn[6] | ((size_t)ldn[7] << 8);
+    size_t decompLen = (size_t)ldn[8] | ((size_t)ldn[9] << 8);
+    if (bodyLen > body - 12)
+        return false;
+
+    /* This parser is only called by the single monitor worker. Keep the
+     * decompression scratch off its stack; older ovlloader builds provide a
+     * smaller/less forgiving thread stack than current builds. */
+    static u8 tmp[8192];
+    const u8 *info = ldn + 12;
+    size_t infoLen = bodyLen;
+    if (ldn[5] == 1) {                     /* 压缩 */
+        if (!LdnDecompress(info, bodyLen, tmp, decompLen))
+            return false;
+        info = tmp;
+        infoLen = decompLen;
+    }
+    return ParseNetworkInfo(info, infoLen, room, sessionTag, tagN);
+}
+
+/* type=3 分片重组:同 src+ident 的分片按 pmtu 偏移拼接 */
+struct FragSlot {
+    bool used;
+    u32 srcIp;
+    u16 ident;
+    u8  total;
+    u16 pmtu;
+    u16 dataLen;
+    u64 partsMask;                  /* 已收分片位图(total ≤ 64) */
+    u8  data[8192];
+};
+static FragSlot g_frags[4];
+
+static bool FragAdd(const u8 *frame, size_t len, const u8 **outPkt, size_t *outLen) {
+    if (len < 16)
+        return false;
+    u32 srcIp;
+    memcpy(&srcIp, frame, 4);
+    u16 ident = (u16)(((u32)frame[8] << 8) | frame[9]);
+    u8 part = frame[10];
+    u8 total = frame[11];
+    u16 partLen = (u16)((u32)frame[12] | ((u32)frame[13] << 8));
+    u16 pmtu = (u16)(((u32)frame[14] << 8) | frame[15]);
+    if (total == 0 || total > 64 || part >= total || pmtu == 0)
+        return false;
+    if ((size_t)partLen > len - 16)
+        return false;
+    size_t end = (size_t)part * pmtu + partLen;
+    if (end == 0 || end > 8192)
+        return false;
+
+    FragSlot *slot = nullptr;
+    for (auto &f : g_frags) {
+        if (f.used && f.srcIp == srcIp && f.ident == ident) {
+            slot = &f;
+            break;
+        }
+    }
+    if (!slot) {
+        for (auto &f : g_frags) {
+            if (!f.used) {
+                slot = &f;
+                break;
+            }
+        }
+        if (!slot)
+            return false;
+        memset(slot, 0, sizeof(*slot));
+        slot->used = true;
+        slot->srcIp = srcIp;
+        slot->ident = ident;
+        slot->total = total;
+        slot->pmtu = pmtu;
+    }
+    if (slot->total != total || slot->pmtu != pmtu) {
+        slot->used = false;
+        return false;
+    }
+    memcpy(slot->data + (size_t)part * pmtu, frame + 16, partLen);
+    if ((size_t)part * pmtu + partLen > slot->dataLen)
+        slot->dataLen = (u16)end;
+    slot->partsMask |= 1ull << part;
+
+    u64 need = (total == 64) ? ~0ull : ((1ull << total) - 1);
+    if (slot->partsMask != need)
+        return false;
+    *outPkt = slot->data;
+    *outLen = slot->dataLen;
+    slot->used = false;
+    return true;
+}
+
+static void UdpRoomScan(const char *host, u16 port, QueryResult *qr) {
+    struct sockaddr_in sa;
+    if (!HttpResolve(host, &sa))
+        return;
+    sa.sin_port = htons(port);
+
+    int fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0)
+        return;
+    if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) != 0) {
+        close(fd);
+        return;
+    }
+
+    /* 排空积压 */
+    HttpSetNonBlock(fd, true);
+    u8 drain[2048];
+    while (recv(fd, drain, sizeof(drain), 0) > 0) {}
+    HttpSetNonBlock(fd, false);
+
+    struct timeval rtv;
+    rtv.tv_sec = 0;
+    rtv.tv_usec = 200 * 1000;
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &rtv, sizeof(rtv));
+
+    memset(g_frags, 0, sizeof(g_frags));
+
+    Deadline start = std::chrono::steady_clock::now();
+    Deadline deadline = start + std::chrono::milliseconds(1500);
+    Deadline nextSend = start;
+
+    char seen[kMaxScanRooms][36];
+    u32 seenN = 0;
+
+    u8 frame[2048];
+    while (std::chrono::steady_clock::now() < deadline && qr->roomN < MONITOR_MAX_ROOMS) {
+        Deadline now = std::chrono::steady_clock::now();
+        if (now >= nextSend) {
+            send(fd, kScanFrame, sizeof(kScanFrame), 0);
+            nextSend = now + std::chrono::milliseconds(700);
+        }
+        ssize_t n = recv(fd, frame, sizeof(frame), 0);
+        if (n <= 0)
+            continue;
+        const u8 *pkt = nullptr;
+        size_t pktLen = 0;
+        if (frame[0] == 1) {
+            pkt = frame + 1;
+            pktLen = (size_t)n - 1;
+        } else if (frame[0] == 3) {
+            if (!FragAdd(frame + 1, (size_t)n - 1, &pkt, &pktLen))
+                continue;
+        } else {
+            continue;
+        }
+
+        MonitorRoom room;
+        memset(&room, 0, sizeof(room));
+        char tag[36] = {};
+        if (!ParseLdnResponse(pkt, pktLen, &room, tag, sizeof(tag)))
+            continue;
+
+        bool dup = false;
+        for (u32 i = 0; i < seenN; i++) {
+            if (strcmp(seen[i], tag) == 0) {
+                dup = true;
+                break;
+            }
+        }
+        if (dup)
+            continue;
+        if (seenN < kMaxScanRooms)
+            snprintf(seen[seenN++], sizeof(seen[0]), "%s", tag);
+
+        qr->rooms[qr->roomN++] = room;
+    }
+    close(fd);
+}
+
+/* ------------------------------------------------------------------ */
+/* 房间 5 秒 TTL 缓存                                                   */
+/* ------------------------------------------------------------------ */
+
+/* 查询/UDP 扫描都有偶发丢包与瞬间空列表(日志里 scan rooms=0/1 交替),
+ * 直接把当次结果写进快照会让房间列表每秒闪一下。
+ * 缓存以 sessionId 为键:命中即刷新时间戳并更新房间数据;当次没出现
+ * 的条目再保留 5 秒才删除;服务器身份变化时整体清空。
+ * 在线人数/房间数量同口径:查询失败时沿用最近一次成功值,超过 5 秒
+ * 仍失败才退回「未知」。 */
+static constexpr auto kRoomTtl = std::chrono::seconds(5);
+
+struct RoomCacheEnt {
+    bool used = false;
+    char key[40] = {};
+    Deadline lastSeen{};
+    MonitorRoom room;
+};
+static RoomCacheEnt g_roomCache[MONITOR_MAX_ROOMS];
+static char g_cacheServer[128] = {};    /* 缓存归属的服务器 host:port */
+static Deadline g_lastOk{};             /* 最近一次查询成功时刻 */
+static bool  g_haveLastOk = false;
+static s32   g_lastOnline = -1;
+static s32   g_lastRoomCount = -1;
+
+static void RoomCacheKey(const MonitorRoom &r, char *out, size_t n) {
+    if (r.sessionId[0])
+        snprintf(out, n, "%s", r.sessionId);
+    else
+        snprintf(out, n, "g:%s", r.game);
+}
+
+static void RoomCacheReset() {
+    for (auto &e : g_roomCache)
+        e.used = false;
+    g_cacheServer[0] = 0;
+    g_haveLastOk = false;
+    g_lastOnline = -1;
+    g_lastRoomCount = -1;
+}
+
+static void RoomCacheUpsert(const MonitorRoom &r, const Deadline &now) {
+    char key[40];
+    RoomCacheKey(r, key, sizeof(key));
+    int freeSlot = -1, oldest = -1;
+    for (u32 i = 0; i < MONITOR_MAX_ROOMS; i++) {
+        RoomCacheEnt &e = g_roomCache[i];
+        if (!e.used) {
+            if (freeSlot < 0)
+                freeSlot = (int)i;
+            continue;
+        }
+        if (strcmp(e.key, key) == 0) {
+            e.room = r;
+            e.lastSeen = now;
+            return;
+        }
+        if (oldest < 0 || e.lastSeen < g_roomCache[oldest].lastSeen)
+            oldest = (int)i;
+    }
+    int slot = (freeSlot >= 0) ? freeSlot : oldest;
+    if (slot < 0)
+        return;
+    RoomCacheEnt &e = g_roomCache[slot];
+    e.used = true;
+    snprintf(e.key, sizeof(e.key), "%s", key);
+    e.lastSeen = now;
+    e.room = r;
+}
+
+static void RoomCacheExpire(const Deadline &now) {
+    for (auto &e : g_roomCache) {
+        if (e.used && (now - e.lastSeen) > kRoomTtl)
+            e.used = false;
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 刷新流程                                                            */
+/* ------------------------------------------------------------------ */
+
+/* TLS/curl and JSON parsing can nest more deeply on older runtimes. Reserve
+ * 256 KiB instead of 64 KiB; this is static overlay memory, not heap. */
+alignas(0x1000) static u8 g_workerStack[0x40000];
+
+static void LogWorkerStack(const char *phase) {
+    volatile u8 probe = 0;
+    const std::uintptr_t base = reinterpret_cast<std::uintptr_t>(g_workerStack);
+    const std::uintptr_t end = base + sizeof(g_workerStack);
+    const std::uintptr_t current = reinterpret_cast<std::uintptr_t>(&probe);
+    char msg[128];
+    if (current >= base && current < end) {
+        snprintf(msg, sizeof(msg), "%s worker-stack used=%uK free=%uK", phase,
+                 static_cast<unsigned>((end - current) / 1024),
+                 static_cast<unsigned>((current - base) / 1024));
+    } else {
+        /* Never print a wrapped/negative "free stack" number. This also
+         * diagnoses a runtime that did not use the supplied stack buffer. */
+        snprintf(msg, sizeof(msg), "%s worker-stack range-mismatch sp=%p range=%p..%p",
+                 phase, reinterpret_cast<void *>(current),
+                 reinterpret_cast<void *>(base), reinterpret_cast<void *>(end));
+    }
+    MonLog(msg);
+}
+
+static void DoRefresh(const char *nameOverride, bool reloadSubs,
+                      MonitorTargetGeneration::Value targetGen) {
+    bool staleTarget = false;
+    {
+        std::scoped_lock lk(g_mutex);
+        staleTarget = !g_targetGen.IsCurrent(targetGen);
+        if (!staleTarget) {
+            g_snap.busy = true;
+            /* 同一服务器的轮询继续展示上一结果;切服时由请求入口先清空。 */
+            snprintf(g_snap.status, sizeof(g_snap.status), "%s",
+                     T_STR("正在查询…", "正在查詢…"));
+        }
+    }
+    if (staleTarget) {
+        MonLog("refresh-discard stale-target-before-start");
+        return;
+    }
+
+    LogWorkerStack("refresh-start");
+    EnsureSockets();
+
+    static QueryResult qr;            /* 约 8.7KB:static,不占工作线程栈 */
+    qr = QueryResult{};
+
+    /* 1. 当前选择的服务器 */
+    char name[48] = {}, host[64] = {};
+    u16 port = 11451;
+    bool haveServer = ResolveSelectedServer(nameOverride, name, sizeof(name),
+                                            host, sizeof(host), &port);
+    {
+        char m[160];
+        if (haveServer)
+            snprintf(m, sizeof(m), "resolve ok gen=%u %s %s:%u",
+                     static_cast<unsigned>(targetGen), name, host, (unsigned)port);
+        else
+            snprintf(m, sizeof(m), "resolve FAIL gen=%u %s",
+                     static_cast<unsigned>(targetGen),
+                     nameOverride ? nameOverride : "(selected)");
+        MonLog(m);
+    }
+
+    /* Publish/clear only if this request still targets the selected server. */
+    {
+        char ident[128];
+        snprintf(ident, sizeof(ident), "%s:%u", host, (unsigned)port);
+        std::scoped_lock lk(g_mutex);
+        staleTarget = !g_targetGen.IsCurrent(targetGen);
+        if (!staleTarget) {
+            snprintf(g_snap.server, sizeof(g_snap.server), "%.47s",
+                     name[0] ? name : (host[0] ? host : "?"));
+            if (strcmp(ident, g_cacheServer) != 0) {
+                RoomCacheReset();
+                g_snap.online = -1;
+                g_snap.roomCount = -1;
+                g_snap.roomN = 0;
+                memset(g_snap.rooms, 0, sizeof(g_snap.rooms));
+                g_snap.version++;
+            }
+            snprintf(g_cacheServer, sizeof(g_cacheServer), "%s", ident);
+        }
+    }
+    if (staleTarget) {
+        MonLog("refresh-discard stale-target-after-resolve");
+        return;
+    }
+
+    /* 2. 订阅(chinese_db.json):开盖/手动刷新时拉取(周期轮询跳过),
+     *    失败退回本地缓存;servers.json 已彻底移除,服务器列表只读 relay.cfg。
+     *    下载走 HTTPS 加速镜像(https://v6.gh-proxy.org/),删了缓存也能重拉 */
+    if (reloadSubs) {
+        MonLog("subs-start");
+        std::string chineseJson;
+        bool gotChinese = DownloadSubscription(kSubChinesePath, &chineseJson);
+        if (gotChinese)
+            SaveFile(kSaveChinesePath, chineseJson);
+        else {
+            gotChinese = LoadFile(kSaveChinesePath, &chineseJson);
+            MonLog(gotChinese ? "chinese: use cache" : "chinese: no cache");
+        }
+        if (gotChinese) {
+            EnsureTitleTables();
+            if (g_titleKey) {
+                g_titleArenaUsed = 0;
+                memset(g_titleKey, 0, kTitleHashSize * sizeof(u64));
+                /* 先释放 JSON 字符串(约 0.5MB),再从落盘文件流式解析,
+                 * 避免字符串与标题表同驻把 ovlloader 的堆挤爆。 */
+                std::string().swap(chineseJson);
+                if (!ParseChineseDbFile(kSaveChinesePath))
+                    MonLog("chinese_db: open file failed");
+            }
+        }
+    }
+
+    if (!haveServer) {
+        bool stale = false;
+        {
+            std::scoped_lock lk(g_mutex);
+            stale = !g_targetGen.IsCurrent(targetGen);
+            if (!stale) {
+                snprintf(g_snap.status, sizeof(g_snap.status), "%s",
+                         T_STR("找不到选中的服务器", "找不到選中的伺服器"));
+                g_snap.busy = false;
+                g_snap.version++;
+            }
+        }
+        if (stale)
+            MonLog("refresh-discard stale-target-no-server");
+        return;
+    }
+
+    if (!g_targetGen.IsCurrent(targetGen)) {
+        MonLog("refresh-discard stale-target-before-query");
+        return;
+    }
+
+    /* 4. 查询:自动识别 —— graphql 优先(含房间),失败再 rest
+     *    (servers.json 已移除,不再按 host:port 查类型表) */
+    bool ok = QueryGraphql(host, port, &qr);
+    if (!ok)
+        ok = QueryRest(host, port, &qr);
+    {
+        char m[56];
+        snprintf(m, sizeof(m), "query auto e=%d on=%d rooms=%u",
+                 g_httpErr, qr.online, (unsigned)qr.roomN);
+        MonLog(m);
+    }
+
+    /* 6. 接口不给房间时,用 UDP 主动扫描补房间(rest 1.0 服务器) */
+    if (ok && qr.roomN == 0) {
+        UdpRoomScan(host, port, &qr);
+        char m[24];
+        snprintf(m, sizeof(m), "scan rooms=%u", (unsigned)qr.roomN);
+        MonLog(m);
+    }
+
+    /* 7. 并入房间 5 秒 TTL 缓存后写快照:当次查到的房间刷新时间戳,
+     *    没查到的旧房间再保留 5 秒,列表不再随单次丢包闪烁。 */
+    u32 mlogN = 0;
+    s32 mlogOn = -1;
+    bool staleAfterQuery = false;
+    {
+        const Deadline now = std::chrono::steady_clock::now();
+        std::scoped_lock lk(g_mutex);
+        staleAfterQuery = !g_targetGen.IsCurrent(targetGen);
+        if (!staleAfterQuery) {
+            if (ok) {
+                for (u32 i = 0; i < qr.roomN; i++)
+                    RoomCacheUpsert(qr.rooms[i], now);
+                g_lastOk = now;
+                g_haveLastOk = true;
+            }
+            RoomCacheExpire(now);
+
+            u32 n = 0;
+            for (u32 i = 0; i < MONITOR_MAX_ROOMS; i++) {
+                if (g_roomCache[i].used)
+                    g_snap.rooms[n++] = g_roomCache[i].room;
+            }
+            g_snap.roomN = n;
+            const bool fresh = g_haveLastOk && (now - g_lastOk) <= kRoomTtl;
+            if (ok) {
+                g_snap.online = qr.online;
+                g_snap.roomCount = (s32)n;
+                g_lastOnline = qr.online;
+                g_lastRoomCount = (s32)n;
+            } else if (fresh) {
+                /* 瞬间失败:5 秒内沿用最近一次成功的在线/房间数 */
+                g_snap.online = g_lastOnline;
+                g_snap.roomCount = g_lastRoomCount;
+            } else {
+                g_snap.online = -1;
+                g_snap.roomCount = -1;
+            }
+            if (!ok) {
+                if (!g_sockInited)
+                    snprintf(g_snap.status, sizeof(g_snap.status), "%s",
+                             T_STR("网络初始化失败", "網絡初始化失敗"));
+                else
+                    snprintf(g_snap.status, sizeof(g_snap.status), "%s e=%d",
+                             T_STR("查询失败", "查詢失敗"), g_httpErr);
+            } else if (n == 0) {
+                snprintf(g_snap.status, sizeof(g_snap.status), "%s",
+                         T_STR("暂无房间", "暫無房間"));
+            } else {
+                g_snap.status[0] = 0;
+            }
+            g_snap.busy = false;
+            g_snap.version++;
+            mlogN = n;
+            mlogOn = g_snap.online;
+        }
+    }
+    if (staleAfterQuery) {
+        MonLog("refresh-discard stale-target-after-query");
+        return;
+    }
+    {
+        char m[48];
+        snprintf(m, sizeof(m), "cache rooms=%u on=%d", (unsigned)mlogN, (int)mlogOn);
+        MonLog(m);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* 后台线程(libnx 线程,风格同 libtesla)                               */
+/* ------------------------------------------------------------------ */
+
+
+static void MonitorWorker(void *) {
+    while (!g_exit.load()) {
+        u32 want = g_reqGen.load();
+        if (want != g_doneGen) {
+            g_doneGen = want;
+            char name[48];
+            bool subs;
+            MonitorTargetGeneration::Value targetGen;
+            {
+                std::scoped_lock lk(g_mutex);
+                memcpy(name, g_pendingName, sizeof(name));
+                subs = g_pendingSubs;
+                g_pendingSubs = false;
+                targetGen = g_targetGen.Capture();
+            }
+            DoRefresh(name[0] ? name : nullptr, subs, targetGen);
+            MonLog("refresh-done");
+        } else {
+            svcSleepThread(50'000'000);      /* 50ms */
+        }
+    }
+}
+
+void MonitorSetTraditional(bool traditional) {
+    g_traditional.store(traditional);
+}
+
+/* 标题表延迟到首次解析时才分配(约 0.5MB),避免在 overlay 刚打开、
+ * 渲染器 frameBuffer(约 1.3MB)分配之前就把 ovlloader 仅几 MB 的堆挤爆。 */
+static void EnsureTitleTables() {
+    if (g_titleKey)
+        return;
+    g_titleKey   = (u64 *)calloc(kTitleHashSize, sizeof(u64));
+    g_titleOff   = (u32 *)calloc(kTitleHashSize, sizeof(u32));
+    g_titleLen   = (u16 *)calloc(kTitleHashSize, sizeof(u16));
+    g_titleArena = (char *)calloc(kTitleArena, 1);
+    if (!g_titleKey || !g_titleOff || !g_titleLen || !g_titleArena) {
+        free(g_titleKey); free(g_titleOff); free(g_titleLen); free(g_titleArena);
+        g_titleKey = nullptr; g_titleOff = nullptr;
+        g_titleLen = nullptr; g_titleArena = nullptr;
+    }
+}
+
+void MonitorInit() {
+    if (g_inited)
+        return;
+    g_inited = true;
+    g_exit.store(false);
+    g_pendingName[0] = 0;
+    EnsureSd();
+    mkdir("sdmc:/config", 0777);
+    mkdir(kSaveDir, 0777);
+    MonLog("worker-init");
+    ProbeHeap();
+
+    Result rc = threadCreate(&g_thread, MonitorWorker, nullptr, g_workerStack,
+                             sizeof(g_workerStack), 0x2C, -2);
+    if (R_SUCCEEDED(rc))
+        threadStart(&g_thread);
+}
+
+void MonitorExit() {
+    if (!g_inited)
+        return;
+    g_exit.store(true);
+    threadWaitForExit(&g_thread);
+    threadClose(&g_thread);
+    if (g_sockInited) {
+        socketExit();
+        g_sockInited = false;
+    }
+    g_inited = false;
+}
+
+/* Must be called with g_mutex held. Detach the published room list from the
+ * previous target immediately, before the blocking worker starts its query. */
+static void ResetSnapshotForRequestLocked(const char *serverName,
+                                          const char *status) {
+    snprintf(g_snap.server, sizeof(g_snap.server), "%.47s",
+             serverName ? serverName : "");
+    g_snap.online = -1;
+    g_snap.roomCount = -1;
+    g_snap.roomN = 0;
+    memset(g_snap.rooms, 0, sizeof(g_snap.rooms));
+    snprintf(g_snap.status, sizeof(g_snap.status), "%s", status);
+    g_snap.busy = true;
+    g_snap.version++;
+}
+
+void MonitorRequestRefresh(const char *serverName) {
+    std::scoped_lock lk(g_mutex);
+    snprintf(g_pendingName, sizeof(g_pendingName), "%s", serverName ? serverName : "");
+    g_pendingSubs = true;      /* 开盖/手动刷新:同时重新拉订阅缓存 */
+    g_targetGen.Advance();
+    ResetSnapshotForRequestLocked(
+        serverName, T_STR("正在刷新服务器…", "正在刷新伺服器…"));
+    g_reqGen.fetch_add(1);
+}
+
+void MonitorRequestSwitch(const char *serverName) {
+    std::scoped_lock lk(g_mutex);
+    snprintf(g_pendingName, sizeof(g_pendingName), "%s", serverName ? serverName : "");
+    g_targetGen.Advance();
+    ResetSnapshotForRequestLocked(
+        serverName, T_STR("正在切换服务器…", "正在切換伺服器…"));
+    g_reqGen.fetch_add(1);
+}
+
+void MonitorRequestPoll() {
+    /* 周期刷新(与延迟 ping 同节奏):不动目标、不拉订阅 */
+    g_reqGen.fetch_add(1);
+}
+
+void MonitorCopySnapshot(MonitorSnapshot *out) {
+    std::scoped_lock lk(g_mutex);
+    *out = g_snap;
+}
diff --git a/overlay/source/monitor.hpp b/overlay/source/monitor.hpp
new file mode 100644
index 0000000..3e9ee8a
--- /dev/null
+++ b/overlay/source/monitor.hpp
@@ -0,0 +1,71 @@
+#pragma once
+#include <switch.h>
+
+/* 联机监视器:当前中继服务器的在线人数 / 房间数 / 游戏房间列表。
+ *
+ * 数据来源:
+ *   1. 服务器列表      relay.cfg(与 sysmodule LoadConfig 同解析;servers.json 已移除)
+ *   2. 标题映射订阅    chinese_db.json (标题ID -> 中文名)
+ *   3. 服务器自身的查询接口(graphql POST / 或 rest GET /info),
+ *      rest 服务器接口不给房间时用 UDP 主动扫描补上。
+ *
+ * chinese_db.json 每次打开 overlay 从远程重新下载(HTTPS 加速镜像
+ * https://v6.gh-proxy.org/ 优先),落盘到
+ * sdmc:/config/ldn_mitm/ 下供下次离线兜底。
+ */
+
+#define MONITOR_MAX_ROOMS  32
+#define MONITOR_MAX_SERVERS 32
+#define MONITOR_MAX_PLAYERS 8
+#define MONITOR_PLAYER_LEN  32
+
+struct MonitorRoom {
+    char game[52];      /* 中文游戏名;未映射时是 16 位标题 ID */
+    u32  players;       /* 当前人数 */
+    u32  playersMax;    /* 人数上限,0 = 未知 */
+    u8   playerN;       /* 玩家名有效条数(0 = 服务器未提供名单) */
+    char player[MONITOR_MAX_PLAYERS][MONITOR_PLAYER_LEN]; /* 玩家名,房主在 [0] */
+    char sessionId[33]; /* 房间标识(sessionId hex;扫描房=标题ID),缓存和去重用 */
+};
+
+struct MonitorSnapshot {
+    u32 version;        /* 每次查询完成 +1,UI 据此决定是否重建列表 */
+    bool busy;          /* 后台正在查询 */
+    s32 online;         /* 在线人数,-1 = 未知 */
+    s32 roomCount;      /* 房间数量,-1 = 未知 */
+    char server[48];    /* 当前选择的服务器名(host:port 兜底) */
+    char status[96];    /* 状态文本(错误/提示) */
+    u32  roomN;         /* rooms[] 有效条数 */
+    MonitorRoom rooms[MONITOR_MAX_ROOMS];
+};
+
+void MonitorInit();
+void MonitorInitSockets();
+void MonitorExit();
+
+/* 简繁文案切换(与 UI 的 T() 同步)。 */
+void MonitorSetTraditional(bool traditional);
+
+/* 服务器列表:直接读 relay.cfg(第 i 条与 sysmodule 的 g_servers[i] 对应)。
+ * addr 形如 "host:port"。 */
+struct MonitorServer {
+    char name[32];
+    char addr[64];
+};
+u32 MonitorListRelayServers(MonitorServer *out, u32 max);
+
+/* 请求一次后台刷新(每次打开 overlay / 切换服务器时调用)。
+ * serverName:选中的服务器名(可空,空则读 relay.cfg 的 selected=)。
+ * 非阻塞;完成后 MonitorCopySnapshot 里的 version 会 +1。
+ * Refresh = 开盖:改目标 + 重新拉订阅缓存;
+ * Switch  = 切换服务器:改目标,不拉订阅;
+ * Poll    = 周期刷新(与延迟 ping 同节奏):不动目标、不拉订阅。 */
+void MonitorRequestRefresh(const char *serverName);
+void MonitorRequestSwitch(const char *serverName);
+void MonitorRequestPoll();
+
+/* 取当前快照的副本。 */
+void MonitorCopySnapshot(MonitorSnapshot *out);
+
+/* 诊断日志:写 sdmc:/config/ldn_mitm/monitor.log(UI 侧打点用)。 */
+void MonitorLog(const char *msg);
diff --git a/overlay/source/monitor_graphql_compat.hpp b/overlay/source/monitor_graphql_compat.hpp
new file mode 100644
index 0000000..b356521
--- /dev/null
+++ b/overlay/source/monitor_graphql_compat.hpp
@@ -0,0 +1,203 @@
+#pragma once
+
+#include <string>
+#include <string.h>
+
+/* Pure GraphQL schema negotiation helpers. Kept independent of Switch APIs so
+ * host tests can exercise query construction and field-error fallbacks. */
+namespace MonitorGraphqlCompat {
+
+enum GraphqlTitleField : unsigned char {
+    kGraphqlTitleNone = 0,
+    kGraphqlTitleContentId,
+    kGraphqlTitleContentIdSnake,
+    kGraphqlTitleId,
+    kGraphqlTitleIdSnake,
+    kGraphqlTitleProgramId,
+    kGraphqlTitleProgramIdSnake,
+    kGraphqlTitleApplicationId,
+    kGraphqlTitleApplicationIdSnake,
+    kGraphqlTitleGameId,
+    kGraphqlTitleGameIdSnake,
+    kGraphqlTitleLocalCommunicationId,
+    kGraphqlTitleLocalCommunicationIdSnake,
+    kGraphqlTitleCommunicationId,
+    kGraphqlTitleCommunicationIdSnake,
+};
+enum GraphqlAdvertiseField : unsigned char {
+    kGraphqlAdvertiseNone = 0,
+    kGraphqlAdvertiseData,
+    kGraphqlAdvertiseDataSnake,
+};
+enum GraphqlConnectionField : unsigned char {
+    kGraphqlConnectionNone = 0,
+    kGraphqlConnectionIsConnected,
+    kGraphqlConnectionIsConnectedSnake,
+};
+enum GraphqlGameField : unsigned char {
+    kGraphqlGameNone = 0,
+    kGraphqlGameScalar,
+    kGraphqlGameObjectName,
+    kGraphqlGameObjectContentId,
+    kGraphqlGameObjectTitleId,
+    kGraphqlGameObjectId,
+    kGraphqlGameUnsupported,
+};
+enum GraphqlFieldFailure : unsigned char {
+    kGraphqlFailureNone = 0,
+    kGraphqlFailureTitle,
+    kGraphqlFailureAdvertise,
+    kGraphqlFailureConnection,
+    kGraphqlFailureGameNeedsObject,
+    kGraphqlFailureGame,
+    kGraphqlFailureGameSubfield,
+    kGraphqlFailureOther,
+};
+struct GraphqlQueryFields {
+    unsigned char title = kGraphqlTitleContentId;
+    unsigned char advertise = kGraphqlAdvertiseData;
+    unsigned char connection = kGraphqlConnectionIsConnected;
+    unsigned char game = kGraphqlGameNone;
+    bool gameSubfieldsDone = false;
+};
+
+inline const char *GraphqlTitleFieldName(unsigned char field) {
+    switch (field) {
+        case kGraphqlTitleContentId: return "contentId";
+        case kGraphqlTitleContentIdSnake: return "content_id";
+        case kGraphqlTitleId: return "titleId";
+        case kGraphqlTitleIdSnake: return "title_id";
+        case kGraphqlTitleProgramId: return "programId";
+        case kGraphqlTitleProgramIdSnake: return "program_id";
+        case kGraphqlTitleApplicationId: return "applicationId";
+        case kGraphqlTitleApplicationIdSnake: return "application_id";
+        case kGraphqlTitleGameId: return "gameId";
+        case kGraphqlTitleGameIdSnake: return "game_id";
+        case kGraphqlTitleLocalCommunicationId: return "localCommunicationId";
+        case kGraphqlTitleLocalCommunicationIdSnake: return "local_communication_id";
+        case kGraphqlTitleCommunicationId: return "communicationId";
+        case kGraphqlTitleCommunicationIdSnake: return "communication_id";
+        default: return nullptr;
+    }
+}
+
+inline const char *GraphqlAdvertiseFieldName(unsigned char field) {
+    switch (field) {
+        case kGraphqlAdvertiseData: return "advertiseData";
+        case kGraphqlAdvertiseDataSnake: return "advertise_data";
+        default: return nullptr;
+    }
+}
+
+inline const char *GraphqlConnectionFieldName(unsigned char field) {
+    switch (field) {
+        case kGraphqlConnectionIsConnected: return "isConnected";
+        case kGraphqlConnectionIsConnectedSnake: return "is_connected";
+        default: return nullptr;
+    }
+}
+
+inline const char *GraphqlGameSubfieldName(unsigned char gameField) {
+    switch (gameField) {
+        case kGraphqlGameObjectName: return "name";
+        case kGraphqlGameObjectContentId: return "contentId";
+        case kGraphqlGameObjectTitleId: return "titleId";
+        case kGraphqlGameObjectId: return "id";
+        default: return nullptr;
+    }
+}
+
+inline std::string BuildGraphqlQuery(const GraphqlQueryFields &fields) {
+    std::string query = "query PublicRoomSnapshot { serverInfo { online idle } room { sessionId";
+    if (const char *field = GraphqlTitleFieldName(fields.title)) {
+        query += ' ';
+        query += field;
+    }
+    if (const char *field = GraphqlAdvertiseFieldName(fields.advertise)) {
+        query += ' ';
+        query += field;
+    }
+    query += " hostPlayerName nodeCount nodeCountMax";
+    if (fields.game == kGraphqlGameScalar)
+        query += " game";
+    else if (const char *subfield = GraphqlGameSubfieldName(fields.game)) {
+        query += " game { ";
+        query += subfield;
+        query += " }";
+    }
+    query += " nodes { playerName";
+    if (const char *field = GraphqlConnectionFieldName(fields.connection)) {
+        query += ' ';
+        query += field;
+    }
+    query += " } } }";
+    return query;
+}
+
+inline bool GraphqlUnknownFieldMessage(const char *message, const char *field) {
+    if (!message || !field)
+        return false;
+    const char *p = strstr(message, "Cannot query field");
+    if (!p)
+        p = strstr(message, "cannot query field");
+    if (!p)
+        return false;
+    p += strlen("Cannot query field");
+    while (*p == ' ')
+        ++p;
+    const char quote = *p;
+    if (quote != '"' && quote != '\'' && quote != '`')
+        return false;
+    ++p;
+    const size_t fieldLen = strlen(field);
+    return strncmp(p, field, fieldLen) == 0 && p[fieldLen] == quote;
+}
+
+inline GraphqlFieldFailure GraphqlFailureForMessage(
+        const char *message, const GraphqlQueryFields &fields) {
+    if (!message)
+        return kGraphqlFailureOther;
+    if (fields.game == kGraphqlGameScalar &&
+        strstr(message, "must have a selection of subfields") &&
+        strstr(message, "game"))
+        return kGraphqlFailureGameNeedsObject;
+    const char *gameSubfield = GraphqlGameSubfieldName(fields.game);
+    if (gameSubfield && GraphqlUnknownFieldMessage(message, gameSubfield))
+        return kGraphqlFailureGameSubfield;
+    if (fields.game != kGraphqlGameNone && fields.game != kGraphqlGameUnsupported &&
+        GraphqlUnknownFieldMessage(message, "game"))
+        return kGraphqlFailureGame;
+    const char *titleField = GraphqlTitleFieldName(fields.title);
+    if (titleField && GraphqlUnknownFieldMessage(message, titleField))
+        return kGraphqlFailureTitle;
+    const char *advertiseField = GraphqlAdvertiseFieldName(fields.advertise);
+    if (advertiseField && GraphqlUnknownFieldMessage(message, advertiseField))
+        return kGraphqlFailureAdvertise;
+    const char *connectionField = GraphqlConnectionFieldName(fields.connection);
+    if (connectionField && GraphqlUnknownFieldMessage(message, connectionField))
+        return kGraphqlFailureConnection;
+    return kGraphqlFailureOther;
+}
+
+inline unsigned char NextGraphqlTitleField(unsigned char field) {
+    return field < kGraphqlTitleCommunicationIdSnake
+        ? static_cast<unsigned char>(field + 1)
+        : static_cast<unsigned char>(kGraphqlTitleNone);
+}
+inline unsigned char NextGraphqlAdvertiseField(unsigned char field) {
+    return field < kGraphqlAdvertiseDataSnake
+        ? static_cast<unsigned char>(field + 1)
+        : static_cast<unsigned char>(kGraphqlAdvertiseNone);
+}
+inline unsigned char NextGraphqlConnectionField(unsigned char field) {
+    return field < kGraphqlConnectionIsConnectedSnake
+        ? static_cast<unsigned char>(field + 1)
+        : static_cast<unsigned char>(kGraphqlConnectionNone);
+}
+inline unsigned char NextGraphqlGameObjectField(unsigned char field) {
+    return field < kGraphqlGameObjectId
+        ? static_cast<unsigned char>(field + 1)
+        : static_cast<unsigned char>(kGraphqlGameUnsupported);
+}
+
+} // namespace MonitorGraphqlCompat
diff --git a/overlay/source/monitor_player_filter.hpp b/overlay/source/monitor_player_filter.hpp
new file mode 100644
index 0000000..a96f729
--- /dev/null
+++ b/overlay/source/monitor_player_filter.hpp
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+
+namespace MonitorPlayerFilter {
+
+/* Missing connection flags mean an older schema/REST shape: preserve its
+ * previous behavior. If the field is present, only an explicit JSON true is
+ * considered an occupied node; false/null/invalid values are stale slots. */
+inline bool IncludeNode(bool hasConnectionFlag, const char *value) {
+    if (!hasConnectionFlag)
+        return true;
+    if (!value)
+        return false;
+    while (*value == ' ' || *value == '\t' || *value == '\r' || *value == '\n')
+        ++value;
+    if (std::strncmp(value, "true", 4) != 0)
+        return false;
+    const char next = value[4];
+    return next == '\0' || next == ',' || next == '}' || next == ']' ||
+           next == ' ' || next == '\t' || next == '\r' || next == '\n';
+}
+
+/* NetworkInfo has a fixed eight-slot array, but only indices below nodeCount
+ * belong to the current room. Later slots can retain names/flags from old peers. */
+inline bool IncludeConnectedSlot(std::size_t index, std::size_t nodeCount,
+                                 bool isConnected) {
+    return index < nodeCount && isConnected;
+}
+
+} // namespace MonitorPlayerFilter
diff --git a/overlay/source/monitor_target_generation.hpp b/overlay/source/monitor_target_generation.hpp
new file mode 100644
index 0000000..a0a3d78
--- /dev/null
+++ b/overlay/source/monitor_target_generation.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+/* A refresh request owns a generation token. Once a newer request is queued,
+ * older blocking network responses must not publish into the shared snapshot. */
+namespace MonitorTargetGeneration {
+
+using Value = std::uint32_t;
+
+class Gate {
+public:
+    Value Advance() { return generation_.fetch_add(1) + 1; }
+    Value Capture() const { return generation_.load(); }
+    bool IsCurrent(Value captured) const { return Capture() == captured; }
+
+private:
+    std::atomic<Value> generation_{0};
+};
+
+} // namespace MonitorTargetGeneration
diff --git a/overlay/source/monitor_title_resolver.hpp b/overlay/source/monitor_title_resolver.hpp
new file mode 100644
index 0000000..93dae19
--- /dev/null
+++ b/overlay/source/monitor_title_resolver.hpp
@@ -0,0 +1,461 @@
+#pragma once
+
+#include <stddef.h>
+#include <string.h>
+
+/* Resolve title IDs for games whose LDN contentId is the all-F sentinel.
+ * advertiseData is the room's own hexadecimal LDN payload; no local process
+ * state is used, so rooms from different games cannot inherit the foreground
+ * application's title by accident. */
+namespace MonitorTitleResolver {
+
+static constexpr size_t kAdvertiseDataMaxBytes = 384;
+static constexpr size_t kAdvertiseDataMaxHex = kAdvertiseDataMaxBytes * 2;
+
+inline int HexDigit(char c) {
+    if (c >= '0' && c <= '9')
+        return c - '0';
+    if (c >= 'a' && c <= 'f')
+        return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F')
+        return c - 'A' + 10;
+    return -1;
+}
+
+inline bool NormalizeAdvertiseHex(const char *src, char *out, size_t outN,
+                                  size_t *outLen) {
+    if (outLen)
+        *outLen = 0;
+    if (!src || !out || outN == 0)
+        return false;
+
+    size_t len = 0;
+    for (const char *p = src; *p; ++p) {
+        const int digit = HexDigit(*p);
+        if (digit >= 0) {
+            if (len + 1 >= outN) {
+                out[0] = 0;
+                return false;
+            }
+            out[len++] = "0123456789abcdef"[digit];
+        } else if (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n' ||
+                   *p == ':' || *p == '-') {
+            continue;
+        } else {
+            out[0] = 0;
+            return false;
+        }
+    }
+    out[len] = 0;
+    if (outLen)
+        *outLen = len;
+    return len != 0 && (len & 1) == 0;
+}
+
+inline bool HexSpanContains(const char *begin, const char *end,
+                            const char *needle) {
+    if (!begin || !end || !needle || end < begin)
+        return false;
+    const size_t needleLen = strlen(needle);
+    const size_t spanLen = (size_t)(end - begin);
+    if (needleLen == 0)
+        return true;
+    if (needleLen > spanLen)
+        return false;
+    for (size_t i = 0; i + needleLen <= spanLen; ++i) {
+        if (memcmp(begin + i, needle, needleLen) == 0)
+            return true;
+    }
+    return false;
+}
+
+inline bool CopyTitleId(const char *titleId, char *out, size_t outN) {
+    if (!titleId || !out || outN < 17)
+        return false;
+    memcpy(out, titleId, 17);
+    return true;
+}
+
+/* Accept common API spellings and harmless separators, but never infer a title
+ * from local process state. A valid ID is exactly sixteen hexadecimal digits. */
+inline bool NormalizeTitleId(const char *src, char *out, size_t outN) {
+    if (out && outN > 0)
+        out[0] = 0;
+    if (!src || !out || outN < 17)
+        return false;
+
+    const char *p = src;
+    while (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n')
+        ++p;
+    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X'))
+        p += 2;
+
+    size_t len = 0;
+    for (; *p; ++p) {
+        const int digit = HexDigit(*p);
+        if (digit >= 0) {
+            if (len >= 16) {
+                out[0] = 0;
+                return false;
+            }
+            out[len++] = "0123456789ABCDEF"[digit];
+        } else if (*p == ' ' || *p == '\t' || *p == '\r' || *p == '\n' ||
+                   *p == ':' || *p == '-' || *p == '_') {
+            continue;
+        } else {
+            out[0] = 0;
+            return false;
+        }
+    }
+    if (len != 16) {
+        out[0] = 0;
+        return false;
+    }
+    out[16] = 0;
+    return true;
+}
+
+inline bool IsUnknownTitleId(const char *titleId) {
+    if (!titleId || strlen(titleId) != 16)
+        return false;
+    for (size_t i = 0; i < 16; ++i) {
+        if (titleId[i] != 'F' && titleId[i] != 'f')
+            return false;
+    }
+    return true;
+}
+
+inline bool AsciiCaseEqual(const char *left, const char *right) {
+    if (!left || !right)
+        return false;
+    while (*left && *right) {
+        char a = *left++;
+        char b = *right++;
+        if (a >= 'A' && a <= 'Z') a = (char)(a - 'A' + 'a');
+        if (b >= 'A' && b <= 'Z') b = (char)(b - 'A' + 'a');
+        if (a != b)
+            return false;
+    }
+    return *left == 0 && *right == 0;
+}
+
+inline bool AsciiCaseStartsWith(const char *value, const char *prefix) {
+    if (!value || !prefix)
+        return false;
+    while (*prefix) {
+        char a = *value++;
+        char b = *prefix++;
+        if (a >= 'A' && a <= 'Z') a = (char)(a - 'A' + 'a');
+        if (b >= 'A' && b <= 'Z') b = (char)(b - 'A' + 'a');
+        if (a != b)
+            return false;
+    }
+    return true;
+}
+
+inline bool AsciiCaseContains(const char *value, const char *needle) {
+    if (!value || !needle || !needle[0])
+        return false;
+    const size_t needleLen = strlen(needle);
+    for (const char *p = value; *p; ++p) {
+        size_t i = 0;
+        while (i < needleLen && p[i]) {
+            char a = p[i];
+            char b = needle[i];
+            if (a >= 'A' && a <= 'Z') a = (char)(a - 'A' + 'a');
+            if (b >= 'A' && b <= 'Z') b = (char)(b - 'A' + 'a');
+            if (a != b)
+                break;
+            ++i;
+        }
+        if (i == needleLen)
+            return true;
+    }
+    return false;
+}
+
+enum class PokemonScarletVioletVersion : unsigned char {
+    Unspecified = 0,
+    Scarlet,
+    Violet,
+};
+
+inline bool IsPokemonScarletVioletFamilyName(const char *name) {
+    if (!name)
+        return false;
+    const bool hasScarlet = strstr(name, "朱") != nullptr ||
+                            AsciiCaseContains(name, "scarlet");
+    const bool hasViolet = strstr(name, "紫") != nullptr ||
+                           AsciiCaseContains(name, "violet");
+    return hasScarlet && hasViolet;
+}
+
+inline PokemonScarletVioletVersion PokemonVersionFromRoomName(const char *name) {
+    if (!name || IsPokemonScarletVioletFamilyName(name))
+        return PokemonScarletVioletVersion::Unspecified;
+    if (strstr(name, "紫") || AsciiCaseContains(name, "violet"))
+        return PokemonScarletVioletVersion::Violet;
+    if (strstr(name, "朱") || AsciiCaseContains(name, "scarlet"))
+        return PokemonScarletVioletVersion::Scarlet;
+    return PokemonScarletVioletVersion::Unspecified;
+}
+
+inline bool NormalizeRoomGameName(const char *src, char *out, size_t outN) {
+    if (out && outN > 0)
+        out[0] = 0;
+    if (!src || !out || outN < 2)
+        return false;
+
+    const char *begin = src;
+    while (*begin == ' ' || *begin == '\t' || *begin == '\r' || *begin == '\n')
+        ++begin;
+    size_t inputLen = strlen(begin);
+    while (inputLen > 0 && (begin[inputLen - 1] == ' ' || begin[inputLen - 1] == '\t' ||
+                            begin[inputLen - 1] == '\r' || begin[inputLen - 1] == '\n'))
+        --inputLen;
+    if (inputLen == 0)
+        return false;
+
+    size_t copyLen = inputLen < outN - 1 ? inputLen : outN - 1;
+    /* Do not cut a UTF-8 code point when a long remote label fills the UI field. */
+    if (copyLen < inputLen) {
+        while (copyLen > 0 && ((unsigned char)begin[copyLen] & 0xc0) == 0x80)
+            --copyLen;
+        if (copyLen > 0) {
+            const unsigned char last = (unsigned char)begin[copyLen - 1];
+            const size_t need = (last & 0x80) == 0 ? 1 :
+                ((last & 0xe0) == 0xc0 ? 2 : ((last & 0xf0) == 0xe0 ? 3 :
+                 ((last & 0xf8) == 0xf0 ? 4 : 1)));
+            size_t have = 1;
+            for (size_t i = copyLen; i > 0 &&
+                 ((unsigned char)begin[i - 1] & 0xc0) == 0x80; --i)
+                ++have;
+            if (have < need)
+                copyLen -= have;
+        }
+    }
+
+    size_t outLen = 0;
+    bool pendingSpace = false;
+    for (size_t i = 0; i < copyLen; ++i) {
+        unsigned char c = (unsigned char)begin[i];
+        if (c < 0x20 || c == 0x7f || c == ' ' || c == '\t') {
+            pendingSpace = outLen > 0;
+            continue;
+        }
+        if (pendingSpace && outLen + 1 < outN)
+            out[outLen++] = ' ';
+        pendingSpace = false;
+        if (outLen + 1 >= outN)
+            break;
+        out[outLen++] = (char)c;
+    }
+    while (outLen > 0 && out[outLen - 1] == ' ')
+        --outLen;
+    out[outLen] = 0;
+    char maybeTitleId[17] = {};
+    if (outLen == 0 || NormalizeTitleId(out, maybeTitleId, sizeof(maybeTitleId)))
+        return false;
+    if (strncmp(out, "未知", 6) == 0)
+        return false;
+    if (AsciiCaseStartsWith(out, "unknown") || AsciiCaseEqual(out, "n/a") ||
+        AsciiCaseEqual(out, "null") || AsciiCaseEqual(out, "none"))
+        return false;
+    return true;
+}
+
+inline unsigned char AdvertiseByte(const char *hex, size_t byteOffset) {
+    const size_t i = byteOffset * 2;
+    return (unsigned char)((HexDigit(hex[i]) << 4) | HexDigit(hex[i + 1]));
+}
+
+inline bool AdvertiseBytesAreZero(const char *hex, size_t startByte,
+                                  size_t byteCount) {
+    for (size_t i = 0; i < byteCount; ++i) {
+        if (AdvertiseByte(hex, startByte + i) != 0)
+            return false;
+    }
+    return true;
+}
+
+/* S/V carries 40 game bytes after its 0x5c-byte Pia property header.
+ * Retail Link Trade search beacons have all-zero game bytes or a changing
+ * four-byte field at +0x21. Link-Code sessions store a printable code at
+ * +0x00 and its little-endian length at +0x24. Live rooms showed markers
+ * aa 88 f4, aa e8 8c and aa 88 72: the final byte varies across sessions,
+ * while the first byte and marker family remain stable. */
+inline bool IsPokemonScarletVioletGameData(const char *hex) {
+    static constexpr size_t kGameStart = 0x5c;
+    static constexpr size_t kGameSize = 40;
+
+    if (AdvertiseBytesAreZero(hex, kGameStart, kGameSize))
+        return true;
+
+    /* Searching Link Trade beacon: changing bytes at game-data +0x21..+0x24. */
+    if (AdvertiseBytesAreZero(hex, kGameStart, 0x21) &&
+        !AdvertiseBytesAreZero(hex, kGameStart + 0x21, 4) &&
+        AdvertiseBytesAreZero(hex, kGameStart + 0x25, 3))
+        return true;
+
+    /* Link Code sessions use a printable code and a little-endian u32 length. */
+    const unsigned int codeLen =
+        (unsigned int)AdvertiseByte(hex, kGameStart + 0x24) |
+        ((unsigned int)AdvertiseByte(hex, kGameStart + 0x25) << 8) |
+        ((unsigned int)AdvertiseByte(hex, kGameStart + 0x26) << 16) |
+        ((unsigned int)AdvertiseByte(hex, kGameStart + 0x27) << 24);
+    if (codeLen == 0) {
+        /* Also allow an open Union Circle with its observed marker. */
+        return AdvertiseBytesAreZero(hex, kGameStart, 0x21) &&
+               AdvertiseByte(hex, kGameStart + 0x21) == 0xaa &&
+               AdvertiseByte(hex, kGameStart + 0x22) == 0x08 &&
+               AdvertiseByte(hex, kGameStart + 0x23) == 0x3e &&
+               AdvertiseBytesAreZero(hex, kGameStart + 0x24, 4);
+    }
+    if (codeLen > 16)
+        return false;
+
+    for (size_t i = 0; i < codeLen; ++i) {
+        const unsigned char c = AdvertiseByte(hex, kGameStart + i);
+        if (c < 0x21 || c > 0x7e)
+            return false;
+    }
+    if (!AdvertiseBytesAreZero(hex, kGameStart + codeLen, 0x21 - codeLen))
+        return false;
+
+    const bool noModeMarker =
+        AdvertiseBytesAreZero(hex, kGameStart + 0x21, 3);
+    const bool unionCircleMarker =
+        AdvertiseByte(hex, kGameStart + 0x21) == 0xaa &&
+        AdvertiseByte(hex, kGameStart + 0x22) == 0x08 &&
+        AdvertiseByte(hex, kGameStart + 0x23) == 0x3e;
+    const unsigned char observedMarkerPrefix =
+        AdvertiseByte(hex, kGameStart + 0x21);
+    const unsigned char observedMarkerMode =
+        AdvertiseByte(hex, kGameStart + 0x22);
+    const bool observedScarletVioletMarker =
+        observedMarkerPrefix == 0xaa &&
+        (observedMarkerMode == 0x08 || observedMarkerMode == 0x88 ||
+         observedMarkerMode == 0xe8);
+    return (noModeMarker || unionCircleMarker || observedScarletVioletMarker) &&
+           AdvertiseByte(hex, kGameStart + 0x24) == codeLen &&
+           AdvertiseBytesAreZero(hex, kGameStart + 0x25, 3);
+}
+
+/* Scarlet and Violet share Scarlet's local-communication ID on the air.
+ * Their 132-byte app data is a 0x5c Pia block plus 40 game-specific bytes. */
+inline bool IsPokemonScarletVioletAdvertiseHex(const char *hex, size_t hexLen) {
+    static constexpr size_t kAdvertiseBytes = 132;
+    if (!hex || hexLen != kAdvertiseBytes * 2 ||
+        memcmp(hex, "005c150015", 10) != 0)
+        return false;
+
+    /* Pia header: player limit enabled, 1-4 players, UTF-8 single-space name. */
+    if (AdvertiseByte(hex, 0x15) != 1 ||
+        AdvertiseByte(hex, 0x16) < 1 || AdvertiseByte(hex, 0x16) > 4 ||
+        AdvertiseByte(hex, 0x17) != 0 || AdvertiseByte(hex, 0x18) != 0 ||
+        AdvertiseByte(hex, 0x19) != 0 || AdvertiseByte(hex, 0x1a) != 1 ||
+        AdvertiseByte(hex, 0x1b) != 1 || AdvertiseByte(hex, 0x1c) != 0x20 ||
+        !AdvertiseBytesAreZero(hex, 0x1d, 0x5c - 0x1d))
+        return false;
+
+    return IsPokemonScarletVioletGameData(hex);
+}
+
+/* Returns false when the advertisement is absent or does not match a known
+ * signature. The caller must then show the safe unknown-game fallback. */
+inline bool ResolveAdvertisedTitleId(const char *advertiseData,
+                                     const char *hostPlayerName,
+                                     char *outTitleId, size_t outN) {
+    if (outTitleId && outN > 0)
+        outTitleId[0] = 0;
+    if (!outTitleId || outN < 17)
+        return false;
+
+    char hex[kAdvertiseDataMaxHex + 1] = {};
+    size_t hexLen = 0;
+    if (!NormalizeAdvertiseHex(advertiseData, hex, sizeof(hex), &hexLen))
+        return false;
+
+    /* DRAGON BALL FighterZ: advertiseData == ffff0000. */
+    if (hexLen == 8 && strcmp(hex, "ffff0000") == 0)
+        return CopyTitleId("0100A250097F0000", outTitleId, outN);
+
+    /* Rocket League advertises a JSON object (7b = '{', 7d = '}'). */
+    if (hexLen >= 4 && hex[0] == '7' && hex[1] == 'b' &&
+        hex[hexLen - 2] == '7' && hex[hexLen - 1] == 'd')
+        return CopyTitleId("01005EE0036EC000", outTitleId, outN);
+
+    if (IsPokemonScarletVioletAdvertiseHex(hex, hexLen))
+        return CopyTitleId("0100A3D008C5C000", outTitleId, outN);
+
+    static const char kDelimiter[] = "00000004";
+    const size_t delimiterLen = sizeof(kDelimiter) - 1;
+    size_t delimiterCount = 0;
+    for (const char *p = hex; (p = strstr(p, kDelimiter)) != nullptr;
+         p += delimiterLen)
+        ++delimiterCount;
+    const char *firstDelimiter = strstr(hex, kDelimiter);
+    const char *firstPartEnd = firstDelimiter ? firstDelimiter : hex + hexLen;
+
+    /* MONSTER HUNTER RISE has player/rank sections after two delimiters. */
+    if (delimiterCount >= 2 &&
+        HexSpanContains(hex, firstPartEnd, "0000000008100000") &&
+        HexSpanContains(hex, firstPartEnd, "8b9000"))
+        return CopyTitleId("0100B04011742000", outTitleId, outN);
+
+    /* Monster Hunter Stories 2 shares the common prefix, but has 0a0000. */
+    if (HexSpanContains(hex, firstPartEnd, "0000000008100000") &&
+        HexSpanContains(hex, firstPartEnd, "0a0000"))
+        return CopyTitleId("0100E21011446000", outTitleId, outN);
+
+    /* Minecraft stores the host name as UTF-8 starting at hex offset 32. */
+    if (hostPlayerName && hostPlayerName[0] && hexLen > 32 &&
+        ((hexLen - 32) & 1) == 0) {
+        char decoded[96] = {};
+        size_t decodedLen = 0;
+        for (size_t i = 32; i + 1 < hexLen; i += 2) {
+            const int hi = HexDigit(hex[i]);
+            const int lo = HexDigit(hex[i + 1]);
+            if (hi < 0 || lo < 0)
+                return false;
+            const unsigned char byte = (unsigned char)((hi << 4) | lo);
+            if (byte == 0)
+                break;
+            if (decodedLen + 1 >= sizeof(decoded))
+                return false;
+            decoded[decodedLen++] = (char)byte;
+        }
+        decoded[decodedLen] = 0;
+        if (decodedLen != 0 && strcmp(decoded, hostPlayerName) == 0)
+            return CopyTitleId("0100D71004694000", outTitleId, outN);
+    }
+
+    return false;
+}
+
+/* Resolve IDs from the room's explicit title field or game value, then use only
+ * that room's own advertisement when the ID is absent/all-F. */
+inline bool ResolveRoomTitleId(const char *contentId, const char *gameValue,
+                               const char *advertiseData,
+                               const char *hostPlayerName,
+                               char *outTitleId, size_t outN) {
+    if (outTitleId && outN > 0)
+        outTitleId[0] = 0;
+    if (!outTitleId || outN < 17)
+        return false;
+
+    char candidate[17] = {};
+    if (NormalizeTitleId(contentId, candidate, sizeof(candidate)) &&
+        !IsUnknownTitleId(candidate))
+        return CopyTitleId(candidate, outTitleId, outN);
+    if (NormalizeTitleId(gameValue, candidate, sizeof(candidate)) &&
+        !IsUnknownTitleId(candidate))
+        return CopyTitleId(candidate, outTitleId, outN);
+
+    if (ResolveAdvertisedTitleId(advertiseData, hostPlayerName,
+                                 candidate, sizeof(candidate)))
+        return CopyTitleId(candidate, outTitleId, outN);
+    return false;
+}
+
+} // namespace MonitorTitleResolver
diff --git a/overlay/tests/monitor_graphql_compat_test.cpp b/overlay/tests/monitor_graphql_compat_test.cpp
new file mode 100644
index 0000000..ee02595
