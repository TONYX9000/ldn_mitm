+static bool LoadFile(const char *path, std::string *out) {
+    EnsureSd();
+    FILE *f = fopen(path, "rb");
+    if (!f)
+        return false;
+    char buf[4096];
+    out->clear();
+    for (;;) {
+        size_t n = fread(buf, 1, sizeof(buf), f);
+        if (n == 0)
+            break;
+        if (out->size() + n > kMaxDownload) {
+            fclose(f);
+            return false;
+        }
+        out->append(buf, n);
+    }
+    fclose(f);
+    return !out->empty();
+}
