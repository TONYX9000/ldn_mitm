+/* 跳过 UTF-8 BOM */
+static const char *SkipBom(const char *p) {
+    if ((unsigned char)p[0] == 0xEF && (unsigned char)p[1] == 0xBB &&
+        (unsigned char)p[2] == 0xBF)
+        return p + 3;
+    return p;
