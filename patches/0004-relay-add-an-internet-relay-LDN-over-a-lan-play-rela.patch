+        u16 IpChecksum(const u8 *d, size_t n) {
+            u32 s = 0;
+            for (size_t i = 0; i + 1 < n; i += 2) {
+                s += (static_cast<u32>(d[i]) << 8) | d[i + 1];
+            }
+            if (n & 1) {
+                s += static_cast<u32>(d[n - 1]) << 8;
+            }
+            while (s >> 16) {
+                s = (s & 0xffff) + (s >> 16);
+            }
+            return static_cast<u16>(~s & 0xffff);
+        }
