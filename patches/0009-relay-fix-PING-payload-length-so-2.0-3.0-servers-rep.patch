+            q[p++] = 0x01; q[p++] = 0x00;
+            q[p++] = 0x00; q[p++] = 0x01;
+            q[p++] = 0; q[p++] = 0; q[p++] = 0; q[p++] = 0; q[p++] = 0; q[p++] = 0;
+            const char *s = host;
