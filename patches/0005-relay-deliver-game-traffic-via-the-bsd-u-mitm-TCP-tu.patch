+        bool GetForwardSockType(::Service *fwd, s32 sockfd, s32 *out_type) {
+            s32 so_type = 0;
+            const struct { s32 sockfd; u32 level; u32 optname; } in = { sockfd, SOL_SOCKET, SO_TYPE };
+            struct { s32 ret; s32 bsd_errno; u32 optlen; } out = {};
