+                if (s.used && s.originator && s.game_fd == fd) {
+                    return std::addressof(s);
+                }
+            }
+            return nullptr;
+        }
+
+        u8 OwnerOf(const Stream *s) {
+            return s->originator ? OwnerSender : OwnerReceiver;
+        }
+
+        /* Requires g_mutex. */
